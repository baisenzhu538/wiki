sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding=\"utf-8\", errors=\"replace\")
def grepctx(term, limit=6, width=60):
    print(\"=\"*70)
    print(\"TERM:\", term)
    n=0
    for root, dirs, files in os.walk(\"30_wiki\"):
        for f in files:
            if not f.endswith(\".md\"): continue
            p = os.path.join(root,f)
            try: s = open(p, encoding=\"utf-8\", errors=\"replace\").read()
            except: continue
            if term in s:
                n+=1
                if n<=limit:
                    idx = s.find(term)
                    print(f\"[{os.path.basename(p)}] ...{s[max(0,idx-width):idx+width]}...\")
    print(f\"(total files with hit: {n})\")
for t in [\"火箭模型\",\"没认怂\",\"龙峰\",\"重做一遍\"]:
