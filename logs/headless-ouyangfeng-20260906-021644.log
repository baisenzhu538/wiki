    tf = _task(tmp_path, "**完成内容**：改工具\n\n**交付物**：\n- `kdo-tools/tool.py`\n\n**验证**：过\n")
    ok, msg, _warn = qt._check_deliverables_committed(tf, {}, wiki_root=repo)
    assert not ok
