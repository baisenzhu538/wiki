def action_register(instance: str) -> tuple[bool, str]:
    """#546：实例上岗手动登记（claim 之外的登记入口——欧阳锋等纯审查角色不 claim）。"""
    _register_instance("manual-register", instance)
    e = _load_registry().get("instances", {}).get(instance, {})
