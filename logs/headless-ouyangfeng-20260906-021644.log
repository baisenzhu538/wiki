"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command 'function Fix-Timestamp($rel, $old, $new) {
  $p = (Resolve-Path $rel).Path
  $full = [System.IO.File]::ReadAllText($p, [System.Text.Encoding]::UTF8)
  if ($full.Contains($old)) {
    $full = $full.Replace($old, $new)
    [System.IO.File]::WriteAllText($p, $full, (New-Object System.Text.UTF8Encoding($false)))
    Write-Output "FIXED $rel : $old -> $new"
  } else {
    Write-Output "NOTFOUND $rel : $old"
  }
}
