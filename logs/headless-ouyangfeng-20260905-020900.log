]
for c in cards:
    txt = Path(c).read_text(encoding='utf-8', errors='replace')
    end = txt.find('\\n---', 3)
    fm = yaml.safe_load(txt[3:end]) if end>0 else {}
    refs = fm.get('source_refs') or []
    print('='*90)
    print('CARD:', c.split('/')[-1])
    for ref in refs:
        # ref may be 'path' or 'path:start-end'
        m = re.match(r'"'^(.*?):('"\\d+)-(\\d+)"'$'"', ref)
        if m:
            p, a, b = m.group(1), int(m.group(2)), int(m.group(3))
        else:
            p, a, b = ref, None, None
        path = Path(p)
        ok = path.exists()
        print(f'  REF: {ref}')
        print(f'    exists={ok}')
        if ok:
            sz = path.stat().st_size
            lines = path.read_text(encoding='utf-8', errors='replace').splitlines()
            print(f'    size={sz} total_lines={len(lines)}')
            if a:
                print(f'    head L{a}:', lines[a-1][:180] if a <= len(lines) else '(past end)')
                print(f'    tail L{b}:', lines[b-1][:180] if b <= len(lines) else '(past end, max='+str(len(lines))+')')
            else:
                # print first 2 lines as fingerprint
                for i in range(min(2, len(lines))):
                    print(f'    L{i+1}:', lines[i][:160])
