import io, sys
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
import yaml, re, os
from pathlib import Path

c = '30_wiki/dark-knowledges/dk-koupen-input-method-loss.md'
txt = Path(c).read_text(encoding='utf-8', errors='replace')
end = txt.find('\\n---', 3)
fm = yaml.safe_load(txt[3:end])
refs = fm.get('source_refs') or []
print('source_context:', fm.get('source_context'))
print('source_refs raw:')
for r in refs:
    print('  ', repr(r))
    # parse path: everything before ' L' or ':'+digit
    m = re.match(r'"'^(.*?)'"\\s+L(\\d+)', r)
    if m:
        path = m.group(1)
        a = int(m.group(2))
    else:
        path = r
        a = None
    print('   -> path=', repr(path), 'exists=', Path(path).exists())

# Now walk 00_inbox and find candidates whose name contains substrings from refs
subs = set()
for r in refs:
    for tok in re.split(r'[0-9:\\-（）()\\s]+', r):
        if len(tok) >= 2:
            subs.add(tok)
print('search substrings:', [s for s in subs])
found = []
for root, dirs, files in os.walk('00_inbox'):
    for fn in files:
        full = os.path.join(root, fn)
        for s in subs:
            if s in fn:
                found.append((s, full))
                break
print('candidate matches in 00_inbox:')
for s, full in found:
    print('  ', s, '->', full)
