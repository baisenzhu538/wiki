import io, sys
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
import glob, datetime
from pathlib import Path
try:
    import yaml
    print('yaml ok', yaml.__version__)
except ImportError:
    print('no yaml')

def parse_fm(p):
    txt = Path(p).read_text(encoding='utf-8', errors='replace')
    if not txt.startswith('---'):
        return None
    end = txt.find('\\n---', 3)
    if end < 0:
        return None
    block = txt[3:end]
    try:
        return yaml.safe_load(block)
    except Exception as e:
        return {'__err__': str(e)}

win_start = datetime.datetime(2026,8,28)
win_end = datetime.datetime(2026,9,5,23,59,59)
def inwin(s):
    if not s: return False
    try:
        if isinstance(s, datetime.datetime): dt=s
        elif isinstance(s, datetime.date): dt=datetime.datetime(s.year,s.month,s.day)
        else:
            dt=datetime.datetime.strptime(str(s)[:10], '%Y-%m-%d')
        return win_start <= dt <= win_end
    except Exception:
        return False

rows=[]
for p in glob.glob('30_wiki/**/*.md', recursive=True):
    if '_archive' in p: continue
    d = parse_fm(p)
    if not d or not isinstance(d, dict): continue
    if str(d.get('status','')).lower() "'!= '"'reviewed': continue
    ca = d.get('created_at')
    rd = d.get('review_date')
    if inwin(ca) or inwin(rd):
        dom = d.get('domain') or []
        if isinstance(dom, str): dom=[dom]
        rows.append(dict(path=p, type=d.get('type'), domain=dom, ca=ca, rd=rd,
                         sp=d.get('source_person'), sc=d.get('source_context'), sr=d.get('source_refs')))
rows.sort(key=lambda r: r['path'])
print('count', len(rows))
# group by domain
from collections import defaultdict
g=defaultdict(list)
for r in rows:
    key = ','.join(r['domain']) if r['domain'] else '(none)'
    g[key].append(r)
for k,v in sorted(g.items()):
    print(f'--- domain={k} ({len(v)})')
    for r in v:
        print('   ', r['path'].split('/')[-1], '| type=', r['type'], '| ca=', r['ca'], '| rd=', r['rd'])
