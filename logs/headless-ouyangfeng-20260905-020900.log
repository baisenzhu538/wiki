 '30_wiki/cases/case-popmart-molly-transition.md',
 '30_wiki/concepts/concept-satisfaction-vs-existence.md',
 '30_wiki/frameworks/framework-arui-ai-six-fundamentals.md',
 '30_wiki/cases/case-yitang-jiangxiang-huawei-matext-launch.md',
 '30_wiki/methods/method-shizhi-jiangxiang-ten-strategies.md',
 '30_wiki/frameworks/framework-course-thought-production-line.md',
 '30_wiki/cases/case-wechat-article-workbuddy-selfmedia-pipeline.md',
