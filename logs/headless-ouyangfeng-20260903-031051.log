            # _is_rework_task 读到该标即豁免 #504 own-pending 阻塞（重提≠接新单）。
            # 走 apply_updates 写 frontmatter（幂等，多轮返工重复写 true 无副作用）。
            apply_updates(task_id, "queued", task_file, status="queued", rework=True)
