"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "cd C:\\Users\\Administrator\\Desktop\\wiki; "'$env:PYTHONIOENCODING='"'utf-8'; @'
import sqlite3, glob, os
base = r'C:\\Users\\Administrator\\AppData\\Local\\hermes\\profiles'
profiles = ['huangyaoshi','laowantong','wangyuyan','ouyangfeng','duanwangye','skills-assistant']
def ts_to_local(ts):
    if ts is None: return None
    # started_at likely unix epoch or ISO
    import datetime
    if isinstance(ts,(int,float)):
        return datetime.datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M:%S')
    return str(ts)
for prof in profiles:
    p = os.path.join(base, prof, 'state.db')
    if not os.path.exists(p): continue
    con = sqlite3.connect(p)
    cur = con.cursor()
    try:
        cur.execute(\"SELECT id, started_at, ended_at, display_name, title, source, message_count, profile_name FROM sessions ORDER BY started_at\")
        rows = cur.fetchall()
    except Exception as e:
        print(prof, 'ERR', e); con.close(); continue
    con.close()
    # filter window 09-02~09-03 (inclusive), but print all recent
    print('=== PROFILE', prof, 'total sessions', len(rows))
    for r in rows:
        sid, started, ended, dn, title, src, mc, pn = r
        st = ts_to_local(started)
        if st and ('2026-09-02' <= st[:10] <= '2026-09-03'):
            print(f'  {st} | end={ts_to_local(ended)} | dn={dn"'!r} | title={(title or "")[:60]!r} | src={src} | msgs={mc} | pn={pn}'"')
