def _extract_exec_report(body: str) -> str:
    """提取任务单「## 执行报告」节（到下一个 ## 或文件尾）。"""
    idx = body.find("## 执行报告")
    if idx == -1:
        return ""
    nxt = body.find("\n## ", idx + 1)
    return body[idx:nxt] if nxt > 0 else body[idx:]


