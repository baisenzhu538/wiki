import sqlite3, os, datetime
base = r'C:\\Users\\Administrator\\AppData\\Local\\hermes\\profiles'
def first_user_msg(prof, sid):
    p = os.path.join(base, prof, 'state.db')
    con = sqlite3.connect(p)
    cur = con.cursor()
    cur.execute(\"SELECT content FROM messages WHERE session_id=? AND role='user' ORDER BY id LIMIT 1\", (sid,))
    r = cur.fetchone()
    con.close()
    return r[0] if r else None
p = os.path.join(base, 'huangyaoshi', 'state.db')
con = sqlite3.connect(p)
cur = con.cursor()
cur.execute(\"SELECT id, started_at, message_count FROM sessions ORDER BY started_at\")
rows = cur.fetchall()
con.close()
for sid, st, mc in rows:
    if isinstance(st,(int,float)):
        dt = datetime.datetime.fromtimestamp(st)
    else:
        dt = datetime.datetime.strptime(st, '%Y-%m-%d %H:%M:%S')
    if dt.strftime('%Y-%m-%d') not in ('2026-09-02','2026-09-03'):
        continue
    c = first_user_msg('huangyaoshi', sid)
    head = (c or '')[:200].replace('\\n',' ')
    print(f'{dt.strftime(\"%Y-%m-%d %H:%M:%S\")} msgs={mc}')
    print('   ', head)
    print()
