def _log_gate_warning(task_id: str, gate: str, reason: str, instance: str = "") -> None:
    """#625 任务2：WARNING 级门禁台账（不拦截场景留痕——WARNING 说了却没痕=白说）。

    与 _log_gate_blocked 分流：拦截进 gate-blocked.log（探针第五信号扫描面，会通知
