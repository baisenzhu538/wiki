    """
    chunks, cur, cur_len, cur_src = [], [], 0, None
    cur_segs = []
    for src, ts, role, text in events:
        if cur_src is None:
            cur_src = src
        line = f"[{role}] {text.strip()}\n"
        if cur_len + len(line) > CHUNK_CHARS and cur:
            chunks.append((cur_src, "".join(cur), cur_segs))
            cur, cur_len, cur_src, cur_segs = [], 0, src, []
