# -*- coding: utf-8 -*-
"""#645 返工验证：逐卡核对候选卡 source_refs 文件内是否含锚文（空白归一化子串），
+ zhu 洞察表每条锚文 vs 来源列完整路径。目标：命中率 100%，错位 0。"""
import re
import sys
from pathlib import Path

VAULT = Path(__file__).resolve().parent.parent
PENDING = VAULT / "00_inbox" / "pending-cards"
ZHU = VAULT / "30_wiki" / "personal-os" / "zhu-conversation-insights.md"


def norm(s):
    return re.sub(r"\s+", "", s or "")


def file_text(p):
    """与管线抽取同口径读源：.jsonl 逐行 json 解析收集全部字符串值（真实换行已反转义），
    其他文件按原文。否则含换行的锚文永远 MISS（raw JSONL 里换行是 \\n 字面两字符）。"""
    path = Path(p)
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if path.suffix == ".jsonl":
        import json
        parts = []

        def walk(o):
            if isinstance(o, str):
                parts.append(o)
            elif isinstance(o, dict):
                for v in o.values():
                    walk(v)
            elif isinstance(o, list):
                for v in o:
                    walk(v)

        for line in raw.splitlines():
            try:
                walk(json.loads(line))
            except json.JSONDecodeError:
                parts.append(line)
        return norm("".join(parts))
    return norm(raw)


bad, ok, total = [], 0, 0

# 1) 候选卡
for fp in sorted(PENDING.glob("distill-*-20260905-*.md")):
    total += 1
    text = fp.read_text(encoding="utf-8")
    m = re.search(r'source_refs:\s*\n\s*-\s*"([^"]+)"', text)
    a = re.search(r"\*\*原文锚\*\*[^\n]*\n>\s*(.+)", text)
    if not (m and a):
        bad.append((fp.name, "解析失败（source_refs/原文锚缺失）"))
        continue
    src, anchor = m.group(1), a.group(1).strip()
    content = file_text(src)
    if content is None:
        bad.append((fp.name, f"源文件不可读: {src}"))
    elif norm(anchor) in content:
        ok += 1
    else:
        bad.append((fp.name, f"锚文不在声明源: {src}"))

# 2) zhu 洞察表
zhu_bad = []
if ZHU.exists():
    for line in ZHU.read_text(encoding="utf-8").splitlines():
        if not line.startswith("|") or "`C:" in line and line.count("`") < 2:
            pass
        cells = [c.strip() for c in line.split("|")]
        if len(cells) < 6 or cells[1] in ("#", ":---") or not cells[1].strip().isdigit():
            continue
        anchor, src = cells[3].replace("\\|", "|"), cells[4].strip("`")
        if not src or src == "来源":
            continue
        content = file_text(src)
        if content is None:
            zhu_bad.append((cells[1], f"源文件不可读: {src}"))
        elif norm(anchor) in content:
            ok += 1
            total += 1
        else:
            zhu_bad.append((cells[1], f"锚文不在声明源: {src}"))
            total += 1

print(f"候选卡+zhu 合计 {total} 条，命中 {ok}，错位 {len(bad) + len(zhu_bad)}")
for name, why in bad + zhu_bad:
    print(f"  MISS {name}: {why}")
sys.exit(1 if (bad or zhu_bad) else 0)


