import sys, json, re
from pathlib import Path
sys.stdout.reconfigure(encoding='utf-8')

def norm(s):
    return ''.join(s.split())

def content(p):
    p = Path(p)
    if not p.exists():
        return None
    raw = p.read_text(encoding='utf-8', errors='replace')
    if p.suffix == '.jsonl':
        parts = []
        for line in raw.splitlines():
            try:
                o = json.loads(line)
            except Exception:
                parts.append(line)
                continue
            stack = [o]
            while stack:
                x = stack.pop()
                if isinstance(x, str):
                    parts.append(x)
                elif isinstance(x, dict):
                    stack.extend(x.values())
                elif isinstance(x, list):
                    stack.extend(x)
        return norm(''.join(parts))
    return norm(raw)

def card_src_anchor(t):
    # source_refs
    k = 'source_refs:'
    i1 = t.find(k)
    j = t.find('- \"', i1)
    q1 = t.find('\"', j)
    q2 = t.find('\"', q1+1)
    src = t[q1+1:q2]
    # anchor = first blockquote line starting with \"> \"
    anchor = None
    for line in t.splitlines():
        s = line.strip()
        if s.startswith('> '):
            anchor = s[2:].strip()
            break
    return src, anchor

miss = []; n = 0; hit = 0
for fp in sorted(Path('00_inbox/pending-cards').glob('distill-*-20260905-*.md')):
