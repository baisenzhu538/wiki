import sys, json, re
from pathlib import Path
sys.stdout.reconfigure(encoding='utf-8')
def norm(s):
    return ''.join(s.split())
def content(p):
    p = Path(p)
    if not p.exists():
        return None
    raw = p.read_text(encoding='utf-8', errors='replace')
    if p.suffix == '.jsonl':
        parts = []
        for line in raw.splitlines():
            try:
                o = json.loads(line)
            except Exception:
                parts.append(line)
                continue
            stack = [o]
            while stack:
                x = stack.pop()
                if isinstance(x, str):
                    parts.append(x)
                elif isinstance(x, dict):
                    stack.extend(x.values())
                elif isinstance(x, list):
                    stack.extend(x)
        return norm(''.join(parts))
    return norm(raw)

