import io, sys, os
sys.stdout.reconfigure(encoding='utf-8')
ids = ['framework-ai-business-cognition-system','framework-timing-not-yet-resource-allocation','framework-client-acceptable-decoupled-delivery','framework-embodiment-taste-rule-three-level','framework-knowledge-base-vs-ontology','framework-zero-user-immersive-research','framework-socialization-capability-pyramid','framework-fact-judgment-separation','framework-dual-triangle-gap-diagnosis','framework-conversion-rate-is-result']
for idn in ids:
    p = f'30_wiki/frameworks/{idn}.md'
    with open(p, encoding='utf-8') as f:
        txt = f.read()
    lines = txt.splitlines()
    # extract frontmatter
    fm = {}
    in_fm = False
    for l in lines:
        if l.strip() == '---':
            if not in_fm:
                in_fm = True
                continue
            else:
                break
        if in_fm:
            if ':' in l:
                k, v = l.split(':', 1)
                fm[k.strip()] = v.strip()
    print('='*100)
    print(idn)
    print('  title:', fm.get('title','')[:80])
    print('  domain:', fm.get('domain'))
    print('  aliases_count:', len([a for a in txt.split('aliases:')[1].split('related:')[0].splitlines() if a.strip().startswith('-')]) if 'aliases:' in txt else '?')
    # check key markers
    markers = ['定位声明','知行合一判据','业界对标','WebSearch','三方法','自我攻击','自攻击','Critique','攻击','dk：','dk:','不要用的场景','失败模式','Constraints','Synthesis','Action Triggers','迭代日志','source_refs']
    found = []
    for m in markers:
        if m in txt:
            found.append(m)
    print('  markers found:', found)
    # count source_refs lines and related lines
    # extract related count
    rel = txt.split('related:')[1].split('discoverable_by:')[0] if 'related:' in txt and 'discoverable_by:' in txt else ''
    rel_cnt = len([l for l in rel.splitlines() if l.strip().startswith('-')])
    print('  related_count:', rel_cnt)
    src = txt.split('source_refs:')[1].split('related:')[0] if 'source_refs:' in txt and 'related:' in txt else ''
    src_cnt = len([l for l in src.splitlines() if l.strip().startswith('-')])
    print('  source_refs_count:', src_cnt)
    # tags
    tags = txt.split('tags:')[1].split('review_date:')[0] if 'tags:' in txt and 'review_date:' in txt else ''
    print('  tags:', ' | '.join(l.strip('- ') for l in tags.splitlines() if l.strip().startswith('-')))
