INSTANCE_ROLE_MAP = {"hermes": "laowantong"}


def _role_of(instance: str) -> str:
    return INSTANCE_ROLE_MAP.get(instance, instance)


# #620 瀹炰緥鍛藉悕閾佸緥锛堣€佹湵 09-02 鐩翠护锛夛細瀹炰緥鍚嶅彧鏈夎鑹插悕娌℃湁宸ュ叿鍚嶁€斺€斿伐鍏峰彲鎹紙kimi
# 娌￠搴︿細鎹㈠叾浠?agent锛夛紝宸ュ叿鍚嶈繘瀹炰緥鍚嶅埗閫犳贩涔便€傝繃娓℃湡鍏煎鍦ㄩ€旀棫鍚?{role}-<tool>
# 锛坈laimed-huangyaoshi-kimi 绛夊凡棰嗗湪閫斿崟浠嶉』鑳?complete/release锛夛紱鏂?claim 涓€寰嬭８瑙掕壊鍚嶃€?
def _claimed_by_role(instance: str, claimed_instance: str) -> bool:
    """瀹炰緥閿佸尮閰嶏紙#620锛夛細瑁歌鑹插悕绮剧‘鍛戒腑 claimed-<instance>锛屾垨鍛戒腑鍚岃鑹插湪閫旀棫鍚?claimed-<role>-<tool>銆?""
    return claimed_instance == instance or claimed_instance.startswith(instance + "-")


def _legacy_dash_ok(instance: str) -> bool:
    """#620 claim 瑁稿悕闂ㄧ鍒ゆ嵁锛氬甫 '-' 鐨勫疄渚嬪悕浠呴檺鍦ㄥ唽瀛橀噺韬唤锛堝湪閫旀棫鍚嶈嚜鐒舵秷浜★紝
    鍚?'-' 鐨勬寮忚鑹?skills-assistant 鍦ㄥ唽涓嶅彈褰卞搷锛? INSTANCE_ROLE_MAP 鍘嗗彶閿紙hermes锛夈€?""
    return ("-" not in instance or instance in INSTANCE_ROLE_MAP
            or instance in _load_registry().get("instances", {}))


# 鈹€鈹€ #546锛氬疄渚嬭韩浠界櫥璁?+ 缁堝鏉冩満鍣ㄦ牎楠岋紙涓€鍏蜂袱鑱屼簨浠舵牴娌伙紝#525 杞婚噺鍏堣鐗堬級鈹€鈹€
# 鐧昏琛ㄦ槸绾湰鍦?json锛?kdo/active-instances.json锛夛紝claim 鏃舵棤鎰熷啓鍏ワ紱
# review 鏍￠獙銆屽綋鍓?cwd 鏈?ouyangfeng 瑙掕壊鐧昏瀹炰緥銆嶆墠鏀捐 --reviewer 娆ч槼閿嬨€?
# 鑳藉姏杈圭晫锛堣瘹瀹炲彛寰勶級锛氬瀹炰緥鍏变韩 cwd 鏃跺彧鑳借瘉鏄庛€岃宸ヤ綔鐩綍鏈?ouyangfeng 涓婂矖鐧昏銆嶏紝
# 浼氳瘽绾ц韩浠界粦瀹氾紙鐪熉蜂竴鍏蜂袱鑱岄槻鎺э級灞?#525 姝ｅ崟锛堝績璺?浼氳瘽缁戝畾锛夛紝鏈崟涓嶅仛銆?
INSTANCE_REGISTRY = _WIKI_ROOT / ".kdo" / "active-instances.json"


def _load_registry() -> dict:
    try:
        data = json.loads(INSTANCE_REGISTRY.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {"instances": {}}
    except Exception:
        return {"instances": {}}


def _save_registry(reg: dict) -> None:
    INSTANCE_REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    tmp = INSTANCE_REGISTRY.with_suffix(".tmp")
    tmp.write_text(json.dumps(reg, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(INSTANCE_REGISTRY)  # 鍘熷瓙鏇挎崲闃插崐鍐?


def _register_instance(task_id: str, instance: str) -> None:
    """#546锛歝laim/register 鏃剁櫥璁?鏇存柊瀹炰緥韬唤锛堣鑹?cwd/宸ュ叿/浼氳瘽/鏃堕棿锛夈€?
    鐧昏澶辫触涓嶉樆鏂祦杞紱娴嬭瘯浠?task_9999_ 涓嶇櫥璁帮紙#483 鍣０鍒嗘祦绾緥锛夈€?""
    if task_id.startswith("task_9999_"):
        return
    try:
        reg = _load_registry()
        reg.setdefault("instances", {})[instance] = {
            "role": _role_of(instance),
            "cwd": os.getcwd(),
            "tool": os.environ.get("KDO_TOOL", ""),
            "session": os.environ.get("KDO_SESSION_ID", ""),
            "ts": datetime.now().isoformat(timespec="seconds"),
        }
        _save_registry(reg)
    except Exception:
        pass


def _check_review_authority(task_id: str, reviewer: str,
                            force: bool = False, reason: str | None = None) -> tuple[bool, str]:
    """#546锛氱粓瀹℃潈鏈哄櫒鏍￠獙鈥斺€斿綋鍓?cwd 椤绘湁瀵瑰簲瑙掕壊鐨勭櫥璁板疄渚嬫墠鏀捐銆?
    娆ч槼閿?review 闇€ ouyangfeng 鐧昏锛?616 浠诲姟3 缈昏浆閫氶亾锛氱帇璇 review 闇€ wangyuyan 鐧昏銆?
    鏈櫥璁?涓嶇 鈫?鎷掓 + 鎻愮ず register锛?-force --reason 閫冪敓闂ㄨ惤 #444 鍙拌处銆?""
    expected_role = "wangyuyan" if reviewer == "鐜嬭瀚? else "ouyangfeng"
    reg = _load_registry()
    cwd = os.path.normcase(os.path.normpath(os.getcwd()))
    for name, e in reg.get("instances", {}).items():
        role = e.get("role") or _role_of(name)
        entry_cwd = os.path.normcase(os.path.normpath(e.get("cwd", "") or "/"))
        # #620 瑁稿悕鍙ｅ緞锛氬湪鍐屾棫韬唤 {role}-<tool>锛堝 wangyuyan-kimi-0902锛夋寜鍚岃鑹茬櫥璁拌
        if (role == expected_role or role.startswith(expected_role + "-")) and entry_cwd == cwd:
            return True, ""
    if force:
        if not (reason and reason.strip()):
            return False, "缁堝鏉冩牎楠?force 閫冪敓蹇呴』閰?--reason '<鐞嗙敱>'锛?444锛氫緥澶栫暀鐥曗€斺€旇皝/涓轰綍/浣曟椂锛?
        ledger = _log_force_exception(task_id, reviewer,
                                      f"缁堝鏉冩牎楠岀粫杩囷細{reason.strip()}",
                                      bypass="#546 缁堝鏉冩牎楠?)
        return True, f"鈿狅笍 缁堝鏉冩牎楠?force 渚嬪宸茬暀鐥? {ledger}"
    return False, (
        f"缁堝鏉冩牎楠屾嫆姝紙#546 涓€鍏蜂袱鑱屾牴娌伙級锛氬綋鍓嶅伐浣滅洰褰曟棤 {expected_role} 瑙掕壊鐧昏瀹炰緥銆?
        f"涓婂矖鍏堢櫥璁帮細python 90_control/scripts/queue_transition.py register {expected_role}锛?
        "绱ф€ョ粫杩囷細review 鍔?--force --reason '<鐞嗙敱>'锛堣惤 force-exceptions.log 鍙拌处锛?
    )


def action_register(instance: str) -> tuple[bool, str]:
    """#546锛氬疄渚嬩笂宀楁墜鍔ㄧ櫥璁帮紙claim 涔嬪鐨勭櫥璁板叆鍙ｂ€斺€旀闃抽攱绛夌函瀹℃煡瑙掕壊涓?claim锛夈€?""
    _register_instance("manual-register", instance)
    e = _load_registry().get("instances", {}).get(instance, {})
    if not e:
        return False, f"鐧昏澶辫触锛堣瑙?stderr/鏉冮檺锛夛細{instance}"
    return True, (f"鉁?瀹炰緥宸茬櫥璁? {instance}锛坮ole={e['role']} cwd={e['cwd']} ts={e['ts']}锛塡n"
                  f"   鐧昏琛? {INSTANCE_REGISTRY}")


def action_claim(task_id: str, instance: str, force: bool = False) -> tuple[bool, str]:
    """Claim a queued task for an instance.

    --force: 璺宠繃 pending_review 闃诲妫€鏌ワ紙鐢ㄤ簬涓嶅悓 assignee 鐨勫苟琛屼换鍔★級銆?
    #504锛?-force 鏀捐淇濈暀浣嗙暀鐥曗€斺€旂粫杩囦换浣曢樆濉為兘鍐?force-exceptions.log 鍙拌处锛堜緥澶栦笉寰楁棤鐥曪級銆?
    """
    force_note = ""
    # #620 瀹炰緥鍛藉悕閾佸緥锛氭柊 claim 涓€寰嬭８瑙掕壊鍚嶏紙宸ュ叿=鍙橀噺涓嶈繘鍚嶅瓧锛夈€備緥澶?鍦ㄥ唽瀛橀噺鏃у悕
    # 锛坽role}-<tool> 鍦ㄩ€旇嚜鐒舵秷浜★級+ INSTANCE_ROLE_MAP 鍘嗗彶閿紙hermes锛夈€?
    if not _legacy_dash_ok(instance):
        if not force:
            return False, ("#620 瀹炰緥鍛藉悕閾佸緥锛?-instance 鍙～瑁歌鑹插悕锛堝伐鍏?鍙橀噺涓嶈繘鍚嶅瓧锛夈€?
                           f"'{instance}' 甯?'-' 涓旈潪鍦ㄥ唽瀛橀噺韬唤锛涙部鐢ㄦ棫鍚嶈鍏?
                           f" register {instance}锛屾垨 --force --reason '<鐞嗙敱>' 鐣欑棔缁曡繃")
        ledger = _log_force_exception(task_id, instance, "claim 缁曡繃鍛藉悕閾佸緥锛堥潪瑁歌鑹插悕锛?,
                                      bypass="#620 瀹炰緥鍛藉悕閾佸緥")
        force_note = f"\n鈿狅笍 force 渚嬪宸茬暀鐥? {ledger}"

    rows = parse_queue()
    if force:
        # #504锛氭樉寮忔斁琛屼粛鍙敤锛堝苟琛屽鎵瑰満鏅級锛屼絾缁曡繃鍗崇暀鐥曪紙璋?浣曟椂/缁曡繃鍝潯锛?
        would_ok, would_reason = can_claim(task_id, rows, instance)
        if not would_ok:
            ledger = _log_force_exception(task_id, instance, f"claim 缁曡繃锛歿would_reason}",
                                          bypass="pending_review 闃诲锛?504 瀹℃煡绛夊緟鏈熷崰浣嶏級")
            force_note = f"\n鈿狅笍 force 渚嬪宸茬暀鐥? {ledger}"
    else:
        ok, reason = can_claim(task_id, rows, instance)
        if not ok:
            return False, reason

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}锛堝凡鎸夋枃浠跺悕鍜?frontmatter id 鍙岄噸鏌ユ壘锛?

    # #375 澶勭疆绫婚棬绂侊細缂哄唴瀹逛环鍊煎垽鏂妭鎷掔粷棰嗗彇
    fm, _ = parse_frontmatter(task_file)
    gate_ok, gate_msg = _check_disposal_gate(task_file, fm, task_id)
    if not gate_ok:
        return False, gate_msg

    with QueueLock("production-queue"):
        # Re-check gate inside lock
        rows = parse_queue()
        if not force:
            ok, reason = can_claim(task_id, rows, instance)
            if not ok:
                return False, reason

        new_status = f"claimed-{instance}"
        # #444 frontmatter 鍙ｅ緞锛歛ssignee=瑙掕壊鍚嶏紙鏂囨。缃插悕鍗曚竴鍙ｅ緞锛孍020/E045 鍚岀梾鏍规不锛夛紱
        # 瀹為檯鎵ц瀹炰緥鍙﹀瓨 instance 瀛楁銆傚瓨閲忎换鍔″崟 assignee=瀹炰緥鍚嶏紙濡?hermes锛変笉鍥炴敼鈥斺€?
        # 璇讳晶鍏煎锛圧EVIEW-PENDING 鐧昏鏄剧ず鍘熷€硷級锛屽巻鍙叉棦寰€涓嶅拵銆?
        # #503 鍙ｅ緞淇锛歝laim 涓嶆敼 assignee锛堜繚鎸佷换鍔″崟/闃熷垪琛屽師鍊硷級鈥斺€攌imi 鏄瑙掕壊鍏辩敤
        # 瀹炰緥锛屾寜 instance 鍙嶆帹瑙掕壊蹇呯劧閿欏啓锛?497 瀹炶瘉锛氱帇璇鍗曡瑕嗙洊鎴?laowantong锛夈€?
        # claim 鍙洿鏂?status=in_progress + instance=<鎵ц瀹炰緥>銆?
        apply_updates(task_id, new_status, task_file,
                      instance=instance, status="in_progress")

    ws_note = ensure_task_workspace(task_id, task_file)
    if ws_note:
        gate_msg = f"{gate_msg}\n{ws_note}"

    _register_instance(task_id, instance)  # #546锛歝laim 鍗充笂宀楃櫥璁帮紙鏃犳劅锛?

    return True, f"鉁?{task_id} 宸查鍙栦负 {new_status}{force_note}\n{gate_msg}"


# 浠ｇ爜绫讳换鍔℃彁瀹￠棬绂侊細浠诲姟鍗?frontmatter 澹版槑 code_files锛堢浉瀵逛粨搴撴牴鐨勮矾寰勫垪琛紝
# 鏀寔璺ㄤ粨锛氬惈 "Knowledge Delivery OS" 鐨勮矾寰勫綊 KDO 婧愮爜浠擄紝鍏朵綑褰?wiki 浠擄級銆?
# 鏈０鏄?code_files 鐨勪换鍔¤涓哄埗鍗?鏂囨。绫伙紝璞佸厤锛坧re-submit 闂ㄧ宸茬锛夈€?
KDO_REPO_ROOT = Path(r"C:\Users\Administrator\Knowledge Delivery OS 0.0.1")


def _git_uncommitted(repo_root: Path, paths: list[str]) -> list[str]:
    """Return paths with uncommitted changes in the given repo.

    Empty on git errors (fail-open: 闂ㄧ涓嶅洜 git 鐜寮傚父闃诲娴佽浆锛屼絾浼氭彁绀猴級銆?
    """
    if not repo_root.exists() or not (repo_root / ".git").exists():
        return []
    try:
        out = subprocess.run(
            ["git", "-C", str(repo_root), "status", "--porcelain", "--", *paths],
            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,  # #568锛欸BK 鎺у埗鍙颁笉鎸囧畾 encoding 鍗崇偢
        ).stdout
    except Exception as e:
        # #568锛歠ail-open 鍙鍖栤€斺€擡040 鑴忔敼鍔ㄦ娴嬭璺宠繃蹇呴』鐣欑棔锛堥潤榛?闂ㄧ鑷寸洸锛?
        print(f"[warn] E040 闂ㄧ缁勪欢 _git_dirty_paths 寮傚父璺宠繃锛堟寜鏃犺剰鏀瑰姩鏀捐锛? {e}", file=sys.stderr)
        return []
    dirty = []
    for line in out.splitlines():
        # porcelain line: "XY path" 鈥?strip the 2-char status column
        if len(line) >= 3 and line[2] == " ":
            path = line[3:]
        elif line.startswith("??"):
            path = line[3:]
        else:
            continue
        # 鏋勫缓浜х墿涓嶇畻鑴忥紙#527 瀹炶瘉锛歘_pycache__ 闅?pytest 鐗堟湰鍙樿劯锛岀洰褰曠骇 code_files 琚櫔澹拌鎷︼級
        if "__pycache__" in path or path.endswith(".pyc"):
            continue
        dirty.append(path)
    return dirty


def _check_code_gate(task_file: Path, fm: dict[str, Any]) -> tuple[bool, str]:
    """Reject complete when declared code files have uncommitted changes."""
    code_files = fm.get("code_files") or []
    if isinstance(code_files, str):
        code_files = [code_files]
    if not code_files:
        return True, ""

    wiki_root = Path(__file__).resolve().parents[2]
    dirty_all: list[str] = []
    for cf in code_files:
        cf = str(cf)
        repo = KDO_REPO_ROOT if "Knowledge Delivery OS" in cf else wiki_root
        dirty = _git_uncommitted(repo, [cf])
        for d in dirty:
            dirty_all.append(f"{'KDO' if repo == KDO_REPO_ROOT else 'wiki'}: {d}")

    if dirty_all:
        return False, (
            "浠ｇ爜绫讳换鍔℃彁瀹￠棬绂侊細浠ヤ笅鏀瑰姩鏂囦欢灏氭湭 commit锛岃鍏堟彁浜ゅ啀娴佽浆\n"
            + "\n".join(f"  - {d}" for d in dirty_all)
        )
    return True, ""


