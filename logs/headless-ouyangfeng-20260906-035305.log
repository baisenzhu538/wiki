DISPOSAL_KEYWORDS = ("鍒犻櫎", "娓呯悊", "褰掓。", "搴熷純", "澶勭疆", "绉婚櫎", "鍒犻櫎绫?)


def _extract_action_scope(body: str) -> str:
    """#457 鏂规 1锛堣緟锛夛細鍙彁鍙栥€?# 鍔ㄤ綔銆嶈妭 + 銆?# 浠诲姟鐩爣銆嶈妭锛堜笉鍚叏 body锛夆€斺€旀鏂囧彊杩颁笉瑙﹀彂鍏抽敭璇嶃€?""
    scope = []
    for sec in ("## 鍔ㄤ綔", "## 浠诲姟鐩爣"):
        idx = body.find(sec)
        if idx == -1:
            continue
        nxt = body.find("\n## ", idx + 1)
        scope.append(body[idx:nxt] if nxt > 0 else body[idx:])
    return "\n".join(scope)


def _check_disposal_gate(task_file: Path, fm: dict[str, Any], task_id: str) -> tuple[bool, str]:
    """澶勭疆绫讳换鍔?claim 妫€鏌ワ紙#457 缁撴瀯鍖栭噸鏋勶細鏄惧紡鏍囪浼樺厛 + 鍏抽敭璇嶉檺瀹氳寖鍥撮檷绾т负鎻愮ず锛夈€?

    - 鏄惧紡鏍囪 `disposal: true`锛堢紪鎺掍晶鍐欎换鍔″崟鏃舵爣娉級鈫?纭棬绂侊細蹇呴』甯︺€屽唴瀹逛环鍊煎垽鏂€嶈妭
    - 鍏抽敭璇嶏紙鍙壂鍔ㄤ綔鑺?浠诲姟鐩爣鑺傦級鈫?闄嶇骇涓烘彁绀猴紙涓嶇‖鎷︼級锛屽紩瀵艰ˉ鏍囪
    - 鎰忓浘涓嶅彉锛歅ROTOCOL 搂7 绱犳潗鍒犻櫎绂佷护锛堥€愪欢鑰佹湵浜叉壒锛夛紱#189/#454 璇垽鏍规不锛堟湳璇瘝涓嶈鍗★級
    """
    body = task_file.read_text(encoding="utf-8", errors="replace")
    title = str(fm.get("title") or task_file.stem)

    # 璞佸厤澹版槑锛歠rontmatter claim_gate_exempt 鍐欐槑鐞嗙敱
    if fm.get("claim_gate_exempt"):
        return True, f"锛坈laim_gate_exempt 璞佸厤锛歿fm['claim_gate_exempt']}锛?

    has_value_judgement = "鍐呭浠峰€煎垽鏂? in body

    # 1. 鏄惧紡鏍囪 鈫?纭棬绂侊紙鏂规 2锛屼富锛?
    if fm.get("disposal") is True:
        if not has_value_judgement:
            # #460 FAIL 閫€鍥炶ˉ鎻掓々锛氬缃‖闂ㄧ锛堟渶楂橀闄╅槻绾匡級鎷︽埅蹇呴』钀界洏鈥斺€斿惁鍒欐嫤鎴潤榛樼帇璇鏃犳劅
            _log_gate_blocked(task_id, "澶勭疆-纭棬绂?, "disposal:true 缂恒€屽唴瀹逛环鍊煎垽鏂€嶈妭锛圥ROTOCOL 搂7锛?, task_id)
            return False, (
                f"澶勭疆绫讳换鍔?{task_id}锛坒rontmatter disposal: true锛夌己銆屽唴瀹逛环鍊煎垽鏂€嶈妭鈥斺€旂姝㈤鍙栥€俓n"
                f"鑳屾櫙锛歅ROTOCOL 搂7 绱犳潗鍒犻櫎绂佷护锛?8-19 鑻辨枃澹充簨浠讹級銆俓n"
                f"璇峰湪浠诲姟鍗曡ˉ鍏呰妭锛氳浠诲姟娑夊強绱犳潗鐨勫唴瀹逛环鍊煎垽鏂紙璇昏繃鍐呭鍐嶅畾鍘诲悜锛夛紝"
                f"骞跺０鏄庡垹闄ら』閫愪欢鑰佹湵浜叉壒銆?
            )
        return True, (
            f"鉁?{task_id} 宸查鍙栵紙澶勭疆绫?disposal: true锛屽凡鍚唴瀹逛环鍊煎垽鏂妭锛夈€俓n"
            f"鎵ц鍓嶇‘璁ゆ竻鍗曪細\n"
            f"  鈶?绱犳潗澶勭疆榛樿鍙湁娑堝寲/褰掓。鍘熶綅淇濈暀锛屽垹闄ら』閫愪欢鑰佹湵浜叉壒锛圥ROTOCOL 搂7锛塡n"
            f"  鈶?鎵归噺涓夐棶锛歞ry-run 棰勮 / 鍙樻洿鑼冨洿澹版槑 / 闈炵┖鍊间笉瑕嗙洊\n"
            f"  鈶?澶勭疆鍓嶉€氳鍐呭锛圔5 鐗岋細鍏堣瀹屾暣鍐呭鍐嶄笅缁撹锛?
        )

    # 2. 鍏抽敭璇嶏紙闄愬畾鑼冨洿锛夆啋 闄嶇骇涓烘彁绀猴紝涓嶇‖鎷︼紙鏂规 1锛岃緟鈥斺€?189/#454 璇垽鏍规不锛?
    scope = title + "\n" + _extract_action_scope(body)
    hits = [k for k in DISPOSAL_KEYWORDS if k in scope]
    if hits:
        return True, (
            f"鈿狅笍 {task_id} 鐤戜技澶勭疆鏈爣璁帮細鍔ㄤ綔/鐩爣鑺傚懡涓?{hits}鈥斺€斿鍚礌鏉愬缃姩浣滐紝"
            f"璇疯ˉ frontmatter `disposal: true` + 銆屽唴瀹逛环鍊煎垽鏂€嶈妭锛?457锛汸ROTOCOL 搂7 鍒犻櫎椤昏€佹湵浜叉壒锛?
        )
    return True, ""


