    閲嶆彁鈮犳帴鏂板崟锛宑laim 涓嶈Е鍙?#504 own-pending 闃诲銆俆ASKS_DIR 妯″潡绾э紝娴嬭瘯鍙浛鎹€?
    """
    import re as _re
    fp = TASKS_DIR / f"{task_id}.md"
    try:
        text = fp.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return False
    return bool(_re.search(r"^rework:\s*(true|True|1)\s*$", text, _re.M))


def find_blockers(rows: list[dict] | None = None) -> tuple[list[dict], list[dict]]:
    """Return (pending_review_tasks, claimed_tasks) that block queue advance.

    #492锛歜atch:true 浠诲姟鐨?pending_review 涓嶉樆濉炲墠鏂癸紙闀跨▼鍒嗘壒浠诲姟璞佸厤锛夈€?
    """
    if rows is None:
        rows = parse_queue()
    pending = []
    claimed = []
    for row in rows:
        status = row["status"]
        if status == "pending_review":
            if not _is_batch_task(row["task_id"]):  # #492锛氭壒娆℃彁瀹¤眮鍏?
                pending.append(row)
        elif status.startswith("claimed-"):
            claimed.append(row)
    return pending, claimed


