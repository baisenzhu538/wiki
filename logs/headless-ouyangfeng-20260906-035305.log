    os.environ.get("KDO_TASK_DIR")
    or (Path(__file__).resolve().parent.parent.parent / "60_feedback" / "tasks")
)
BATCH_DIR = Path(
    os.environ.get("KDO_BATCH_DIR")
    or (Path(__file__).resolve().parent.parent.parent / "70_product" / "tasks")
