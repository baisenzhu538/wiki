# ---------------------------------------------------------------------------

# 璞佸厤澹版槑鍏抽敭璇嶏紙浠诲姟鍗曟墽琛屾姤鍛婃槑纭０鏄庝互涓嬪彛寰?鈫?璺宠繃鏍￠獙锛氱紪鎺?璇婃柇绫绘棤浠ｇ爜浜や粯鐗╋級
DELIVERABLE_EXEMPT_MARKERS = ("绾换鍔″崟淇敼", "绾换鍔″崟", "鏃犱唬鐮佷氦浠樼墿", "闆朵唬鐮佹敼鍔?)
# 鑷姩鏀跺彛鏂囦欢涓嶇畻浜や粯鐗╋紙complete 娴佽浆鏈韩浼?commit 瀹冧滑锛?
_DELIVERABLE_AUTO_COMMIT = {"production-queue.md", "dashboard.html"}

# 浜や粯鐗╄妭鍐呭閲岀殑鍙嶅紩鍙疯矾寰勶細鍚?/ 涓旀湁鎵╁睍鍚嶆墠璁わ紙闃插懡浠?瀛楁鍚嶈璇嗗埆锛?
_DELIVERABLE_PATH_RE = re.compile(r"`([^`\n]+)`")

# #625 浠诲姟2锛氳８璺緞 loose-scan锛?622 缁堝 FAIL 瀹炶瘉鈥斺€斾氦浠樼墿鑺傝矾寰勬湭鍔犲弽寮曞彿鏃讹紝
# 鍙嶅紩鍙峰惎鍙戝紡鍏ㄦ紡 鈫?E040 vacuous 閫氳繃 鈫?鍝ㄥ叺浠ｇ爜鏈叆浠撶収鏍锋彁瀹★級銆?
# 浠呭湪鍙嶅紩鍙疯瘑鍒负绌烘椂鍚敤鍏滃簳锛涙寜 vault 宸茬煡椤跺眰鐩綍鍓嶇紑鍖归厤瑁歌矾寰勶紝
# 鍛戒腑涓旀湁鏈叆浠?鈫?WARNING+鍙拌处锛堜笉鎷︽埅锛宲rop_20260902_ouyangfeng 鍙ｅ緞锛夈€?
_LOOSE_TOP_DIRS = (
    "kdo-tools", "90_control", "30_wiki", "40_outputs", "50_delivery",
    "60_feedback", "70_product", "20_memory", "10_raw", "agents", "cap_hub",
)
_LOOSE_PATH_RE = re.compile(
    r"(?<![\w/.\\-])((?:" + "|".join(_LOOSE_TOP_DIRS) +
    r")/[^\s`锛屻€傘€侊紱锛氾紙锛?)銆愩€慭"']+?\.[A-Za-z0-9]{1,10})(?![\w/-])"
)


def _extract_deliverable_paths_loose(report: str, task_file_name: str) -> list[str]:
    """浜や粯鐗╄妭瑁歌矾寰勫厹搴曟彁鍙栵紙鏃犲弽寮曞彿鍖呰９鐨勪粨鍐呯浉瀵硅矾寰勶級銆備粎 loose 鍦烘櫙鐢ㄣ€?""
    section = _extract_deliverable_section(report)
    paths: list[str] = []
    if section:
        for norm in _LOOSE_PATH_RE.findall(section):
            # 涓庡弽寮曞彿鐗堝悓鍙ｅ緞锛歘tmp 鍒掔棔璺緞 / 鑷姩鏀跺彛鏂囦欢 / 浠诲姟鍗曡嚜韬眮鍏?
            if norm.startswith("_tmp/") or "/_tmp/" in norm:
                continue
            base = norm.rsplit("/", 1)[-1]
            if base in _DELIVERABLE_AUTO_COMMIT or norm == task_file_name or base == task_file_name:
                continue
            if norm not in paths:
                paths.append(norm)
    return paths


def _extract_deliverable_section(report: str) -> str:
    """鎻愬彇鎵ц鎶ュ憡銆屼氦浠樼墿銆嶈妭鏂囨湰锛堥敋鐐?DELIVERY_FIELDS 鏀瑰姩鏂囦欢娓呭崟涓夊啓娉曪紱
    鑺傝竟鐣?涓嬩竴绮椾綋瀛楁/## 鏍囬锛夈€傛棤璇ヨ妭杩斿洖绌轰覆銆?""
    for anchor in DELIVERY_FIELDS["鏀瑰姩鏂囦欢娓呭崟"]:  # **浜や粯鐗?* / **鏀瑰姩鏂囦欢** / **鏂囦欢娓呭崟**
        idx = report.find(anchor)
        if idx == -1:
            continue
        rest = report[idx + len(anchor):]
        m_field = re.search(r"\n\s*(?:-\s*)?\*\*", rest)  # #569锛歚- **` 瀛愬脊琛屼篃绠楀瓧娈佃璧峰锛?551 鑺傚欢灞曡鍚炲疄璇侊級
        nxt_field = m_field.start() if m_field else -1
        nxt_head = rest.find("\n##")
        stops = [p for p in (nxt_field, nxt_head) if p > 0]
        return rest[:min(stops)] if stops else rest
    return ""


def _extract_deliverable_paths(report: str, task_file_name: str) -> list[str]:
    """浠庢墽琛屾姤鍛娿€屼氦浠樼墿銆嶈妭鎻愬彇鍙嶅紩鍙峰寘瑁圭殑鏂囦欢璺緞锛堝惎鍙戝紡锛岃瘑鍒笉鍑?杩斿洖绌衡啋WARNING 涓嶇‖鎷︼級銆?""
    section = _extract_deliverable_section(report)
    paths: list[str] = []
    if section:
        for tok in _DELIVERABLE_PATH_RE.findall(section):
            tok = tok.strip()
            if "/" not in tok and "\\" not in tok:
                continue
            if not re.search(r"\.[A-Za-z0-9]{1,10}$", tok):
                continue
            norm = tok.replace("\\", "/")
            # #515 鍒ゆ嵁 v1.1 鏍″噯鐐?1锛歚_tmp/` 鍒掔棔璺緞锛堝墠缂€鎴栬矾寰勬锛夎眮鍏嶁€斺€?
            # 涓棿浜х墿闈炰氦浠樼墿锛屼笁鎬佹鏌ユ棤鎰忎箟锛圗040 涓?pre_review 鍚屾簮鐢熸晥锛?
            if norm.startswith("_tmp/") or "/_tmp/" in norm:
                continue
            base = norm.rsplit("/", 1)[-1]
            if base in _DELIVERABLE_AUTO_COMMIT or norm == task_file_name or base == task_file_name:
                continue
            if norm not in paths:
                paths.append(norm)
    return paths


def _git_tracked(repo_root: Path, rel: str) -> bool:
    """git ls-files 鏍￠獙璺緞宸茶窡韪紱git 寮傚父鏃?fail-open 杩斿洖 True锛堜笉鎷︼級銆?""
    try:
        r = subprocess.run(
            ["git", "-C", str(repo_root), "ls-files", "--error-unmatch", "--", rel],
            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,  # #568锛欸BK 鎺у埗鍙颁笉鎸囧畾 encoding 鍗崇偢
        )
        return r.returncode == 0
    except Exception as e:
        # #568锛歠ail-open 鍙鍖栤€斺€擡040 宸茶窡韪牎楠岃璺宠繃蹇呴』鐣欑棔
        print(f"[warn] E040 闂ㄧ缁勪欢 _git_tracked({rel}) 寮傚父璺宠繃锛堟寜宸茶窡韪斁琛岋級: {e}", file=sys.stderr)
        return True


def _git_ignored(repo_root: Path, rel: str) -> bool:
    """#647锛氳矾寰勬槸鍚﹀懡涓?.gitignore锛?0_inbox/ 绛夐搧寰嬩笉鍏ヤ粨鍖猴級銆?

    鍒ゅ畾鐢?`git check-ignore`鈥斺€旈浂缁存姢銆佽窡闅忕湡瀹炶鍒欙紙#645 friction 瀹炶瘉锛氬€欓€夊崱
    鏍锋湰钀?00_inbox 鏃犳硶 commit锛孍040 纭嫤鍙兘鏀瑰啓浜や粯鐗╂帾杈炵粫琛岋級銆俫it 寮傚父
    fail-open 杩斿洖 False锛堢淮鎸佺‖鎷︾幇鐘讹紝涓嶅洜鐜寮傚父鏀惧ぇ鏀捐闈紝涓?_git_tracked 鍚屾锛夈€?
    """
    try:
        r = subprocess.run(
            ["git", "-C", str(repo_root), "check-ignore", "-q", "--", rel],
            capture_output=True, timeout=15,
        )
        return r.returncode == 0
    except Exception as e:
        print(f"[warn] E040 闂ㄧ缁勪欢 _git_ignored({rel}) 寮傚父鎸夋湭蹇界暐澶勭悊: {e}", file=sys.stderr)
        return False


def _check_deliverables_committed(task_file: Path, fm: dict[str, Any],
                                  wiki_root: Path | None = None) -> tuple[bool, str, str]:
    """#522锛氭墽琛屾姤鍛婁氦浠樼墿蹇呴』宸插叆浠擄紙宸茶窡韪?鏃犳湭鎻愪氦鏀瑰姩锛夛紝鏈叆浠撳嵆鎷︺€?

    杩斿洖 (ok, block_msg, warn_msg)銆傝瘑鍒笉鍑鸿矾寰?璞佸厤澹版槑 鈫?ok=True + warn锛堢孩绾?4锛?
    璇嗗埆涓嶅嚭=WARNING 涓嶇‖鎷︼級銆俢ode_files 澹版槑鐨勭敱 #363 闂ㄧ宸茬锛屾湰鏌ユ姤鍛婁氦浠樼墿鑺傘€?
    """
    wiki_root = wiki_root or _WIKI_ROOT
    try:
        body = task_file.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return True, "", "浠诲姟鍗曚笉鍙锛屼氦浠樼墿鏍￠獙璺宠繃"
    report = _extract_exec_report(body)
    if not report:
        return True, "", "鏃犳墽琛屾姤鍛婅妭锛團-034 闂ㄧ宸叉嫤鍦ㄥ墠锛?
    # 璞佸厤鍒ゅ畾鏀剁獎鍒般€屼氦浠樼墿銆嶈妭鍐呭０鏄庯紙#522 鑷綋搴旂敤瀹炶瘉锛氬畬鎴愬唴瀹?闇€瑕佽皝鍔ㄤ綔閲?
    # 寮曠敤璞佸厤璇嶄綔涓鸿鏄庢枃瀛椾篃浼氬懡涓叏鎶ュ憡鍖归厤鈥斺€旇眮鍏嶈瘝鍑虹幇鍦ㄤ氦浠樼墿鑺傛墠绠楀０鏄庯級
    if any(m in _extract_deliverable_section(report) for m in DELIVERABLE_EXEMPT_MARKERS):
        return True, "", "浠诲姟鍗曞０鏄庣函浠诲姟鍗曚慨鏀?鏃犱唬鐮佷氦浠樼墿鈥斺€斾氦浠樼墿鍏ヤ粨鏍￠獙璞佸厤"

    paths = _extract_deliverable_paths(report, task_file.name)
    if not paths:
        # #625 浠诲姟2锛氬弽寮曞彿鍚彂寮忎负绌?鈫?瑁歌矾寰?loose-scan 鍏滃簳銆俵oose 鍛戒腑鏈叆浠?
        # = WARNING+鍙拌处锛堜笉鎷︽埅锛夛紱骞昏璺緞锛堢洏涓婁笉瀛樺湪涓旀湭璺熻釜锛変笉鏌ャ€?
        loose_problems: list[str] = []
        for rel in _extract_deliverable_paths_loose(report, task_file.name):
            if not (wiki_root / rel).exists() and not _git_tracked(wiki_root, rel):
                continue
            if not _git_tracked(wiki_root, rel):
                loose_problems.append(f"untracked: {rel}")
                continue
            if _git_uncommitted(wiki_root, [rel]):
                loose_problems.append(f"鏈彁浜ゆ敼鍔? {rel}")
        if loose_problems:
            _log_gate_warning(str(fm.get("id") or task_file.stem),
                              "E040-loose浜や粯鐗╂湭鍏ヤ粨WARNING",
                              "锛?.join(loose_problems), str(fm.get("instance") or ""))
            return True, "", (
                "鈿狅笍 E040-loose锛?625锛夛細浜や粯鐗╄妭璺緞鏈姞鍙嶅紩鍙凤紝瑁歌矾寰勫厹搴曞懡涓?"
                f"{len(loose_problems)} 涓湭鍏ヤ粨鈥斺€旀湭 commit=涓嶅瓨鍦紙#622 瀹炶瘉锛夛細\n"
                + "\n".join(f"  - {p}" for p in loose_problems)
                + "\n琛ユ晳锛歡it add <璺緞> && git commit 鍚庨噸璺?complete"
                "锛堟湰娆?WARNING 涓嶆嫤鎴紝鍙拌处 90_control/gate-warning.log锛?
                "浜や粯鐗╄妭璺緞璇峰姞鍙嶅紩鍙疯 E040 纭棬绂佹帴绠★級"
            )
        return True, "", "浜や粯鐗╄妭鏈瘑鍒嚭鏂囦欢璺緞锛堝惎鍙戝紡瑕嗙洊澶栵級鈥斺€斾汉宸ヨ嚜鏍稿凡鍏ヤ粨"

    problems: list[str] = []
    external: list[str] = []
    ignored: list[str] = []  # #647锛歡itignore 璞佸厤璺緞锛堥搧寰嬩笉鍏ヤ粨锛岀洏涓婇獙鏀讹級
    for rel in paths:
        # 搴撳缁濆璺緞锛圖:/tech-wiki 绛夊叾浠栧簱/鐩橈級锛氫笉灞炰换浣曞凡鐭ヤ粨 git 鏃犳硶鏍搁獙
        # 鈫?WARNING 涓嶆嫤锛堢孩绾?4锛氳瘑鍒笉鍑轰笉璇嫤鈥斺€?534 鐙楃伯瀹炶瘉鎾炵嚎锛?
        if len(rel) > 1 and rel[1] == ":" and "Knowledge Delivery OS" not in rel:
            external.append(rel)
            continue
        repo = KDO_REPO_ROOT if "Knowledge Delivery OS" in rel else wiki_root
        # KDO 浠撹矾寰勭粰鐨勬槸缁濆/浠撳鐩稿鈥斺€斿彇浠撳唴鐩稿閮ㄥ垎
        repo_rel = rel.split("Knowledge Delivery OS 0.0.1/")[-1] if repo == KDO_REPO_ROOT else rel
        # #647锛歡itignore 璞佸厤鍒嗘敮鈥斺€斿懡涓?.gitignore锛?0_inbox/ 绛夛級涓嶅叆浠撴槸鏃㈠畾閾佸緥锛?
        # 鐩樹笂瀛樺湪鍗抽獙鏀讹紝杞?WARNING 涓嶇‖鎷?
        if _git_ignored(repo, repo_rel):
            ignored.append(rel)
            continue
        if not _git_tracked(repo, repo_rel):
            problems.append(f"untracked: {rel}")
            continue
        dirty = _git_uncommitted(repo, [repo_rel])
        if dirty:
            problems.append(f"鏈彁浜ゆ敼鍔? {rel}")

    if problems:
        msg = ("E040 浜や粯鐗╁叆浠撻棬绂侊紙#522锛夛細浠ヤ笅浜や粯鐗╂湭鍏ヤ粨鈥斺€旀湭 commit=鏈彂鐢焅n"
               + "\n".join(f"  - {p}" for p in problems)
               + "\n琛ユ晳锛歡it add <璺緞> && git commit -m '#<浠诲姟鍙? <浜や粯璇存槑> by <instance>' 鍚庨噸璺?complete"
               # #569锛氭姤閿欏彲鎿嶄綔鍖栤€斺€旇妭杈圭晫瑙勫垯+鏈熸湜鏍煎紡鏍蜂緥
               + "\n鏈熸湜鏍煎紡鏍蜂緥锛氭墽琛屾姤鍛婂唴 **浜や粯鐗?* 瀛楁鑺傦紙`- **` 瀛愬脊琛岃捣涔熺畻瀛楁琛岋級锛?
                 "鑺傚唴璺緞鐢ㄥ弽寮曞彿鍖呰９锛堝 `90_control/x.py`锛夛紝涓嬩竴绮椾綋瀛楁/## 鏍囬鍗宠妭杈圭晫锛?
                 "鍛戒护鏂囨湰锛堝 kdo pre-submit -f <璺緞>锛夊嬁鏀句氦浠樼墿鑺?)
        return False, msg, ""
    warn = f"浜や粯鐗╁叆浠撴牳楠岄€氳繃锛坽len(paths) - len(external) - len(ignored)} 涓矾寰勫凡璺熻釜涓旀棤鑴忔敼鍔級"
    if ignored:
        warn += (f"锛泏len(ignored)} 涓?gitignore 璞佸厤璺緞锛坃git_ignored锛氶搧寰嬩笉鍏ヤ粨锛?
                 f"鐩樹笂楠屾敹涓嶅己鍒?commit锛夛細{'銆?.join(ignored[:3])}")
    if external:
        warn += f"锛泏len(external)} 涓簱澶栫粷瀵硅矾寰勬棤娉?git 鏍搁獙锛圵ARNING 涓嶆嫤锛屼汉宸ヨ嚜鏍革級锛歿'銆?.join(external[:3])}"
    return True, "", warn


def _review_card_mark_reminder(task_file: Path) -> str:
    """#612 浠诲姟2锛歳eview verdict=pass 鏃讹紝鑻ユ墽琛屾姤鍛娿€屼氦浠樼墿銆嶈妭鍚?30_wiki 鍗＄墖
    璺緞锛岃繑鍥炰竴琛屻€孨 寮犱氦浠樺崱寰?review_mark 杞銆嶆彁閱掞紱鍚﹀垯杩斿洖绌轰覆銆?

    鍙彁閱掍笉鑷姩杞鈥斺€旇嚜鍔ㄨ浆姝?浠ｅ啓鍗＄墖 frontmatter锛岃秺鏉冮檺杈圭晫锛屼笉鍋氥€?
    璇嗗埆涓嶅嚭/璇诲彇寮傚父=绌轰覆锛堟彁閱掓€ц緭鍑猴紝缁濅笉闃绘柇缁堝涓绘祦绋嬶級銆?
    """
    try:
        body = task_file.read_text(encoding="utf-8", errors="ignore")
        report = _extract_exec_report(body)
        cards = [p for p in _extract_deliverable_paths(report, task_file.name)
                 if p.startswith("30_wiki/") and p.endswith(".md")]
        if not cards:
            return ""
        shown = "銆?.join(f"`{c}`" for c in cards[:5])
        more = f" 绛?{len(cards)} 寮? if len(cards) > 5 else ""
        return (f"\n馃搶 鎻愰啋锛歿len(cards)} 寮犱氦浠樺崱寰?review_mark 杞锛歿shown}{more}"
                "锛堢粓瀹￠€氳繃涓嶈嚜鍔ㄨ浆姝ｂ€斺€旇嚜鍔ㄨ浆姝ｆ秹鍙婁唬鍐欏崱鐗?frontmatter 鏉冮檺杈圭晫锛岃鐢熶骇鏂规墜鍔ㄥ洖濉級")
    except Exception:
        return ""



# #429 F-034 浜や粯浜斿瓧娈电‖鏍煎紡锛堣€佹湵鎷嶆澘銆屾兂鐘敊涔熺姱涓嶄簡銆嶏紝鍋滆溅鍦?F-034 鏀跺彛锛?
# 鏈鸿閿氱偣锛氭墽琛屾姤鍛婅妭鎴?--evidence 鏂囦欢鍚互涓嬫爣璁板嵆绠楄瀛楁瀛樺湪锛堝彧楠屽瓨鍦ㄦ€э紝涓嶅垽鍐呭璐ㄩ噺鈥斺€斿彧鎷︽満姊伴」涓嶇鍒ゆ柇锛?
DELIVERY_FIELDS: dict[str, tuple[str, ...]] = {
    "鏀瑰姩鏂囦欢娓呭崟": ("**浜や粯鐗?*", "**鏀瑰姩鏂囦欢**", "**鏂囦欢娓呭崟**"),
    "瀹屾垚鍐呭涓€鍙ヨ瘽": ("**瀹屾垚鍐呭**", "**涓€鍙ヨ瘽**", "**姒傝**"),
    "楠岃瘉鍛戒护+杈撳嚭": ("**楠岃瘉**", "**瀹炴祴**", "**娴嬭瘯**"),
    "鏈仛椤?杈圭晫": ("**杈圭晫**", "**鏈仛椤?*", "**寰呭畾涔?*", "**閬楃暀**"),
    "闇€瑕佽皝鍔ㄤ綔": ("**闇€瑕佽皝鍔ㄤ綔**", "**寰呭姙**", "**寰呯敤鎴锋媿鏉?*", "**寰呭**"),
}


def _extract_exec_report(body: str) -> str:
    """鎻愬彇浠诲姟鍗曘€?# 鎵ц鎶ュ憡銆嶈妭锛堝埌涓嬩竴涓?## 鎴栨枃浠跺熬锛夈€?""
    idx = body.find("## 鎵ц鎶ュ憡")
    if idx == -1:
        return ""
    nxt = body.find("\n## ", idx + 1)
    return body[idx:nxt] if nxt > 0 else body[idx:]


def _check_delivery_fields(task_file, evidence: str | None) -> tuple[bool, str]:
    """F-034锛氫氦浠樹簲瀛楁鏈鸿妫€鏌モ€斺€旂己椤?鎷掓敹锛?-force --reason 鍙０鏄庝緥澶栵紝#444 鍙拌处鐣欑棔锛夈€?

    #444锛歟vidence 涓嶅啀浣滀负浜斿瓧娈电殑鏇夸唬妫€鏌ラ潰鈥斺€斾簲瀛楁蹇呴』钀藉湪浠诲姟鍗曘€?# 鎵ц鎶ュ憡銆嶈妭
    锛坋vidence 鍙槸浣愯瘉闄勪欢锛岄槻姝㈡寚鍚戜换鍔″崟澶栨枃浠剁粫杩囦氦鎺ヨ涔夆€斺€?441 瀹炶瘉渚ч棬锛夈€?
    """
    if evidence is not None:
        # evidence 浠呴獙璇佸彲璇绘€э紙浣愯瘉闄勪欢锛夛紝妫€鏌ラ潰鎭掍负浠诲姟鍗曟墽琛屾姤鍛婅妭
        try:
            Path(evidence).read_text(encoding="utf-8", errors="ignore")
        except OSError:
            return False, f"--evidence 鏂囦欢涓嶅彲璇? {evidence}"
    body = task_file.read_text(encoding="utf-8", errors="ignore")
    check_text = _extract_exec_report(body)
    if not check_text:
        return False, "浠诲姟鍗曠己灏戙€?# 鎵ц鎶ュ憡銆嶈妭锛?429 F-034锛氫氦浠樺繀椤昏惤鎵ц鎶ュ憡锛屽彛澶村畬鎴?鏈畬鎴愶紱#444锛歟vidence 闄勪欢涓嶈兘鏇夸唬锛?
    # #569锛氬墠缂€鍖归厤鈥斺€斿墺閿氳瘝灏鹃儴鏄熷彿鍋氬墠缂€瀛愪覆鍒ゅ畾锛宍**鏀瑰姩鏂囦欢娓呭崟**` 鍛戒腑 `**鏀瑰姩鏂囦欢`锛堥棴鍚?** 涓嶅啀闃绘柇鍚堟硶鍚庣紑锛?
    missing = [k for k, anchors in DELIVERY_FIELDS.items()
               if not any(a.rstrip("*") in check_text for a in anchors)]
    if missing:
        sample = ("鍚堟硶鍐欐硶鏍蜂緥锛堜簲瀛楁鍚勮捣涓€琛岋紝绮椾綋閿氳瘝寮€澶村嵆鍙級锛? + "\n"
                  "  **浜や粯鐗?*锛歚璺緞/鏂囦欢` 鈥︹€? + "\n"
                  "  **瀹屾垚鍐呭**锛氫竴鍙ヨ瘽鈥︹€? + "\n"
                  "  **楠岃瘉**锛氬懡浠?+ 杈撳嚭鈥︹€? + "\n"
                  "  **杈圭晫**锛氣€︹€? + "\n"
                  "  **闇€瑕佽皝鍔ㄤ綔**锛氣€︹€?)
        return False, (f"鎵ц鎶ュ憡缂?{len(missing)} 涓瓧娈碉紙#429 F-034锛夛細{'銆?.join(missing)}銆傝琛ュ叏鍚庨噸璇曪紝"
                       f"鎴?--force --reason '<鐞嗙敱>' 澹版槑渚嬪锛?444 鍙拌处鐣欑棔锛夈€? + "\n" + sample)
    return True, ""


# #444 force 渚嬪鍙拌处锛?-force 缁曡繃 F-034 蹇呴』鐣欑棔锛堣皝/浣曟椂/缁曡繃鍝潯/涓轰綍锛夆€斺€斻€屽０鏄庝緥澶栥€嶄笉寰楁棤鐥?
FORCE_LEDGER = _WIKI_ROOT / "90_control" / "force-exceptions.log"


def _log_force_exception(task_id: str, instance: str, reason: str,
                         bypass: str = "F-034 浜や粯浜斿瓧娈?) -> str:
    """#444锛歠orce 渚嬪鍐欏叆鍙拌处锛岀粓瀹″彲瑙併€傝繑鍥炲彴璐﹁矾寰勪緵鎻愮ず銆?

    #504锛歜ypass 鍙傛暟鍖栤€斺€攃laim --force 缁曡繃 pending_review 闃诲鍚屾牱鐣欑棔锛堥粯璁や繚鎸?F-034 鍘熷彛寰勶級銆?
    """
    line = (f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}锝渢ask={task_id}锝渋nstance={instance}"
            f"锝渂ypass={bypass}锝渞eason={reason.strip()}\n")
    FORCE_LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with FORCE_LEDGER.open("a", encoding="utf-8") as f:
        f.write(line)
    # #511锛歠orce 渚嬪鍚屾鍐欒兌鍥婁簨浠跺眰锛坋vent_type=error鈥斺€斾緥澶栧嵆椋庨櫓浜嬩欢锛涙祴璇曚欢鍚?#483 鍒嗘祦涓嶅啓锛?
    if not task_id.startswith("task_9999_"):
        _capsule_event(instance or "unknown", "error",
                       f"force-exception;task={task_id};bypass={bypass};reason={reason.strip()[:200]}")
    return str(FORCE_LEDGER)


def action_complete(task_id: str, instance: str, evidence: str | None, force: bool = False,
                    reason: str | None = None) -> tuple[bool, str]:
    """Mark a claimed task as pending_review.

    --force: 鍏佽浠?queued 鐩存帴璺冲埌 pending_review锛堢敤浜庣敓浜у凡瀹屾垚浣嗘湭閫氳繃鑴氭湰棰嗗彇鐨勫満鏅級
    #444锛?-force 蹇呴』閰?--reason锛堜緥澶栫暀鐥曪紝鍙拌处 90_control/force-exceptions.log锛?
    #444锛?-evidence 璺緞鐣欐。浠诲姟鍗?frontmatter锛堜綈璇侀檮浠讹紝涓嶆浛浠ｄ簲瀛楁妫€鏌ラ潰锛?
    """
    rows = parse_queue()
    task = find_task(task_id, rows)
    if task is None:
        return False, f"浠诲姟 {task_id} 涓嶅湪闃熷垪涓?

    if force and task["status"] == "queued":
        pass  # 璺宠繃 claim锛岀洿鎺ユ彁浜?
    elif not (task["status"].startswith("claimed-")
              and _claimed_by_role(instance, task["status"][len("claimed-"):])):
        return False, (f"浠诲姟 {task_id} 鐘舵€佷负 {task['status']}锛屼笉鏄敱 {instance} 棰嗗彇鐨?
                       f"锛?620 杩囨浮鏈燂細瑁稿悕/鍚岃鑹叉棫鍚?{instance}-<tool> 鍧囧彲鏀跺彛锛?)

    # #444锛歠orce 鏃犵悊鐢?鎷掔粷锛堛€屽０鏄庝緥澶栥€嶈褰撳父瑙勯€氶亾鐨勬牴娌烩€斺€?441 瀹炶瘉锛?
    if force and not (reason and reason.strip()):
        _log_gate_blocked(task_id, "F-034-force鏃犵悊鐢?, "--force 鏈厤 --reason锛?444 渚嬪鐣欑棔瑕佹眰锛?, instance)
        return False, ("--force 缁曡繃 F-034 浜や粯浜斿瓧娈甸棬绂侊紝蹇呴』閰?--reason '<鐞嗙敱>'"
                       "锛?444锛氫緥澶栫暀鐥曗€斺€旇皝/涓轰綍/缁曡繃鍝潯/浣曟椂琛ワ紝鍙拌处鍙函锛?)

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}锛堝凡鎸夋枃浠跺悕鍜?frontmatter id 鍙岄噸鏌ユ壘锛?

    fm, _ = parse_frontmatter(task_file)
    if not force:
        # #429 F-034锛氫氦浠樹簲瀛楁纭牸寮忥紙鍗囩骇鏇夸唬鍘熷叧閿瘝妫€鏌ワ細pre-submit/鎵ц鎶ュ憡/楠屾敹锛?
        gate_ok, gate_msg = _check_delivery_fields(task_file, evidence)
        if not gate_ok:
            _log_gate_blocked(task_id, "F-034-浜斿瓧娈?, gate_msg, instance)
            return False, gate_msg

    # #444锛歠orce 渚嬪鍏ュ彴璐︼紙缁堝鍙锛?
    force_note = ""
    if force:
        ledger = _log_force_exception(task_id, instance, reason or "")
        force_note = f"\n鈿狅笍 force 渚嬪宸茬暀鐥? {ledger}"

    # #444锛歟vidence 鐣欐。浠诲姟鍗?frontmatter锛堜綈璇侀檮浠跺彲婧級
    fm_evidence = None
    if evidence:
        try:
            fm_evidence = str(Path(evidence).resolve().relative_to(_WIKI_ROOT)).replace("\\", "/")
        except ValueError:
            fm_evidence = evidence

    # 浠ｇ爜绫绘彁瀹￠棬绂侊紙#363锛夛細code_files 鏈?commit 鈫?鎷掔粷娴佽浆
    gate_ok, gate_msg = _check_code_gate(task_file, fm)
    if not gate_ok:
        return False, gate_msg

    # #522锛氫氦浠樼墿宸插叆浠撴牎楠岋紙E040 鏈哄櫒鍏滃簳锛夆€斺€旇瘑鍒笉鍑?璞佸厤澹版槑=WARNING 涓嶇‖鎷︼紙绾㈢嚎 4锛?
    dlv_ok, dlv_msg, dlv_warn = _check_deliverables_committed(task_file, fm)
    if not dlv_ok:
        _log_gate_blocked(task_id, "E040-浜や粯鐗╂湭鍏ヤ粨", dlv_msg, instance)
        return False, dlv_msg
    dlv_note = f"\n馃摝 浜や粯鐗╂牎楠? {dlv_warn}" if dlv_warn else ""

    # #515锛氭満鍣ㄩ瀹℃姤鍛婇殢鎻愬闄勪换鍔″崟锛堝弬鑰冨眰鈥斺€斾笉鏀捐涓嶆嫤鎴紱澶辫触涓嶉樆鏂祦杞紝
    # 棰勫澶辫触鏈韩鍐欏叆鎶ュ憡璁╃粓瀹″彲瑙侊級銆傛姤鍛婅繘浠诲姟鍗曗啋闅?complete 鑷姩 commit 杩涘喕缁撶増
    try:
        import pre_review
        pre_review.attach_pre_review(task_file, pre_review.run_pre_review(task_file))
    except Exception as e:  # 棰勫灞傛晠闅滀笉闃绘柇鐢熶骇娴佽浆锛堝弬鑰冨眰绾緥锛夛紝stderr 鐣欑棔
        import sys as _sys
        print(f"鈿狅笍 鏈哄櫒棰勫灞傛晠闅滐紙涓嶉樆鏂彁杞級: {e}", file=_sys.stderr)

    with QueueLock("production-queue"):
        rows = parse_queue()
        task = find_task(task_id, rows)
        # --force 鍏佽浠?queued 鐩磋烦锛氶攣鍐呴噸妫€蹇呴』鍚屾牱鎺ュ彈璇ュ満鏅?
        claimed_ok = (task["status"].startswith("claimed-")
                      and _claimed_by_role(instance, task["status"][len("claimed-"):]))
        if task is None or not (
            (force and task["status"] == "queued") or claimed_ok
        ):
            return False, "闃熷垪鐘舵€佸湪鍔犻攣鏈熼棿鍙戠敓鍙樺寲锛岃閲嶈瘯"

        apply_updates(task_id, "pending_review", task_file, status="pending_review",
                      evidence=fm_evidence)

    # #389锛氶棬绂侀€氳繃鍚庣櫥璁?REVIEW-PENDING 娈碉紙琚棬绂佹嫤鎴殑 complete 鍒颁笉浜嗚繖閲岋級
    try:
        rel_path = str(task_file.relative_to(_WIKI_ROOT)).replace("\\", "/")
    except ValueError:
        rel_path = str(task_file)
    _review_board_update(register={
        "seq": task["seq"], "task_id": task_id,
        "assignee": fm.get("assignee", task.get("assignee", "")),
        "task_file": rel_path,
    })

    return True, f"鉁?{task_id} 宸叉彁浜や负 pending_review锛岀瓑寰呮闃抽攱缁堝{force_note}{dlv_note}"


# #433 璐熷悜鍒よ瘝璇佹嵁灞傞棬绂侊紙椋庢竻鎵缓璁功 diag_20260823_fengqingyang-negative-claim-evidence-gate.md 閲囩撼锛?
# 娌绘爣灞傦細鎰忚涔﹀惈璐熷悜鏂█璇嶅繀椤诲甫 `**瀛樺湪鎬ф牳鏌?*` 閿氱偣锛堝彧楠岄敋鐐瑰瓨鍦紝涓嶅垽鏍告煡璐ㄩ噺鈥斺€擣-034 鍚屾鍘熷垯锛夈€?
