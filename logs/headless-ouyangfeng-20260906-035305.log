def _git_commit_transition(task_id: str, action: str, actor: str) -> None:
    """#390锛氭祦杞垚鍔熷悗鎶婃湰娆¤Е纰扮殑鏂囦欢 commit 鍏?git锛坧ath-scoped锛岀 add -A锛夈€?

    瑙︾闆?= 浠诲姟鍗?+ production-queue.md + dashboard.html銆?
    - 浠撳鏂囦欢锛圞DO_* 鐜鍙橀噺娌欑洅娴嬭瘯锛夎嚜鍔ㄨ烦杩囷紱鏃犳湭鎻愪氦鍙樻洿鏃堕潤榛樿繑鍥?
    - git 浠讳綍澶辫触锛歴tderr 閱掔洰鎶ヨ + 寰呮敹鍙ｆ竻鍗曡褰曪紝涓嶉樆鏂凡鎴愬姛鐨勬祦杞?
    - `git commit -- <paths>` 閮ㄥ垎鎻愪氦璇箟锛氬埆浜哄凡 staged 鐨勫湪鍒跺搧涓嶈瑁规専
    """
    try:
        if not (_WIKI_ROOT / ".git").exists():
            return
        files = [QUEUE_PATH, DASHBOARD_PATH]
        task_file = _find_task_file_dual(task_id)
        if task_file is not None:
            files.append(task_file)
            # #402锛歸orkspace 鐩綍闅忔祦杞?commit 鍏ユ。锛堜笌 #390 鏀跺彛鍏煎锛?
            ws = task_file.parent / f"{task_file.stem}-workspace"
            if ws.exists():
                files.extend(p for p in ws.rglob("*") if p.is_file())
        rels: list[str] = []
        for f in files:
            try:
                rel = str(Path(f).resolve().relative_to(_WIKI_ROOT)).replace("\\", "/")
            except (ValueError, OSError):
                continue  # 娌欑洅/澶氱幆澧冩寚鍚戜粨澶?鈫?涓嶅睘浜庢湰浠撴彁浜よ寖鍥?
            if rel not in rels:
                rels.append(rel)
        if not rels:
            return
        status = subprocess.run(
            ["git", "-C", str(_WIKI_ROOT), "status", "--porcelain", "--", *rels],
            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,  # #568锛欸BK 鎺у埗鍙颁笉鎸囧畾 encoding 鍗崇偢
        ).stdout
        if not status.strip():
            return  # 瑙︾鏂囦欢鍧囨棤鏈彁浜ゅ彉鏇达紙濡傞噸澶嶆祦杞?鎵嬪伐宸叉敹鍙ｏ級
        subprocess.run(
            ["git", "-C", str(_WIKI_ROOT), "add", "--", *rels],
            check=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,  # #568锛欸BK 鎺у埗鍙颁笉鎸囧畾 encoding 鍗崇偢
        )
        rows = parse_queue()
        task = find_task(task_id, rows)
        ref = f"#{task['seq']}" if task else task_id
        subprocess.run(
            ["git", "-C", str(_WIKI_ROOT), "commit", "-m",
             f"chore(queue): {ref} {action} by {actor}", "--", *rels],
            check=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,  # #568锛欸BK 鎺у埗鍙颁笉鎸囧畾 encoding 鍗崇偢
        )
    except Exception as e:
        print(
            f"馃毃 [GIT-COMMIT-FAILED] {task_id} {action} 娴佽浆宸叉垚鍔熶絾鑷姩 commit 澶辫触: {e}"
            f" 鈥斺€?宸茶鍏?{PENDING_COMMIT_LOG.name} 寰呮敹鍙ｆ竻鍗曪紝璇锋墜宸ユ敹鍙?,
            file=sys.stderr,
        )
        _record_commit_failure(task_id, action, str(e))

