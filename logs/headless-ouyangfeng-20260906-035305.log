def _review_board_update(register: dict | None = None, strike: str | None = None,
                         strike_note: str = "") -> None:
    """缁存姢 production-queue.md 鐨?REVIEW-PENDING 娈碉紙#389锛夈€?

    - register: {"seq","task_id","assignee","task_file"} 鈫?杩藉姞鐧昏琛岋紙task_id 绾у箓绛夛紱
      琛岃鎵嬪垹鏃朵笅娆?complete 浼氶噸鏂扮櫥璁?= 鑷籂姝ｏ級
    - strike: task_id 鈫?瀵瑰簲琛屽垝鎺夊苟闄勭粓瀹℃敞璁?
    娈典笉瀛樺湪鍒欏垱寤猴紙鎻掑埌 INBOX-PENDING 娈靛墠锛屾棤鍒欒拷鍔犳枃浠跺熬锛夈€?
    鍒楄〃琛岋紙闈炶〃鏍艰锛夛紝parse_queue 涓嶄細璇銆傚け璐ヤ笉闃绘柇娴佽浆锛屼絾鎵撳嵃璀﹀憡璁╁紓甯稿彲瑙併€?
    """
    try:
        if not QUEUE_PATH.exists():
            return
        text = QUEUE_PATH.read_text(encoding="utf-8")
        now = datetime.now().strftime("%m-%d %H:%M")

        items: list[str] = []
        if REVIEW_BEGIN in text and REVIEW_END in text:
            block = text.split(REVIEW_BEGIN)[1].split(REVIEW_END)[0]
            items = [l for l in block.splitlines() if l.startswith("- ")]

        if register:
            tid = register["task_id"]
            # O-3 鍒嗘壒鎻愬淇锛氬箓绛夊垽鏂帓闄ゅ凡鍒掓帀鐨勮鈥斺€斿垎鎵逛换鍔′簩娆?complete 鏃?
            # REVIEW-PENDING 娈靛凡鏈夎浠诲姟鐨勫垝鎺夎锛堝惈 tid锛夛紝鑻ヤ笉鎺掗櫎鍒欎笉鍐嶇櫥璁?= 鎻愬鏃犲０
            if not any(tid in l and not l.startswith("- ~~") for l in items):
                items.append(
                    f"- #{register['seq']} {tid}锝渰register['assignee']}锝滄彁瀹?{now}锝渰register['task_file']}"
                )
        if strike:
            for i, line in enumerate(items):
                if strike in line and not line.startswith("- ~~"):
                    items[i] = f"- ~~{line[2:]}~~{strike_note}"
        if not register and not strike:
            return

        board = [
            REVIEW_BEGIN, "",
            "## 鈿栵笍 寰呯粓瀹★紙鎻愬浠诲姟锛宷ueue_transition 鑷姩鐧昏锛?, "",
            "> 娆ч槼閿嬪紑宸ュ彧鐪嬭繖娈碉細鏈夎灏卞锛岀粓瀹″悗鑷姩鍒掓帀銆傚巻鍙蹭换鍔′笉鍥炲～锛?389锛屽彧鍚戝墠鐢熸晥锛夈€?,
            "",
        ] + items + ["", REVIEW_END]

        if REVIEW_BEGIN in text:
            new_text = text.split(REVIEW_BEGIN)[0] + "\n".join(board) + text.split(REVIEW_END)[1]
        else:
            inbox_marker = "<!-- INBOX-PENDING-BEGIN"
            if inbox_marker in text:
                new_text = text.replace(inbox_marker, "\n".join(board) + "\n\n" + inbox_marker, 1)
            else:
                new_text = text.rstrip() + "\n\n" + "\n".join(board) + "\n"
        QUEUE_PATH.write_text(new_text, encoding="utf-8")
    except Exception as e:
        print(f"鈿狅笍 REVIEW-PENDING 鐧昏澶辫触锛堜笉闃绘柇娴佽浆锛? {e}", file=sys.stderr)


