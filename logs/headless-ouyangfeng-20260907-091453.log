"""#677 回归：pre-submit tags 门禁激活（_check_tags）+ #498 词量口径。

用例：零 tags 卡 WARNING（软期）/ HARD 切换 / env 覆盖两态 /
空串残渣 / 普通卡 5-8 词带 / dk 卡 1-3 核心词带 / dk source 维度
（tags 维度或 frontmatter 字段任一满足）/ index/meta 跳过 / CLI 渲染。

运行：python -m pytest tests/test_pre_submit_tags_gate.py -q
"""
from pathlib import Path

from kdo.pre_submit import (
    TAGS_HARD_DATE,
    _check_tags,
    _tags_hard_date,
)


def _card(root: Path, rel: str, tags, extra_fm=None, card_type="concept") -> Path:
    p = root / rel
    p.parent.mkdir(parents=True, exist_ok=True)
    fm = ["---", f"type: {card_type}"]
    for k, v in (extra_fm or {}).items():
        fm.append(f"{k}: {v}")
    if tags is None:
        pass  # 不写 tags 块
    elif isinstance(tags, str):
        fm.append(f"tags: {tags}")
    else:
        fm.append("tags:")
        fm.extend(f"- {t}" if t else '- ""' for t in tags)
    fm.append("---")
    p.write_text("\n".join(fm) + "\n\n# 正文\n", encoding="utf-8")
    return p


def test_zero_tags_dk_card_warns_in_soft_window(tmp_path, monkeypatch):
    """软期：零 tags dk 卡 → WARNING（#677 验收：2 张零 tags 卡复现）。"""
    monkeypatch.setattr("kdo.pre_submit._tags_hard_date", lambda: "9999-12-31")
    doc = _card(tmp_path, "30_wiki/dark-knowledges/dk-x.md", None, card_type="dk")
    issues = _check_tags(tmp_path, [doc])
    assert len(issues) == 1
    assert issues[0].severity == "warning"
    assert issues[0].gate == "tags"
    assert "No tags" in issues[0].message


def test_zero_tags_errors_after_hard_date(tmp_path, monkeypatch):
    """HARD 期：零 tags → ERROR 拦截。"""
    monkeypatch.setattr("kdo.pre_submit._tags_hard_date", lambda: "2026-01-01")
    doc = _card(tmp_path, "30_wiki/concepts/c.md", None)
    issues = _check_tags(tmp_path, [doc])
    assert len(issues) == 1 and issues[0].severity == "error"


def test_env_override_switches_state(tmp_path, monkeypatch):
    """KDO_TAGS_HARD_DATE env 可提前门禁化（两态实证通道）。"""
    monkeypatch.setenv("KDO_TAGS_HARD_DATE", "2026-01-01")
    assert _tags_hard_date() == "2026-01-01"
    monkeypatch.delenv("KDO_TAGS_HARD_DATE")
    assert _tags_hard_date() == TAGS_HARD_DATE


