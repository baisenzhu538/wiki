def check_retrieval(content: str) -> dict:
    """检查复盘中是否包含 wiki 检索行为（§10.4.1 要求）。"""
    has_mention = any(sig.lower() in content.lower() for sig in RETRIEVAL_SIGNALS)
    has_discovery = any(sig in content for sig in RETRIEVAL_DISCOVERY)
    return {
