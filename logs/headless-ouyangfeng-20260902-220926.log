+def read_workspace_state(workspace: Path) -> dict:
+    """Read full workspace state via the kdo API (current schema).
+
+    `.kdo/state.json` is a legacy artifact: since the SQLite migration the
+    `sources` collection lives in `.kdo/state.sqlite` and is stripped from the
+    JSON, so reading the JSON directly KeyErrors on "sources" (#618).
+    """
+    state = load_state(workspace)
+    try:
+        data = {}
+        for key in state.keys():
+            value = state[key]
+            data[key] = value.as_list() if isinstance(value, SQLiteCollection) else value
+        return data
+    finally:
+        if isinstance(state, SQLiteState):
+            state.close()
+
 
