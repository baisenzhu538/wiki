    重提≠接新单，claim 不触发 #504 own-pending 阻塞。TASKS_DIR 模块级，测试可替换。
    """
    import re as _re
    fp = TASKS_DIR / f"{task_id}.md"
    try:
        text = fp.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return False
    return bool(_re.search(r"^rework:\s*(true|True|1)\s*$", text, _re.M))


