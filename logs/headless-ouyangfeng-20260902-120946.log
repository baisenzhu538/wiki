+def _resolve_source_files(root: Path, fm: dict) -> list[tuple[str, Path]]:
+    """frontmatter source_refs → [(原始 ref, 存在的源文件路径)]（剥行号锚；不存在的不返回）。"""
+    sources = fm.get("source_refs") or []
+    if isinstance(sources, str):
+        sources = [s.strip() for s in sources.split(",") if s.strip()]
+    resolved: list[tuple[str, Path]] = []
+    for s in sources:
+        if not isinstance(s, str) or not s.strip():
