+
+def _check_source_range(root: Path, files: list[Path]) -> list[PreSubmitIssue]:
+    """source_refs 行号区间抽验：区间必须落在源文件行数范围内且非空（越界=WARNING）。
+
+    机械判据：1 <= start <= end <= 文件行数；单行锚 `:N` 等价 N-N。
+    区间内容全空白 = 非空校验失败（引了个寂寞）。源文件不存在 → 跳过
+    （归 source_reachability 门禁）。#616/#614 实证：5 张卡区间/文件名漂移。
+    """
+    issues: list[PreSubmitIssue] = []
+    anchor_re = re.compile(r"^(.*[^:]):(\d+)(?:-(\d+))?$")
+    for fp in files:
+        if "30_wiki" not in fp.parts:
+            continue
+        text = safe_read(fp, limit=200_000)
+        fm, _ = parse_frontmatter(text)
+        sources = fm.get("source_refs") or []
+        if isinstance(sources, str):
+            sources = [s.strip() for s in sources.split(",") if s.strip()]
+        bad = []
+        for s in sources:
+            if not isinstance(s, str):
+                continue
+            m = anchor_re.match(s.strip())
+            if not m:
+                continue  # 无行号锚的引用不查（存在性归 source_reachability）
+            path_part, start_s, end_s = m.group(1), m.group(2), m.group(3)
+            start, end = int(start_s), int(end_s) if end_s else int(start_s)
+            target = None
+            for cand in (root / path_part,
+                         root / "10_raw/sources" / path_part,
+                         root / "00_inbox" / path_part):
+                if cand.is_file():
+                    target = cand
+                    break
+            if target is None:
+                continue
+            try:
+                lines = target.read_text(encoding="utf-8", errors="ignore").splitlines()
+            except OSError:
+                continue
+            total = len(lines)
+            if start < 1 or end < start or end > total:
+                bad.append(f"{s.strip()}（源文件仅 {total} 行）")
+                continue
+            if not any(l.strip() for l in lines[start - 1:end]):
+                bad.append(f"{s.strip()}（区间内容全空白）")
+        if bad:
+            issues.append(PreSubmitIssue(
+                "warning", "source_range", relpath(root, fp),
+                f"{len(bad)} 个 source_refs 行号区间越界/为空：" + "、".join(bad[:3])
+                + ("等" if len(bad) > 3 else "")
+                + "——区间漂移（#616/#614 实证），请核对源文件修正行号",
+            ))
+    return issues
