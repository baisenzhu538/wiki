+    """引号块+行号/「原话·口述」归因 → 源文件必须逐字命中（剥空白/标点后子串匹配），不命中=WARNING。
+
+    只查 30_wiki 卡、只查声称逐字的引文（无标注无归因词的普通引号不打扰）；
+    源文件不存在/读不出 → 跳过（存在性归 source_reachability 门禁管）。
+    """
+    issues: list[PreSubmitIssue] = []
+    for fp in files:
+        if "30_wiki" not in fp.parts:
+            continue
+        text = safe_read(fp, limit=200_000)
+        fm, body = parse_frontmatter(text)
+        if not body.strip():
+            continue
+        srcs = _resolve_source_files(root, fm)
+        if not srcs:
+            continue
+        # 源文本预归一化（每卡只读一次各源）
+        src_norm: list[tuple[str, str]] = []
+        for ref, sp in srcs:
+            try:
+                src_norm.append((ref, _quote_normalize(sp.read_text(
+                    encoding="utf-8", errors="ignore"))))
+            except OSError:
+                continue
+        if not src_norm:
+            continue
+        misses = []
+        for line in body.splitlines():
+            anchor_m = _LINE_ANCHOR_RE.search(line)
+            for qm in _QUOTE_SPAN_RE.finditer(line):
+                quote = qm.group(1).strip()
+                norm = _quote_normalize(quote)
+                if len(norm) < 8:  # 归一后不足 8 字=噪声（短词+恰好同行有标注）
+                    continue
+                # 触发条件：同行 L 行号标注，或引号 ±20 字窗口内有「原话/口述」归因词
+                attributed = bool(anchor_m)
+                if not attributed:
+                    window = line[max(0, qm.start() - 20):qm.end() + 20]
+                    attributed = bool(_ATTRIB_RE.search(window))
+                if not attributed:
+                    continue
+                if any(norm in sn for _, sn in src_norm):
+                    continue
+                tag = anchor_m.group(0) if anchor_m else "原话/口述归因"
+                misses.append(f"「{quote[:30]}…」（{tag}）")
+        if misses:
+            issues.append(PreSubmitIssue(
+                "warning", "quote_verbatim", relpath(root, fp),
+                f"{len(misses)} 处声称逐字的引文在 source_refs 源文件中未逐字命中："
+                + "、".join(misses[:3])
+                + ("等" if len(misses) > 3 else "")
+                + "——伪逐字引文模式（#616/#614 实证：改写/拼贴不得包装成原话+行号），"
+                "请核对源文件改为逐字引用或去掉引号",
+            ))
+    return issues
