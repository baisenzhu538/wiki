  311:     """Async variant of _get_rag — initializes LightRAG on the calling
  312:     event loop, which is required when a loop is already running (MCP server
  313:     handlers). Shares the same process-wide cache."""
  314:     key = str(Path(workspace_root) / ".kdo" / "graph_index")
  315:     if key in _RAG_CACHE:
  316:         return _RAG_CACHE[key]
  317: 
  318:     from lightrag import LightRAG
  319: 
  320:     index_dir = Path(key)
  321:     rag = LightRAG(
  322:         working_dir=str(index_dir),
  323:         embedding_func=_load_embedding_func(),
  324:         llm_model_func=_load_llm_func(),
  325:         log_level=20,  # INFO
  326:     )
  327:     await rag.initialize_storages()
  328:     _RAG_CACHE[key] = rag
  329:     return rag
  330: 
  331: 
  332: def _collect_all_wiki_pages(root: Path) -> list[dict]:
  333:     # Dynamic scan of every 30_wiki subdirectory — not a hardcoded whitelist.
  334:     # #671: dark-knowledges (332 cards) had 0 graph coverage because the
  335:     # whitelist predated the directory; a new domain must never need a code
  336:     # change to become retrievable. Coverage probe: 90_control/scripts/graph-index-coverage-probe.py
  337:     wiki_root = root / "30_wiki"
  338:     excluded = {"_archive"}  # deprecated cards, kept out of retrieval
  339:     pages: list[dict] = []
  340:     for wiki_dir in sorted(wiki_root.iterdir()):
  341:         if not wiki_dir.is_dir() or wiki_dir.name in excluded:
  342:             continue
  343:         pages.extend(_collect_wiki_pages(wiki_dir))
  344:     return pages
  345: 
  346: 
