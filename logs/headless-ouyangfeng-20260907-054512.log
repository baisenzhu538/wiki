=== sim_bundle_bat_675.py ===
#!/usr/bin/env python3
"""#675 wiki-bundle-backup.bat two-day simulation (Sunday / Monday).

Builds a sandbox git repo + fake DEST, derives a test copy of the target bat
with exactly four documented seams, runs Sunday then Monday, asserts log
truthfulness + snapshot behavior + cleanup semantics.

Seams (each must match exactly once, else harness aborts):
  S1 set "WIKI=..."        -> sandbox fakewiki
  S2 set "DEST=..."        -> sandbox dest
  S3 DayOfWeek for-loop    -> set "WD=%~1"  (weekday injected via argv)
  S4 offsite-2nd.bat call  -> SIM stub line (protect real Nutstore offsite dir)

Usage:
  python sim_bundle_bat_675.py --bat <production.bat> --label <red|green>
"""
import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).parent
SANDBOX = HERE / "sb"
FAKEWIKI = SANDBOX / "fakewiki"
DEST = SANDBOX / "dest"
TESTBAT = SANDBOX / "wiki-bundle-backup-test.bat"
GIT = r"C:\Program Files\Git\cmd\git.exe"
LOG = DEST / "wiki-bundle-daily.log"

S3_PAT = re.compile(r"^for /f %%w in \('powershell -NoProfile -Command \"\(Get-Date\)\.DayOfWeek\"\'\) do set \"WD=%%w\"\r?$", re.M)
S4_PAT = re.compile(r'^call "C:\\Users\\Administrator\\Desktop\\wiki\\90_control\\scripts\\wiki-bundle-offsite-2nd\.bat" >> "%LOG%" 2>&1\r?$', re.M)
S1_PAT = re.compile(r'^set "WIKI=.*"\r?$', re.M)
S2_PAT = re.compile(r'^set "DEST=.*"\r?$', re.M)


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def _force_remove(func, path, exc):
    import os
    import stat
    os.chmod(path, stat.S_IWRITE)
    func(path)


def build_sandbox():
    if SANDBOX.exists():
        shutil.rmtree(SANDBOX, onexc=_force_remove)
    FAKEWIKI.mkdir(parents=True)
    (FAKEWIKI / ".obsidian" / "themes" / "foo").mkdir(parents=True)
    (FAKEWIKI / ".obsidian" / "app.json").write_text('{"v":"day1"}', encoding="utf-8")
    (FAKEWIKI / ".obsidian" / "themes" / "foo" / "theme.css").write_text("/* t */", encoding="utf-8")
    (FAKEWIKI / "wiki.md").write_text("# sandbox\n", encoding="utf-8")
    for args in (["init"], ["add", "."],
                 ["-c", "user.email=t@t", "-c", "user.name=t", "commit", "-m", "init"]):
        r = run([GIT, "-C", str(FAKEWIKI)] + args)
        if r.returncode != 0:
            sys.exit(f"sandbox git {args[0]} failed: {r.stderr}")
    DEST.mkdir(parents=True)
    # seed 2 stale bundles so the rolling keep-2 cleanup has something to do on Monday
    (DEST / "wiki-bundle-20260901.bundle").write_text("stale", encoding="utf-8")
    (DEST / "wiki-bundle-20260904.bundle").write_text("stale", encoding="utf-8")


def build_test_bat(src_bat: Path):
    text = src_bat.read_text(encoding="utf-8", errors="strict")
    subs = [
        (S1_PAT, f'set "WIKI={FAKEWIKI}"', "S1 WIKI"),
        (S2_PAT, f'set "DEST={DEST}"', "S2 DEST"),
        (S3_PAT, 'set "WD=%~1"', "S3 weekday-stub"),
        (S4_PAT, f'echo [%DATE% %TIME%] SIM: offsite call stubbed (protect real Nutstore offsite) >> "%LOG%"', "S4 offsite-stub"),
    ]
    for pat, repl, name in subs:
        n = len(pat.findall(text))
        if n != 1:
            sys.exit(f"ABORT: seam {name} matched {n} times (bat drifted?) -- not testing what we think")
        text = pat.sub(lambda m, r=repl: r, text)
    TESTBAT.write_text(text, encoding="utf-8", newline="\r\n")
    return [name for _, _, name in subs]


def run_day(day: str):
    r = run(["cmd", "/c", str(TESTBAT), day])
    return r.returncode


def sections():
    """Split the appended daily.log into (sunday, monday) sections."""
    lines = LOG.read_text(encoding="utf-8", errors="replace").splitlines()
    idx = next((i for i, l in enumerate(lines) if "wiki weekly bundle start (Monday)" in l), None)
    if idx is None:
        return lines, []
    return lines[:idx], lines[idx:]


def main():
    try:
        sys.stdout.reconfigure(errors="backslashreplace")
    except Exception:
        pass
    ap = argparse.ArgumentParser()
    ap.add_argument("--bat", required=True)
    ap.add_argument("--label", required=True)
    args = ap.parse_args()

    build_sandbox()
    seams = build_test_bat(Path(args.bat))

    results = []
    def check(name, ok, detail=""):
        results.append((name, bool(ok), detail))

    rc_sun = run_day("Sunday")
    sun_snap = DEST / "obsidian-snapshot" / ".obsidian"
    sun, _ = sections()
    check("S1 Sunday: skip line present exactly once", sum("skip: not Monday" in l for l in sun) == 1)
    check("S2 Sunday: no weekly start / no OK bundle", not any("weekly bundle start" in l or "OK bundle=" in l for l in sun))
    check("S3 Sunday: snapshot updated line", any("OK .obsidian snapshot updated" in l for l in sun))
    check("S4 Sunday: snapshot dir really written",
          (sun_snap / "app.json").exists() and (sun_snap / "themes" / "foo" / "theme.css").exists())
    sun_claim = [l for l in sun if "skip: not Monday" in l]
    claims_snapshot = sun_claim and ("snapshot" in sun_claim[0] and "still run" in sun_claim[0])
    check("S5 Sunday: skip wording truthfully implies snapshot ran", not claims_snapshot or
          any("OK .obsidian snapshot updated" in l for l in sun), sun_claim[0].strip() if sun_claim else "no skip line")

    # day2: change config, then Monday full path
    (FAKEWIKI / ".obsidian" / "app.json").write_text('{"v":"day2"}', encoding="utf-8")
    run([GIT, "-C", str(FAKEWIKI), "-c", "user.email=t@t", "-c", "user.name=t",
