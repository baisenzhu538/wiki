        "下次启动最需要记住": "元反思", "五步法反思": "思维盲点",
        "角色定位": "概要", "黄牌/表扬": "飞轮效应", "必做": "下次改进",
        "对照实验": "对照实验", "下次改进": "下次改进",
    }
    normalized = _re.sub(r"^## \d+\. ", "## ", content, flags=_re.M)
    for alias, canon in ALIASES.items():
        normalized = normalized.replace(f"## {alias}", f"## {canon}")
