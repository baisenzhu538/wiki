            else:
                bs_verdict, bs_ok, bs_detail = "fail", False, "盲点节无根因追问（为什么漏）"
    else:
        bs_verdict, bs_ok, bs_detail = "fail", False, "缺思维盲点章"

    # ── 2. 顿悟必须推翻某认知 ─────────────────────────────
