"""Dashboard action buttons and local HTTP server."""

from __future__ import annotations

import html
import http.server
import json
import secrets
import subprocess
import sys
import urllib.parse
from pathlib import Path
from typing import Any, Callable

from .workspace import SQLiteState, load_state

DashboardRenderer = Callable[..., str]

READ_ONLY_DASHBOARD_SUBCOMMANDS = frozenset({"lint", "validate", "status"})
WRITE_DASHBOARD_SUBCOMMANDS = frozenset({"ingest", "improve", "enrich"})
ALLOWED_KDO_SUBCOMMANDS = READ_ONLY_DASHBOARD_SUBCOMMANDS | WRITE_DASHBOARD_SUBCOMMANDS


def action_button(label: str, command: str, extra_args: list[str] | None = None) -> str:
    args_json = html.escape(json.dumps(extra_args or []), quote=True)
    safe_cmd = html.escape(command, quote=True)
    safe_label = html.escape(str(label if label is not None else ""), quote=True)
    return f"<button class='action-btn' onclick='kdoRun(\"{safe_cmd}\",{args_json})'>{safe_label}</button>"


def dashboard_command_error(command: str, args: list[str], allow_actions: bool) -> str:
    if command not in ALLOWED_KDO_SUBCOMMANDS:
        return f"Command not allowed: {command!r}"
    if command in WRITE_DASHBOARD_SUBCOMMANDS and not allow_actions:
        return f"Command requires dashboard --allow-actions: {command!r}"
    if command == "validate" and "--write-report" in args and not allow_actions:
        return "validate --write-report requires dashboard --allow-actions."
    return ""


def is_allowed_dashboard_origin(origin: str) -> bool:
    if not origin:
        return True
    parsed = urllib.parse.urlparse(origin)
    return parsed.scheme in {"http", "https"} and parsed.hostname in {"localhost", "127.0.0.1"}


def make_dashboard_handler(
    root: Path,
    render_dashboard: DashboardRenderer,
    allow_actions: bool = False,
    csrf_token: str | None = None,
) -> type[http.server.BaseHTTPRequestHandler]:
    token = csrf_token or secrets.token_urlsafe(32)

    class DashboardHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path in {"/", "/index.html"}:
                state = load_state(root)
                try:
                    content = render_dashboard(root, state, actions_enabled=allow_actions, csrf_token=token).encode("utf-8")
                finally:
                    if isinstance(state, SQLiteState):
                        state.close()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(content)))
                self.end_headers()
                self.wfile.write(content)
            else:
                self.send_response(404)
                self.end_headers()

        def do_POST(self) -> None:
            if self.path != "/run":
                self.send_response(404)
                self.end_headers()
                return
            origin = self.headers.get("Origin", "")
            if not is_allowed_dashboard_origin(origin):
                self._json(403, {"error": "Cross-origin requests not allowed."})
                return
            request_token = self.headers.get("X-KDO-CSRF-Token", "")
            if not secrets.compare_digest(request_token, token):
                self._json(403, {"error": "Invalid CSRF token."})
                return
            length = int(self.headers.get("Content-Length", 0) or 0)
            raw = self.rfile.read(length)
            try:
                payload = json.loads(raw)
            except (json.JSONDecodeError, ValueError):
                self._json(400, {"error": "Invalid JSON."})
                return
            command = payload.get("command", "")
            args = payload.get("args", [])
            if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
                self._json(400, {"error": "args must be a list of strings."})
                return
            error = dashboard_command_error(command, args, allow_actions=allow_actions)
            if error:
                self._json(400, {"error": error})
                return
            try:
                result = subprocess.run(
                    [sys.executable, "-m", "kdo", command, *args],
                    capture_output=True,
                    text=True,
                    cwd=str(root),
                    timeout=60,
                )
                self._json(
                    200,
                    {
                        "stdout": result.stdout,
                        "stderr": result.stderr,
                        "returncode": result.returncode,
                    },
                )
            except subprocess.TimeoutExpired:
                self._json(200, {"stdout": "", "stderr": "Command timed out.", "returncode": -1})
