"""Artifact target parsing and deliverable skeleton generation."""

from __future__ import annotations

import re
from pathlib import Path
from typing import Any

from .workspace import ensure_dir, now_iso, parse_frontmatter, safe_read, slugify, write_markdown

CONTENT_SUBTYPES = {"article", "video", "audio", "tutorial", "course", "report"}
CODE_SUBTYPES = {"app", "plugin", "template", "script", "package"}
CAPABILITY_SUBTYPES = {"skill", "agent", "workflow", "eval", "playbook"}


def find_artifact(state: dict[str, Any], artifact_id: str) -> dict[str, Any] | None:
    for artifact in state.get("artifacts", []):
        if artifact.get("artifact_id") == artifact_id:
            return artifact
    return None


def link_artifact_to_sources(state: dict[str, Any], source_refs: list[str], artifact_id: str, artifact_path: str) -> None:
    for source in state.get("sources", []):
        if source.get("id") not in source_refs:
            continue
        derived = source.setdefault("derived_outputs", [])
        item = {"artifact_id": artifact_id, "path": artifact_path}
        if item not in derived:
            derived.append(item)


def select_artifacts(state: dict[str, Any], artifact_id: str | None) -> list[dict[str, Any]]:
    if artifact_id:
        artifact = find_artifact(state, artifact_id)
        if artifact is None:
            raise ValueError(f"Unknown artifact id: {artifact_id}")
        return [artifact]
    return list(state.get("artifacts", []))


def parse_artifact_target(target: str) -> tuple[str, str]:
    if "/" not in target:
        raise ValueError("Artifact target must look like `content/article`, `code/template`, or `capability/skill`.")
    artifact_type, subtype = target.split("/", 1)
    if artifact_type == "capabilities":
        artifact_type = "capability"
    if artifact_type not in {"content", "code", "capability"}:
        raise ValueError("Artifact type must be one of: content, code, capability.")
    valid = {
        "content": CONTENT_SUBTYPES,
        "code": CODE_SUBTYPES,
        "capability": CAPABILITY_SUBTYPES,
    }[artifact_type]
    if subtype not in valid:
        raise ValueError(f"Unsupported {artifact_type} subtype `{subtype}`. Valid: {', '.join(sorted(valid))}.")
    return artifact_type, subtype


def infer_source_refs_from_results(results: list[tuple[int, Path, str]]) -> list[str]:
