class TestDirectWorkflowCommands(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        init_workspace(self.root)

    def tearDown(self):
        self.tmp.cleanup()

    def _patch_workspace(self, module):
        original = module.find_workspace
        module.find_workspace = lambda: self.root
        return original

    def test_produce_dashboard_improve_direct(self):
        original_delivery = self._patch_workspace(delivery)
        original_dashboard = self._patch_workspace(dashboard_cmd)
        original_feedback = self._patch_workspace(feedback)
        try:
            with load_state(self.root) as state:
                baseline_artifacts = len(state.get("artifacts", []))

            produce_args = argparse.Namespace(
                artifact="content/article",
                topic="Direct Product",
                title=None,
                target_user="Builder",
                channel="local",
            )
            with contextlib.redirect_stdout(io.StringIO()):
                self.assertEqual(delivery.cmd_produce(produce_args), 0)

            with load_state(self.root) as state:
                self.assertEqual(len(state.get("artifacts", [])), baseline_artifacts + 1)

            dash_args = argparse.Namespace(output="dashboard.html", view="overview", serve=False, port=7654, allow_actions=False)
            with contextlib.redirect_stdout(io.StringIO()):
                self.assertEqual(dashboard_cmd.cmd_dashboard(dash_args), 0)
            self.assertTrue((self.root / "dashboard.html").exists())

            improve_args = argparse.Namespace(output=None, print_plan=False, apply=False, dry_run=False, yes=False)
            with contextlib.redirect_stdout(io.StringIO()):
                self.assertEqual(feedback.cmd_improve(improve_args), 0)
            with load_state(self.root) as state:
                self.assertEqual(len(state.get("improvement_plans", [])), 1)
        finally:
            delivery.find_workspace = original_delivery
            dashboard_cmd.find_workspace = original_dashboard
            feedback.find_workspace = original_feedback


