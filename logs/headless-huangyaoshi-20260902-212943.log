import gc

import pytest

from kdo.workspace import _LIVE_SQLITE_STATES


@pytest.fixture(autouse=True)
def _gc_after_test():
    """Release SQLite connections after each test.

    Windows cannot delete a file while it is held open. SQLite-backed state
    keeps a file handle, so we ensure live SQLiteState instances are closed
    before temp directories are cleaned up.
    """
    yield
    gc.collect()
    for state in list(_LIVE_SQLITE_STATES):
        try:
            state.close()
        except Exception:
            pass
    gc.collect()
