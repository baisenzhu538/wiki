  def _scan_backup_stall(state: dict) -> list[str]:
      """#607：vault backup 心跳停拍报警——最后一次 'vault backup' commit 超 24h 即告。
      跨越沿幂等（同第九信号）：持续停拍只报一次，恢复后再停重报。"""
      try:
          out = subprocess.run(
              ["git", "-C", str(ROOT), "log", "-1", "--grep=vault backup", "--format=%ct"],
              capture_output=True, text=True, timeout=15, encoding="utf-8", errors="replace",
          ).stdout.strip()
          age_h = (time.time() - int(out)) / 3600 if out else float("inf")
      except Exception:
          return []  # 读不出不误报（红线 4 同款口径）
      flagged = state.get("backup_stall", False)
      if age_h > 24:
          state["backup_stall"] = True
          if not flagged:
              return [f"vault-backup｜{age_h:.0f}h 无 commit（阈值 24h）"]
      else:
          state["backup_stall"] = False
      return []
  ```
