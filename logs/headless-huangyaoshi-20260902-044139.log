def load_json(p, default):
    try:
        with io.open(p, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def fmt_age(sec):
    if sec is None:
        return "无实例记录"
    if sec < 90:
        return "刚写入"
    return f"{sec / 60:.0f}min前"


def main():
