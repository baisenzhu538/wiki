NEGATIVE_CLAIM_PATTERN_DATA = re.compile(r"(?:grade|字段|值|数据|内容|文件|路径|事件|记录)[ _]{0,3}(?:为空|空值|已损坏|被损坏|已截断|乱码|半写)")
