        changed = False
        if text.startswith("---"):
            parts = text.split("---", 2)
            if len(parts) >= 3:
                text = parts[2].strip()
                changed = True
        lines = text.splitlines()
        if lines and title_re.match(lines[0]):
            text = "\n".join(lines[1:]).strip()
            changed = True
    return text
```

