Usage:
  python kdo-tools/daily-context-save.py save --agent <id> --truman --stdin  # 从 stdin 读复盘（推荐）
  python kdo-tools/daily-context-save.py save --agent <id> --text "<摘要>" [--truman]
  python kdo-tools/daily-context-save.py list --agent <id>
"""

import argparse
