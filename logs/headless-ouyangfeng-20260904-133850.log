39:     """Parse production-queue.md table rows.
40: 
41:     Detection is encoding-robust: uses the ASCII separator row ``|:---:|…``
42:     to find the queue data table rather than matching Chinese header text.
43:     """
44:     rows = []
45:     in_table = False
46:     with open(path, "r", encoding="utf-8") as f:
47:         for line in f:
48:             line = line.rstrip("\n")
49:             if not in_table:
50:                 # Detect table by separator row — pure ASCII, immune to
51:                 # Mojibake / double-encoding issues on Chinese headers.
52:                 if re.match(r"^\|:---", line.strip()):
53:                     in_table = True
54:                 continue
