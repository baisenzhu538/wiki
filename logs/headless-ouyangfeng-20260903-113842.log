                return 1
            i += 2
        elif args[i] == "--review-file" and i + 1 < len(args):
            review_file = args[i + 1]
            i += 2
        elif args[i] == "--note" and i + 1 < len(args):
            note = args[i + 1]
            i += 2
        else:
