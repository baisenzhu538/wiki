+"""#639 回归：pre-submit 清单体结构 WARNING（_check_qingdanti_structure）。
+
+用例：超长散文化段落命中 / 清单体分层结构不命中 / 代码围栏内散文不计 /
+单段 ≥400 字命中 / 非 30_wiki 文件不查 / CLI 输出渲染门禁。
+
+运行：python -m pytest tests/test_pre_submit_qingdanti_structure.py -q
+"""
+from pathlib import Path
+
+from kdo.pre_submit import (
+    _QD_PARA_CHARS,
+    _QD_PROSE_RUN_LINES,
+    _check_qingdanti_structure,
+)
+
+
+def _card(root: Path, name: str, body: str, subdir: str = "concepts") -> Path:
+    fm = ["---", f"title: {name}", "type: concept", "---"]
+    p = root / "30_wiki" / subdir / name
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text("\n".join(fm) + "\n\n" + body, encoding="utf-8")
+    return p
+
+
+def test_long_prose_run_warns(tmp_path):
+    """命中：连续散文化段落 ≥8 行 → 一条 WARNING。"""
+    body = "\n".join(f"这是第{i}行没有任何分层结构的散文内容，一口气往下写。" for i in range(_QD_PROSE_RUN_LINES + 2))
+    card = _card(tmp_path, "concept-x.md", body)
+    issues = _check_qingdanti_structure(tmp_path, [card])
+    assert len(issues) == 1
+    assert issues[0].severity == "warning"
+    assert issues[0].gate == "qingdanti_structure"
+    assert "清单体" in issues[0].message
+
+
+def test_structured_list_no_warning(tmp_path):
+    """不命中：清单体分层结构（小标题+编号列表+重点前置）→ 零 issue。"""
+    body = "## 一、结论先行\n\n1. 第一条要点，一句一事。\n2. 第二条要点。\n3. 第三条要点。\n\n## 二、展开\n\n- 细节 A\n- 细节 B\n- 细节 C\n"
+    card = _card(tmp_path, "concept-y.md", body)
+    assert _check_qingdanti_structure(tmp_path, [card]) == []
+
+
+def test_code_fence_prose_ignored(tmp_path):
+    """代码围栏内的长文本不算散文段落。"""
+    prose = "\n".join(f"long prose line {i} inside a fence" for i in range(20))
+    body = "## 示例\n\n```\n" + prose + "\n```\n\n- 要点\n"
+    card = _card(tmp_path, "concept-z.md", body)
+    assert _check_qingdanti_structure(tmp_path, [card]) == []
+
+
+def test_single_long_paragraph_warns(tmp_path):
+    """单段 ≥400 字（即使行数少）→ WARNING。"""
+    body = "这是一段超长无分层的散文。" * (_QD_PARA_CHARS // 13 + 2)
+    card = _card(tmp_path, "concept-w.md", body)
+    issues = _check_qingdanti_structure(tmp_path, [card])
+    assert len(issues) == 1 and issues[0].gate == "qingdanti_structure"
+
+
+def test_non_wiki_files_skipped(tmp_path):
+    """非 30_wiki 文件不查（如 00_inbox 素材稿）。"""
+    p = tmp_path / "00_inbox" / "note.md"
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text("散" * 600 + "\n", encoding="utf-8")
+    assert _check_qingdanti_structure(tmp_path, [p]) == []
+
+
+def test_short_prose_no_warning(tmp_path):
+    """短散文（<8 行且 <400 字）不提示——普通卡片不误伤。"""
+    body = "## 概要\n\n三行以内的短说明。\n两句话结束。\n\n- 要点一\n"
+    card = _card(tmp_path, "concept-v.md", body)
+    assert _check_qingdanti_structure(tmp_path, [card]) == []
+
+
+def test_cli_report_renders_qingdanti_structure():
+    """CLI 展示层回归：qingdanti_structure 的 WARNING 必须出现在输出（防硬编码清单丢弃）。"""
+    from kdo.pre_submit import PreSubmitIssue, PreSubmitReport, format_report
+    report = PreSubmitReport(
+        files_checked=1, passed=1, failed=0,
+        issues=[PreSubmitIssue("warning", "qingdanti_structure",
+                               "30_wiki/concepts/x.md", "超长无分层段落")],
+    )
+    out = format_report(report)
+    assert "[QINGDANTI_STRUCTURE]" in out
+    assert "超长无分层段落" in out

