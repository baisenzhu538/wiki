+    for fp in files:
+        if "30_wiki" not in fp.parts:
+            continue
+        text = safe_read(fp, limit=200_000)
+        _, body = parse_frontmatter(text)
+        if not body.strip():
+            continue
+        in_fence = False
+        run = 0           # 当前连续散文行数
+        run_chars = 0     # 当前段落累计字符
+        worst = 0         # 最长连续散文行数
+        longest_para = 0  # 最长单段字符数
+        for line in body.splitlines():
+            s = line.strip()
+            if s.startswith("```"):
+                in_fence = not in_fence
+                run, run_chars = 0, 0
+                continue
+            if in_fence:
+                continue
+            is_prose = (
+                bool(s)
+                and not s.startswith(_QD_STRUCT_PREFIXES)
+                and not _QD_LIST_ITEM_RE.match(s)
+            )
+            if is_prose:
+                run += 1
+                run_chars += len(s)
+                worst = max(worst, run)
+                longest_para = max(longest_para, run_chars)
+            else:
+                run, run_chars = 0, 0
+        if worst >= _QD_PROSE_RUN_LINES or longest_para >= _QD_PARA_CHARS:
+            issues.append(PreSubmitIssue(
+                "warning", "qingdanti_structure", relpath(root, fp),
+                f"超长无分层段落（连续散文 {worst} 行 / 单段 {longest_para} 字）"
+                "——按清单体结构标准重组：分层≤3 层/编号序列/重点前置/提出-展开-回收"
+                "（手册 §12.2.1，方法论锚 [[yt-note-checklist-concept]]；"
+                "#639 提示制不拦截）",
+            ))
+    return issues
