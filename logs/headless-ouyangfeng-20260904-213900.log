def _is_card(path: Path) -> bool:
    """Heuristic: a card is a .md file with frontmatter that has a type field."""
    try:
        text = safe_read(path, limit=500)
        fm, _ = parse_frontmatter(text)
        return bool(fm.get("type"))
    except Exception:
        return False


