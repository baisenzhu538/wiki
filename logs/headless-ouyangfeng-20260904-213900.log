def _collect_files(root: Path, files: Optional[list[str]] = None,
                   batch: Optional[str] = None) -> list[Path]:
    """Collect .md files to check.

    Priority: explicit files > batch task file > all wiki cards
    """
    if files:
        result = []
        for pattern in files:
            if "*" in pattern or "?" in pattern:
                result.extend(root.rglob(pattern))
            else:
                p = root / pattern
                if p.exists():
                    result.append(p)
        return [f for f in result if f.suffix == ".md"]

    if batch:
        task_dir = root / "70_product/tasks"
        for tf in task_dir.glob(f"*{batch}*.md"):
            return _files_from_task(root, tf)
        return []

    wiki = root / "30_wiki"
    if wiki.exists():
        return [p for p in wiki.rglob("*.md")
                if _is_card(p) and "decisions" not in p.parts]

    return []


