"""Workspace primitives for Knowledge Delivery OS."""

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import sqlite3
import time
import uuid
import weakref
from contextlib import contextmanager
from copy import deepcopy
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

# Weak set of live SQLiteState instances; used by tests to force-close
# connections on Windows where open files block temp directory cleanup.
_LIVE_SQLITE_STATES: weakref.WeakSet = weakref.WeakSet()

from .templates import INITIAL_FILES, INITIAL_STATE, REQUIRED_DIRS

WORKSPACE_MARKER = "90_control/routing-rules.md"
STATE_PATH = ".kdo/state.json"
SQLITE_PATH = ".kdo/state.sqlite"
LOCK_PATH = ".kdo/state.sqlite.lock"
SQLITE_BUSY_TIMEOUT = 5000  # ms — multi-process safety
MVP_COLLECTIONS = {"sources"}  # only migrate sources in MVP

IS_WINDOWS = os.name == "nt"
if IS_WINDOWS:
    import msvcrt
else:
    import fcntl


@dataclass
class LintIssue:
    severity: str
    path: str
    message: str


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def today_compact() -> str:
    return datetime.now().strftime("%Y%m%d")


def generate_id(prefix: str) -> str:
    return f"{prefix}_{today_compact()}_{uuid.uuid4().hex[:8]}"


def slugify(value: str, fallback: str = "item") -> str:
    value = value.strip().lower()
    value = re.sub(r"[\s/\\:]+", "-", value)
    value = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff._-]+", "", value)
    value = re.sub(r"-+", "-", value).strip("-._")
    return value or fallback


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def text_sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def write_text_if_missing(path: Path, content: str, force: bool = False) -> bool:
    ensure_dir(path.parent)
    if path.exists() and not force:
        return False
    path.write_text(content, encoding="utf-8")
    return True


def append_text(path: Path, content: str) -> None:
    ensure_dir(path.parent)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(content)


_BUILTIN_SKILL_PATHS = {
    "kdo_builtin_knowledge_curator_v1": "40_outputs/capabilities/skills/knowledge-curator/SKILL.md",
    "kdo_builtin_delivery_producer_v1": "40_outputs/capabilities/skills/delivery-producer/SKILL.md",
    "kdo_builtin_system_linter_v1": "40_outputs/capabilities/skills/system-linter/SKILL.md",
}


def _register_builtin_artifacts(root: Path) -> None:
    """Register built-in capability skills as artifacts if not already present."""
    state_file = root / STATE_PATH
    if not state_file.exists():
        return
    try:
        state = json.loads(state_file.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return

    existing_ids = {a.get("artifact_id") for a in state.get("artifacts", [])}
    ts = now_iso()
    changed = False

    for artifact_id, rel_path in _BUILTIN_SKILL_PATHS.items():
        if artifact_id in existing_ids:
            continue
        skill_file = root / rel_path
        if not skill_file.exists():
            continue

        raw = skill_file.read_text(encoding="utf-8")
        raw = raw.replace("__INIT_TS__", ts)
        raw = raw.replace("__ARTIFACT_ID__", artifact_id)
        skill_file.write_text(raw, encoding="utf-8")

        fm, _ = parse_frontmatter(raw)
        title = fm.get("title", artifact_id)

        record = {
            "artifact_id": artifact_id,
            "type": "capability",
            "subtype": "skill",
            "title": title,
            "target_user": fm.get("target_user", "AI agent or human"),
            "source_refs": [],
            "wiki_refs": [],
            "definition_of_done": ["task boundary explicit", "inputs and outputs explicit", "tool permissions declared", "eval cases present", "feedback path declared"],
            "status": "ready",
            "delivery_channel": "local",
            "feedback_source": "60_feedback/",
            "path": rel_path,
            "origin": "builtin",
            "created_at": ts,
        }
        state.setdefault("artifacts", []).append(record)
        changed = True

    if changed:
        state_file.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def init_workspace(root: Path, force: bool = False) -> list[str]:
    root = root.resolve()
    created: list[str] = []
    ensure_dir(root)
    for rel in REQUIRED_DIRS:
        directory = root / rel
        if not directory.exists():
            directory.mkdir(parents=True, exist_ok=True)
            created.append(rel + "/")
    for rel, content in INITIAL_FILES.items():
        if write_text_if_missing(root / rel, content, force=force):
            created.append(rel)
    state_file = root / STATE_PATH
    if write_text_if_missing(state_file, json.dumps(INITIAL_STATE, indent=2, ensure_ascii=False) + "\n", force=force):
        created.append(STATE_PATH)
    _register_builtin_artifacts(root)
    return created


def find_workspace(start: Path | None = None) -> Path:
    current = (start or Path.cwd()).resolve()
    candidates = [current, *current.parents]
    for candidate in candidates:
        if (candidate / WORKSPACE_MARKER).exists():
            return candidate
    raise FileNotFoundError(
        "No KDO workspace found. Run `kdo init` first or execute the command inside a workspace."
    )


# ---------------------------------------------------------------------------
# SQLite-backed state (MVP: sources collection only)
# ---------------------------------------------------------------------------

SQL_SCHEMA = """
CREATE TABLE IF NOT EXISTS kdo_meta (
    key TEXT PRIMARY KEY,
    value_json TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS kdo_records (
    collection TEXT NOT NULL,
    record_id TEXT NOT NULL,
    data_json TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (collection, record_id)
);

CREATE INDEX IF NOT EXISTS idx_records_collection ON kdo_records(collection);
CREATE INDEX IF NOT EXISTS idx_records_id ON kdo_records(record_id);

CREATE TABLE IF NOT EXISTS kdo_strings (
    collection TEXT NOT NULL,
    value TEXT NOT NULL,
    inserted_at TEXT NOT NULL,
    PRIMARY KEY (collection, value)
);
"""


def _file_lock(root: Path) -> Any:
    """Acquire a cross-platform process-level lock file for multi-process safety.

    On Unix: fcntl.flock (advisory, process-scoped).
    On Windows: msvcrt.locking (mandatory byte-range lock).
    """
    lock_file = root / LOCK_PATH
    ensure_dir(lock_file.parent)
    fd = os.open(str(lock_file), os.O_CREAT | os.O_RDWR)

    if IS_WINDOWS:
        # msvcrt.locking blocks until lock is acquired (or timeout)
        deadline = time.time() + 10.0
        while time.time() < deadline:
            try:
                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                return fd
            except OSError:
                time.sleep(0.1)
        os.close(fd)
        raise TimeoutError("Could not acquire state.sqlite lock after 10s")
    else:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (BlockingIOError, OSError):
            deadline = time.time() + 10.0
            while time.time() < deadline:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (BlockingIOError, OSError):
                    time.sleep(0.1)
            else:
                os.close(fd)
                raise TimeoutError("Could not acquire state.sqlite lock after 10s")
        return fd


def _file_unlock(fd: int) -> None:
    """Release the process-level lock."""
    if IS_WINDOWS:
        try:
            msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
        except OSError:
            pass  # already unlocked
    else:
        fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)


@contextmanager
def _process_lock(root: Path):
    """Acquire the cross-platform process-level lock for the duration of the block."""
    fd = _file_lock(root)
    try:
        yield
    finally:
        _file_unlock(fd)


def _process_lock_for_db(db_path: Path):
    """Return a process-lock context manager for a SQLite DB at *db_path*.

    The workspace root is inferred as the parent of the `.kdo/` directory.
    """
    root = db_path.parent.parent
    return _process_lock(root)


class SQLiteCollection:
    """List-like facade backed by a SQLite collection of records.

    Supports iteration, len(), append(), and by_id() lookup.
    Write operations are immediate (INSERT/UPDATE) and auto-commit unless
    the owning ``SQLiteState`` is inside an explicit ``transaction()`` block.
    """

    def __init__(self, state: "SQLiteState", collection: str):
        self._state = state
        self._db = state._db
        self._collection = collection

    def __iter__(self):
        rows = self._db.execute(
            "SELECT data_json FROM kdo_records WHERE collection = ? ORDER BY record_id",
            (self._collection,),
        )
        for (data_json,) in rows:
            yield json.loads(data_json)

    def __len__(self):
        row = self._db.execute(
            "SELECT COUNT(*) FROM kdo_records WHERE collection = ?",
            (self._collection,),
        ).fetchone()
        return row[0] if row else 0

    def __bool__(self):
        return len(self) > 0

    def _record_key_and_json(self, record: dict) -> tuple[str, str]:
        record_id = (
            record.get("id")
            or record.get("artifact_id")
            or record.get("feedback_id")
            or str(uuid.uuid4())
        )
        return record_id, json.dumps(record, ensure_ascii=False)

    def _maybe_commit(self) -> None:
        """Commit the current transaction unless an explicit transaction is active."""
        if not self._state._in_transaction:
            self._db.commit()

    def append(self, record: dict) -> None:
        record_id, data_json = self._record_key_and_json(record)
        self._db.execute(
            "INSERT OR REPLACE INTO kdo_records (collection, record_id, data_json, updated_at) VALUES (?, ?, ?, ?)",
            (self._collection, record_id, data_json, now_iso()),
        )
        self._maybe_commit()

    def extend(self, records: list[dict]) -> None:
        for record in records:
            record_id, data_json = self._record_key_and_json(record)
            self._db.execute(
                "INSERT OR REPLACE INTO kdo_records (collection, record_id, data_json, updated_at) VALUES (?, ?, ?, ?)",
                (self._collection, record_id, data_json, now_iso()),
            )
        self._maybe_commit()

    def by_id(self, record_id: str) -> dict | None:
        row = self._db.execute(
            "SELECT data_json FROM kdo_records WHERE collection = ? AND record_id = ?",
            (self._collection, record_id),
        ).fetchone()
        return json.loads(row[0]) if row else None

    def remove(self, record_id: str) -> bool:
        cur = self._db.execute(
            "DELETE FROM kdo_records WHERE collection = ? AND record_id = ?",
            (self._collection, record_id),
        )
        self._maybe_commit()
        return cur.rowcount > 0

    def replace_all(self, records: list[dict]) -> None:
        """Atomic replace of entire collection."""
        self._db.execute("DELETE FROM kdo_records WHERE collection = ?", (self._collection,))
        for record in records:
            record_id, data_json = self._record_key_and_json(record)
            self._db.execute(
                "INSERT OR REPLACE INTO kdo_records (collection, record_id, data_json, updated_at) VALUES (?, ?, ?, ?)",
                (self._collection, record_id, data_json, now_iso()),
            )
        self._maybe_commit()

    def as_list(self) -> list[dict]:
        return list(self)


class SQLiteState:
    """Dict-like facade backed by SQLite.

    Behaves like the old `dict[str, Any]` state but loads collections
    on-demand from SQLite. For MVP, only `sources` uses SQLite; other
    collections fall back to in-memory dicts loaded from JSON.
    """

    def __init__(self, db_path: Path, legacy_data: dict[str, Any] | None = None):
        # NOTE: check_same_thread=False is required because connections may be
        # finalized (closed) from a different thread than they were created in
        # (e.g. the dashboard server handles requests in worker threads). Each
        # SQLiteState instance is still used by only one thread at a time; WAL +
        # busy_timeout handle concurrent access across processes.
        self._db = sqlite3.connect(str(db_path), check_same_thread=False)
        self._db.execute("PRAGMA journal_mode=WAL")
        self._db.execute(f"PRAGMA busy_timeout={SQLITE_BUSY_TIMEOUT}")
        self._db.executescript(SQL_SCHEMA)
        self._db_path = db_path
        self._collections: dict[str, SQLiteCollection | list] = {}
        self._scalars: dict[str, Any] = {}
        self._in_transaction = False
        self._finalizer = weakref.finalize(self, self._close_db, self._db)
        _LIVE_SQLITE_STATES.add(self)

        legacy = legacy_data or {}
        # Scalar values from legacy
        for key in ("version", "artifacts_count"):
            if key in legacy:
                self._scalars[key] = legacy[key]

        # MVP: sources lives in SQLite. Always expose a SQLiteCollection for it;
        # if legacy data is provided, migrate the records in.
        for coll_name in MVP_COLLECTIONS:
            coll = SQLiteCollection(self, coll_name)
            if coll_name in legacy and isinstance(legacy[coll_name], list):
                coll.replace_all(legacy[coll_name])
            self._collections[coll_name] = coll

        # All other collections stay as in-memory lists
        for key, value in legacy.items():
            if key in ("version", "artifacts_count"):
                continue
            if key not in self._collections:
                self._collections[key] = deepcopy(value) if isinstance(value, list) else value

    def get(self, key: str, default=None):
        if key in self._scalars:
            return self._scalars[key]
        if key in self._collections:
            return self._collections[key]
        return default

    def __getitem__(self, key: str):
        if key in self._scalars:
            return self._scalars[key]
        if key in self._collections:
            return self._collections[key]
        raise KeyError(key)

    def __setitem__(self, key: str, value):
        if key in ("version", "artifacts_count"):
            self._scalars[key] = value
        elif key in MVP_COLLECTIONS and isinstance(value, list):
            coll = SQLiteCollection(self, key)
            coll.replace_all(value)
            self._collections[key] = coll
        else:
            self._collections[key] = value

    def __contains__(self, key: str) -> bool:
        return key in self._scalars or key in self._collections

    def keys(self):
        return set(self._scalars.keys()) | set(self._collections.keys())

    def items(self):
        for k in self.keys():
            yield k, self[k]

    def setdefault(self, key: str, default=None):
        """dict-compatible setdefault — returns existing value or sets default."""
        if key in self._scalars:
            return self._scalars[key]
        if key in self._collections:
            return self._collections[key]
        self[key] = default
        return default

    def __len__(self):
        return len(self.keys())

    @staticmethod
    def _close_db(db: sqlite3.Connection) -> None:
        """Close a SQLite connection; safe to call multiple times."""
        try:
            if db.in_transaction:
                db.commit()
        except Exception:
            pass
        try:
            db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        except Exception:
            pass
        try:
            db.close()
        except Exception:
            pass

    def commit(self):
        """Commit any pending transaction and checkpoint the WAL.

        Safe to call on an already-closed connection.
        """
        try:
            if self._db.in_transaction:
                self._db.commit()
        except sqlite3.ProgrammingError:
            pass  # connection already closed
        try:
            self._db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        except sqlite3.ProgrammingError:
            pass  # connection already closed

    def close(self):
        self._finalizer.detach()
        self._close_db(self._db)

    def __del__(self):
        pass  # finalizer handles cleanup

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        self.close()
        return False

    @contextmanager
    def transaction(self):
        """Explicit transaction context for batch writes.

        Writes inside the block are held in a single SQLite transaction and
        committed on success, or rolled back on exception. The block should
        contain at least one write so that a transaction is active.
        """
        self._in_transaction = True
        try:
            yield self
            if self._db.in_transaction:
                self._db.commit()
        except Exception:
            if self._db.in_transaction:
                self._db.execute("ROLLBACK")
            raise
        finally:
            self._in_transaction = False

    def migrate_from_json(self, json_path: Path) -> int:
        """Migrate sources from JSON into SQLite. Returns count migrated."""
        data = json.loads(json_path.read_text(encoding="utf-8"))
        sources = data.get("sources", [])
        if sources:
            coll = SQLiteCollection(self, "sources")
            coll.replace_all(sources)
            self._collections["sources"] = coll
        return len(sources)


def load_state(root: Path) -> dict[str, Any] | SQLiteState:
    """Load workspace state, preferring SQLite if available.

    Auto-migration: if state.sqlite does not exist but state.json does,
    migrate sources into SQLite, rename JSON to .migrated, and return SQLiteState.
    """
    sqlite_file = root / SQLITE_PATH
    state_file = root / STATE_PATH

    # Already migrated — use SQLite
    if sqlite_file.exists():
        state = SQLiteState(sqlite_file)
        # Load non-MVP collections from the active legacy JSON (state.json if still
        # being written, otherwise the .migrated backup).
        migrated_path = root / (STATE_PATH + ".migrated")
        active_path = root / STATE_PATH
        legacy_path = active_path if active_path.exists() else migrated_path
        if legacy_path.exists():
            legacy = json.loads(legacy_path.read_text(encoding="utf-8"))
            for key, value in legacy.items():
                if key not in state:
                    state[key] = value
        return state

    # Legacy path — load JSON
    if not state_file.exists():
        state = deepcopy(INITIAL_STATE)
        _legacy_save_state_json(root, state)
        return state

    state_data = json.loads(state_file.read_text(encoding="utf-8"))
    for key, value in INITIAL_STATE.items():
        state_data.setdefault(key, deepcopy(value))

    # Auto-migrate: create SQLite, migrate sources, rename JSON
    lock_fd = _file_lock(root)
    try:
        state = SQLiteState(sqlite_file, state_data)
        migrated = state.migrate_from_json(state_file)
        # Rename legacy JSON
        migrated_path = root / (STATE_PATH + ".migrated")
        shutil.move(str(state_file), str(migrated_path))
    finally:
        _file_unlock(lock_fd)

    return state


def _legacy_save_state_json(root: Path, state: dict[str, Any]) -> None:
    """Write state as JSON (legacy path, used for non-MVP collections)."""
    state_file = root / STATE_PATH
    ensure_dir(state_file.parent)

    # If state is a SQLiteState, extract non-SQLite collections
    if isinstance(state, SQLiteState):
        out = {"version": state.get("version", 1)}
        for key in state.keys():
            if key in ("version", "artifacts_count"):
                out[key] = state[key]
                continue
            if key in MVP_COLLECTIONS:
                continue  # SQLite-managed, not in JSON
            val = state[key]
            if isinstance(val, SQLiteCollection):
                out[key] = val.as_list()
            else:
                out[key] = val
        state_file.write_text(json.dumps(out, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    else:
        state_file.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def save_state(root: Path, state: dict[str, Any] | SQLiteState) -> None:
    """Save workspace state.  For SQLiteState this also closes the connection
    to release the file handle (important on Windows where temp-dir cleanup
    fails if the .sqlite file is still held open).

    - SQLiteState: commits WAL, saves legacy JSON, then closes the connection.
    - Plain dict: legacy JSON path (unchanged behavior).
    """
    if isinstance(state, SQLiteState):
        state.commit()
        _legacy_save_state_json(root, state)
        state.close()  # release file handle for Windows temp-dir cleanup
    else:
        _legacy_save_state_json(root, state)


def relpath(root: Path, path: Path) -> str:
    return path.resolve().relative_to(root.resolve()).as_posix()


def yaml_scalar(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, (list, dict)):
        try:
            import yaml
            return yaml.dump(value, default_flow_style=None, allow_unicode=True).strip() or "{}"
        except ImportError:
            return json.dumps(value, ensure_ascii=False) if isinstance(value, list) else "{}"
    return json.dumps(str(value), ensure_ascii=False)


def append_yaml_record(path: Path, collection_key: str, record: dict[str, Any]) -> None:
    ensure_dir(path.parent)
    if not path.exists():
        path.write_text(f"# {collection_key.title()} Registry\n\n{collection_key}:\n", encoding="utf-8")
    else:
        existing = path.read_text(encoding="utf-8")
        if f"{collection_key}: []" in existing:
            path.write_text(existing.replace(f"{collection_key}: []", f"{collection_key}:"), encoding="utf-8")
    first_key = "artifact_id" if "artifact_id" in record else "id"
    lines = ["", f"- {first_key}: {yaml_scalar(record.get(first_key))}"]
    for key, value in record.items():
        if key == first_key:
            continue
        lines.append(f"  {key}: {yaml_scalar(value)}")
    append_text(path, "\n".join(lines) + "\n")


def render_frontmatter(metadata: dict[str, Any]) -> str:
    lines = ["---"]
    for key, value in metadata.items():
        lines.append(f"{key}: {yaml_scalar(value)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def parse_frontmatter(text: str) -> tuple[dict[str, Any], str]:
    text = text.replace('\r\n', '\n')
    if text.startswith('﻿'):
        text = text[1:]
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}, text
    raw_fm = text[4:end]
    body = text[end + 5:]

    try:
        import yaml
        metadata = yaml.safe_load(raw_fm)
        if not isinstance(metadata, dict):
            return {}, body
        for k, v in list(metadata.items()):
            if v is None:
                metadata[k] = ""
        return metadata, body
    except ImportError:
        pass  # fallback to line-by-line
    except yaml.YAMLError:
        return {}, body

    # Fallback: line-by-line parser for environments without PyYAML
    lines = raw_fm.strip().splitlines()
    metadata: dict[str, Any] = {}
    for line in lines:
        if ":" not in line:
            continue
        key, raw_val = line.split(":", 1)
        key = key.strip()
        val = raw_val.strip()
        if (val and val[0] in ('[', '{', '"')) or val in ("true", "false", "null"):
            try:
                metadata[key] = json.loads(val)
                continue
            except json.JSONDecodeError:
                pass
        try:
            metadata[key] = int(val)
            continue
        except ValueError:
            pass
        try:
            metadata[key] = float(val)
            continue
        except ValueError:
            pass
        metadata[key] = val.strip('"')
    return metadata, body


def write_markdown(path: Path, metadata: dict[str, Any], body: str) -> None:
    write_text_if_missing(path, render_frontmatter(metadata) + "\n" + body.rstrip() + "\n", force=True)


def append_wiki_log(root: Path, message: str) -> None:
    append_text(root / "30_wiki/log.md", f"\n- {now_iso()} - {message}\n")


def append_wiki_index(root: Path, title: str, path: Path, source_id: str) -> None:
    append_text(
        root / "30_wiki/index.md",
        f"\n- [{title}]({relpath(root / '30_wiki', path)}) - source `{source_id}`\n",
    )


def safe_read(path: Path, limit: int | None = None) -> str:
    text = path.read_text(encoding="utf-8", errors="replace")
    if limit is not None and len(text) > limit:
        return text[:limit]
    return text


def first_non_empty_line(text: str, fallback: str) -> str:
    for line in text.splitlines():
        clean = line.strip(" #\t")
        if clean:
            return clean[:96]
    return fallback


def make_excerpt(text: str, max_chars: int = 900) -> str:
    compact = re.sub(r"\n{3,}", "\n\n", text.strip())
    if len(compact) <= max_chars:
        return compact
    return compact[:max_chars].rstrip() + "..."


def copy_into_raw(root: Path, source_id: str, title: str, text: str) -> Path:
    filename = f"{source_id}-{slugify(title)}.md"
    path = root / "10_raw/sources" / filename
    metadata = {
        "source_id": source_id,
        "title": title,
        "captured_at": now_iso(),
        "kind": "raw-source",
    }
    body = f"# {title}\n\n{text.strip()}\n"
    write_markdown(path, metadata, body)
    return path


def copy_file_into_raw(root: Path, source_id: str, source_path: Path) -> Path:
    target_name = f"{source_id}-{slugify(source_path.stem)}{source_path.suffix}"
    target = root / "10_raw/assets" / target_name
    ensure_dir(target.parent)
    shutil.copy2(source_path, target)
    return target


_WIKI_SYSTEM_FILES = {"index.md", "log.md", "contradictions.md"}
_WIKI_SYSTEM_DIRS = {"decisions"}
INTERNAL_LINK_RE = re.compile(r"\[\[([^\]]+)\]\]")


def _is_searchable(root: Path, path: Path) -> bool:
    """Return False for wiki system files that pollute wiki_refs."""
    try:
        rel = path.resolve().relative_to((root / "30_wiki").resolve())
    except ValueError:
        return True
    if rel.name in _WIKI_SYSTEM_FILES:
        return False
    if rel.parts and rel.parts[0] in _WIKI_SYSTEM_DIRS:
        return False
    return True


def search_documents(root: Path, query: str, max_results: int = 8) -> list[tuple[int, Path, str]]:
    terms = [term.lower() for term in re.findall(r"[\w\u4e00-\u9fff]+", query) if term.strip()]
    if not terms:
        return []
    search_roots = ["20_memory", "30_wiki", "40_outputs", "10_raw/sources"]
    results: list[tuple[int, Path, str]] = []
    for rel in search_roots:
        base = root / rel
        if not base.exists():
            continue
        for path in base.rglob("*.md"):
            if not _is_searchable(root, path):
                continue
            text = safe_read(path, limit=200_000)
            lowered = text.lower()
            score = sum(lowered.count(term) for term in terms)
            if score <= 0:
                continue
            # Boost memory matches: cross-session continuity should surface first
            if rel == "20_memory":
                score *= 5
            snippet = extract_snippet(text, terms)
            results.append((score, path, snippet))
    results.sort(key=lambda item: (-item[0], item[1].as_posix()))
    return results[:max_results]


def extract_snippet(text: str, terms: list[str], width: int = 240) -> str:
    lowered = text.lower()
    positions = [lowered.find(term) for term in terms if lowered.find(term) >= 0]
    if not positions:
        return make_excerpt(text, width)
    start = max(0, min(positions) - width // 3)
    snippet = text[start : start + width]
    return re.sub(r"\s+", " ", snippet).strip()


def collect_status(root: Path) -> dict[str, Any]:
    state = load_state(root)
    try:
        counts: dict[str, Any] = {
            "sources": len(state.get("sources", [])),
            "artifacts": len(state.get("artifacts", [])),
            "deliveries": len(state.get("deliveries", [])),
            "feedback_records": len(state.get("feedback", [])),
            "projects": len(state.get("projects", [])),
            "tasks": len(state.get("tasks", [])),
            "connectors": len(state.get("connectors", [])),
            "improvement_plans": len(state.get("improvement_plans", [])),
            "briefs": len(state.get("briefs", [])),
            "eval_runs": len(state.get("eval_runs", [])),
            "inbox_files": count_files(root / "00_inbox"),
            "raw_files": count_files(root / "10_raw"),
            "wiki_pages": count_files(root / "30_wiki", suffix=".md"),
            "content_outputs": count_files(root / "40_outputs/content"),
            "code_outputs": count_files(root / "40_outputs/code"),
            "capability_outputs": count_files(root / "40_outputs/capabilities"),
            "feedback_items": count_files(root / "60_feedback"),
            "product_files": count_files(root / "70_product"),
        }
        return counts
    finally:
        if isinstance(state, SQLiteState):
            state.close()


def count_files(path: Path, suffix: str | None = None) -> int:
    if not path.exists():
        return 0
    total = 0
    for item in path.rglob("*"):
        if item.is_file() and (suffix is None or item.suffix == suffix):
            total += 1
    return total


def _body_has_source_section(text: str) -> bool:
    """#496：正文「来源与口径」段判定——含文件引用（.txt/.md/.pdf）或行号引用（:N-M）
    视为有来源（framework-一堂-关键假设 实证：字段空但正文来源段详实）。"""
    import re as _re
    m = _re.search(r"##\s*来源与口径\s*\n(.*?)(?=\n##\s|\Z)", text, _re.S)
    if not m:
        return False
    body = m.group(1)
    return bool(_re.search(r"`[^`]*(?:\.txt|\.md|\.pdf)`|:\d+(-\d+)?", body))


def lint_workspace(root: Path) -> list[LintIssue]:
    issues: list[LintIssue] = []
    for rel in REQUIRED_DIRS:
        if not (root / rel).is_dir():
            issues.append(LintIssue("error", rel, "Required directory is missing."))
    for rel in INITIAL_FILES:
        if not (root / rel).exists():
            issues.append(LintIssue("error", rel, "Required control/template file is missing."))

    try:
        state = load_state(root)
    except (OSError, ValueError) as exc:
        return [LintIssue("error", STATE_PATH, str(exc))]

    source_ids = set()
    for source in state.get("sources", []):
        source_id = source.get("id")
        if not source_id:
            issues.append(LintIssue("error", STATE_PATH, "Source record without id."))
            continue
        if source_id in source_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Duplicate source id `{source_id}`."))
        source_ids.add(source_id)
        location = source.get("location")
        if location and not str(location).startswith(("http://", "https://")):
            if not (root / location).exists():
                issues.append(LintIssue("warning", location, f"Source `{source_id}` location does not exist."))

    artifact_ids = set()
    for artifact in state.get("artifacts", []):
        artifact_id = artifact.get("artifact_id")
        if not artifact_id:
            issues.append(LintIssue("error", STATE_PATH, "Artifact record without artifact_id."))
            continue
        if artifact_id in artifact_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Duplicate artifact id `{artifact_id}`."))
        artifact_ids.add(artifact_id)
        artifact_path = artifact.get("path")
        if artifact_path and not (root / artifact_path).exists():
            issues.append(LintIssue("error", artifact_path, f"Artifact `{artifact_id}` path does not exist."))

    project_ids = set()
    for project in state.get("projects", []):
        project_id = project.get("project_id")
        if not project_id:
            issues.append(LintIssue("error", STATE_PATH, "Project record without project_id."))
            continue
        if project_id in project_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Duplicate project id `{project_id}`."))
        project_ids.add(project_id)
        project_path = project.get("path")
        if project_path and not (root / project_path).exists():
            issues.append(LintIssue("error", project_path, f"Project `{project_id}` path does not exist."))

    task_ids = set()
    for task in state.get("tasks", []):
        task_id = task.get("task_id")
        if not task_id:
            issues.append(LintIssue("error", STATE_PATH, "Task record without task_id."))
            continue
        if task_id in task_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Duplicate task id `{task_id}`."))
        task_ids.add(task_id)
        task_path = task.get("path")
        if task_path and not (root / task_path).exists():
            issues.append(LintIssue("error", task_path, f"Task `{task_id}` path does not exist."))
        project_id = task.get("project_id")
        if project_id and project_id not in project_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Task `{task_id}` references unknown project `{project_id}`."))
        artifact_id = task.get("artifact_id")
        if artifact_id and artifact_id not in artifact_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Task `{task_id}` references unknown artifact `{artifact_id}`."))

    connector_ids = set()
    for connector in state.get("connectors", []):
        connector_id = connector.get("connector_id")
        if not connector_id:
            issues.append(LintIssue("error", STATE_PATH, "Connector record without connector_id."))
            continue
        if connector_id in connector_ids:
            issues.append(LintIssue("error", STATE_PATH, f"Duplicate connector id `{connector_id}`."))
        connector_ids.add(connector_id)
        connector_path = connector.get("path")
        if connector_path and not (root / connector_path).exists():
            issues.append(LintIssue("error", connector_path, f"Connector `{connector_id}` path does not exist."))

    for delivery in state.get("deliveries", []):
        delivery_id = delivery.get("delivery_id", "unknown")
        delivery_path = delivery.get("path")
        if delivery_path and not (root / delivery_path).exists():
            issues.append(LintIssue("error", delivery_path, f"Delivery `{delivery_id}` path does not exist."))

    for feedback in state.get("feedback", []):
        feedback_id = feedback.get("feedback_id", "unknown")
        feedback_path = feedback.get("path")
        if feedback_path and not (root / feedback_path).exists():
            issues.append(LintIssue("error", feedback_path, f"Feedback `{feedback_id}` path does not exist."))

    for brief in state.get("briefs", []):
        brief_id = brief.get("brief_id", "unknown")
        brief_path = brief.get("path")
        if brief_path and not (root / brief_path).exists():
            issues.append(LintIssue("error", brief_path, f"Brief `{brief_id}` path does not exist."))

    for eval_run in state.get("eval_runs", []):
        eval_id = eval_run.get("eval_id", "unknown")
        eval_path = eval_run.get("path")
        if eval_path and not (root / eval_path).exists():
            issues.append(LintIssue("error", eval_path, f"Eval `{eval_id}` path does not exist."))

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    _CONTENT_TYPES = {"concept", "skill", "tool", "case", "dark-knowledge"}
    for page in (root / "30_wiki").rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        if "source_refs:" not in text and "Source refs" not in text and "source `" not in text:
            issues.append(LintIssue("warning", relpath(root, page), "Wiki page has no visible source references."))
        # Hard gate for content cards: source_refs must be a non-empty list
        card_type = fm.get("type", "")
        if card_type in _CONTENT_TYPES:
            refs = fm.get("source_refs")
            if refs is None or refs == "" or refs == [] or (isinstance(refs, list) and len(refs) == 0):
                # #496：字段空 ≠ 来源无——先查正文「来源与口径」段（行号引用/文件引用），
                # 有则降级 warning（建议迁移 frontmatter），两处皆空才是真无来源才 FAIL
                if _body_has_source_section(text):
                    issues.append(LintIssue("warning", relpath(root, page),
                        f"{card_type} card has empty source_refs but body has 「来源与口径」— "
                        f"建议迁移到 frontmatter（#496，不再机械 FAIL）"))
                else:
                    issues.append(LintIssue("error", relpath(root, page),
                        f"{card_type} card has empty source_refs — required for traceability. "
                        f"Must reference at least one source file."))



    # --- Lint: broken wikilinks, orphans, index completeness ---
    _lint_wiki_links(root, issues)
    _lint_wiki_orphans(root, issues)
    _lint_wiki_index_completeness(root, issues)

    # --- Lint: source_refs existence + status consistency ---
    _lint_source_refs_exist(root, state, issues)
    _lint_status_consistency(root, issues)
    _lint_status_review_fields(root, issues)          # R1-a: reviewed 缺 reviewed_by/review_date → ERROR
    _lint_duplicate_section_names(root, issues)       # R1-b: 重复节名 → ERROR
    _lint_source_refs_location(root, issues)          # R1-c: source_refs 指向桌面/仓库外 → WARNING
    _lint_source_refs_line_range(root, issues)        # R1-d: 行号超源文件总行数 → WARNING

    # --- L2: content quality ---
    _lint_l2_content_quality(root, issues)

    # --- L3: tag schema validation ---
    _lint_tags(root, issues)

    # --- I-3: artifact orphan detection ---
    _lint_artifact_orphans(root, state, issues)

    # --- I-6: OCR mandatory check ---
    _lint_ocr_missing(root, issues)

    # --- I-2: synthesis dead link detection ---
    _lint_synthesis_dead_links(root, issues)

    # --- I-4: dark knowledge card structure ---
    _lint_dark_knowledge_structure(root, issues)

    # --- I-1: tool card quality gate ---
    _lint_tool_card_quality(root, issues)

    # --- case card structure validation ---
    _lint_case_card_structure(root, issues)

    # --- depth: cross-card similarity ---
    _lint_depth_cross_card_similarity(root, issues)

    # --- depth: core concept elements missing ---
    _lint_depth_missing_elements(root, issues)

    # --- I-5: source_refs fuzzy match ---
    _lint_source_refs_fuzzy(root, issues)

    # --- J: stale artifact detection (card updated but artifact not rebuilt) ---
    _lint_stale_artifacts(root, issues)

    # --- domain-tags consistency check ---
    _lint_domain_tags_consistency(root, issues)

    # --- source_refs material detection (P1-1) ---
    _lint_source_refs_material(root, issues)

    # --- dashboard freshness check ---
    _lint_dashboard_freshness(root, issues)

    if isinstance(state, SQLiteState):
        state.close()
    return issues


def _lint_tags(root: Path, issues: list[LintIssue]) -> None:
    """Validate tags on all wiki cards against 90_control/tag-schema.yaml."""
    schema_path = root / "90_control" / "tag-schema.yaml"
    if not schema_path.exists():
        return

    try:
        import yaml
        with open(schema_path, encoding='utf-8') as f:
            schema = yaml.safe_load(f)
        prefixes = schema.get("prefixes", {})
    except Exception:
        return

    wiki_dir = root / "30_wiki" / "concepts"
    if not wiki_dir.is_dir():
        return

    for md_file in wiki_dir.glob("*.md"):
        try:
            text = safe_read(md_file, limit=50_000)
            fm, _ = parse_frontmatter(text)
            tags = fm.get("tags") or []
            if not isinstance(tags, list):
                continue
            for tag in tags:
                if not isinstance(tag, str):
                    continue
                if not tag.startswith("#"):
                    continue  # plain-text tags, not schema-validated
                matched = False
                for prefix, rules in prefixes.items():
                    if tag.startswith(prefix + "/") or tag == prefix:
                        matched = True
                        if rules.get("closed") and tag != prefix:
                            value = tag[len(prefix)+1:]
                            known = rules.get("known", [])
                            if known and value not in known:
                                issues.append(LintIssue("warning", relpath(root, md_file),
                                    f"Unknown tag value '{tag}' in closed prefix '{prefix}/'"))
                        break
                if not matched:
                    pass  # unknown prefix → not a warning, just not in schema yet
        except Exception:
            continue


def _lint_wiki_links(root: Path, issues: list[LintIssue]) -> None:
    """Detect broken ``[[wikilinks]]`` in wiki pages via Obsidian CLI or native fallback."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    unresolved: set[str] | None = None
    try:
        from .bridge import get_unresolved_links
        unresolved = set(get_unresolved_links())
    except Exception:
        pass  # Obsidian not available — use native fallback

    if unresolved is None:
        try:
            from .links import find_broken_links_vault
            unresolved = find_broken_links_vault(root)
        except Exception:
            return  # Neither bridge nor native available

    if not unresolved:
        return

    # Walk ALL markdown files in vault (not just 30_wiki) to catch broken links
    # in inbox, outputs, feedback, and control files too
    for md_path in root.rglob("*.md"):
        if ".trash" in md_path.parts or ".obsidian" in md_path.parts or ".git" in md_path.parts:
            continue
        if "links" in md_path.parts and md_path.name == "index.md":
            continue  # skip auto-generated backlinks index
        try:
            text = safe_read(md_path, limit=100_000)
        except OSError:
            continue
        for raw in INTERNAL_LINK_RE.findall(text):
            target = raw.split("|")[0].split("#")[0].strip()
            if target in unresolved:
                issues.append(LintIssue(
                    "warning", relpath(root, md_path),
                    f"Broken wikilink: [[{target}]] (no matching page found)",
                ))


def _lint_wiki_orphans(root: Path, issues: list[LintIssue]) -> None:
    """Flag wiki pages with zero incoming ``[[wikilinks]]``.

    Tries Obsidian bridge first; falls back to native filesystem scan that
    covers ALL files (including non-git-tracked ones).
    """
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    orphan_paths: set[str] | None = None
    try:
        from .bridge import get_orphans
        orphan_paths = set(get_orphans())
    except Exception:
        pass

    if orphan_paths is None:
        try:
            from .links import find_orphans_vault
            orphan_paths = find_orphans_vault(root)
        except Exception:
            return

    if not orphan_paths:
        return

    # Collect pages referenced from 30_wiki/index.md
    indexed: set[str] = set()
    index_path = wiki_root / "index.md"
    if index_path.exists():
        try:
            for line in index_path.read_text(encoding="utf-8").splitlines():
                m = re.search(r"\(([^)]+\.md)\)", line)
                if m:
                    indexed.add("30_wiki/" + m.group(1))
        except OSError:
            pass

    for orphan_path in orphan_paths:
        if not orphan_path.startswith("30_wiki/"):
            continue
        if orphan_path in indexed:
            continue
        # Exclude system files
        if any(part in orphan_path for part in ("links/", "decisions/")):
            continue
        if orphan_path.rsplit("/", 1)[-1] in _WIKI_SYSTEM_FILES:
            continue
        issues.append(LintIssue(
            "warning", orphan_path,
            "Orphan wiki page: no incoming [[wikilinks]] and not listed in index",
        ))


def _lint_wiki_index_completeness(root: Path, issues: list[LintIssue]) -> None:
    """Verify every wiki page appears in 30_wiki/index.md."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    all_pages: set[str] = set()
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        if "links" in page.parts:
            continue
        all_pages.add(relpath(root, page))

    indexed: set[str] = set()
    index_path = wiki_root / "index.md"
    if index_path.exists():
        try:
            for line in index_path.read_text(encoding="utf-8").splitlines():
                # Markdown links: [text](path/file.md)
                m = re.search(r"\(([^)]+\.md)\)", line)
                if m:
                    indexed.add("30_wiki/" + m.group(1))
                    continue
                # Wikilinks: [[path/to/file]] or [[path/to/file|alias]]
                m = re.search(r"\[\[([^\]]+?)(?:\|[^\]]+)?\]\]", line)
                if m:
                    target = m.group(1).strip()
                    if "/" in target:
                        # Cross-directory: entities/一堂 → 30_wiki/entities/一堂.md
                        indexed.add("30_wiki/" + target + ".md")
                    else:
                        # Bare wikilink: yt-model-y-organization → 30_wiki/concepts/yt-model-y-organization.md
                        indexed.add("30_wiki/concepts/" + target + ".md")
        except OSError:
            pass

    missing = all_pages - indexed
    _MISSING_INDEX_PAGES.clear()
    _MISSING_INDEX_PAGES.update(missing)
    for page_rel in sorted(missing):
        issues.append(LintIssue(
            "warning", page_rel,
            "Wiki page not listed in 30_wiki/index.md",
        ))


_MISSING_INDEX_PAGES: set[str] = set()


def sync_wiki_index(root: Path) -> int:
    """Auto-add missing wiki pages to 30_wiki/index.md."""
    wiki_root = root / "30_wiki"
    index_path = wiki_root / "index.md"
    if not index_path.exists():
        print("30_wiki/index.md not found.")
        return 1

    # Gather all pages and their metadata
    additions: list[tuple[str, str]] = []  # (rel_path, display_title)
    for page_rel in sorted(_MISSING_INDEX_PAGES):
        page = root / page_rel
        if not page.exists():
            continue
        try:
            text = safe_read(page, limit=5_000)
            fm, _ = parse_frontmatter(text)
        except OSError:
            continue

        title = fm.get("title", page.stem)
        source = fm.get("source_person", "") or ", ".join(fm.get("domain", []))
        if not source:
            refs = fm.get("source_refs", [])
            if isinstance(refs, list) and refs:
                source = refs[0].split("/")[-1].replace(".md", "").replace(".txt", "")[:40]

        # Strip leading 30_wiki/ to get the relative path within the wiki directory
        concept_path = page_rel[len("30_wiki/"):] if page_rel.startswith("30_wiki/") else page_rel
        concept_path = concept_path.replace(".md", "")
        additions.append((concept_path, title, source))

    if not additions:
        print("Index is up to date. No pages to add.")
        return 0

    # Append to index.md
    with index_path.open("a", encoding="utf-8") as f:
        for concept_path, title, source in additions:
            source_suffix = f" — {source}" if source else ""
            f.write(f"- [[{concept_path}|{title}]]{source_suffix}\n")

    print(f"Added {len(additions)} page(s) to index.md.")
    for _, title, _ in additions:
        print(f"  + {title}")
    return 0


def _lint_source_refs_exist(root: Path, state: dict[str, Any], issues: list[LintIssue]) -> None:
    """Verify each ``source_refs`` entry resolves to an existing file on disk."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    # Build lookup: source_id → location from state.json
    source_locations: dict[str, str] = {}
    for src in state.get("sources", []):
        sid = src.get("id", "")
        loc = src.get("location", "")
        if sid and loc:
            source_locations[sid] = loc

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        refs = fm.get("source_refs")
        if not isinstance(refs, list) or not refs:
            continue  # handled by the "no source_refs" warning above

        for ref in refs:
            if not isinstance(ref, str) or not ref.strip():
                continue
            ref = ref.strip()
            # Intentionally unresolved entries — skip existence check
            if ref.startswith("pending_archive:") or ref == "src_unknown":
                continue
            # URL references are not local files — skip existence check
            if ref.startswith(("http://", "https://")):
                continue
            # Strip non-path suffixes: line ranges (L1146-L1820), page markers (§38-39), etc.
            import re as _re
            ref_clean = _re.sub(r'\s*[\(（]\s*L?\d+[-–—]\s*L?\d+\s*[\)）]', '', ref)
            ref_clean = _re.sub(r'\s+L?\d+[-–—]L?\d+\s*$', '', ref_clean)
            ref_clean = _re.sub(r'\s*[§⸋]\s*\d+(-\d+)?\s*$', '', ref_clean)
            if ref_clean != ref and (root / ref_clean).exists():
                ref = ref_clean
            # Try state.json lookup first
            if ref in source_locations:
                loc = source_locations[ref]
                if not (root / loc).exists():
                    issues.append(LintIssue(
                        "error", relpath(root, page),
                        f"source_refs entry `{ref}` → `{loc}`: file not found on disk",
                    ))
                continue
            # Try as a direct file path
            if "/" in ref or ref.endswith(".md"):
                if not (root / ref).exists():
                    issues.append(LintIssue(
                        "error", relpath(root, page),
                        f"source_refs entry `{ref}`: file not found on disk",
                    ))
                continue
            # #567：散文型 source_ref（无斜杠、非 wikilink/src_id 形态）→ WARN 疑似非路径。
            # 此前散文型靠 `10_raw/sources/{ref}-*` 前缀 glob 撞库逃逸（撞上就静默放行）。
            if (not ref.startswith("[[")
                    and not _re.match(r"^src_\d{8}_[a-f0-9]{8}$", ref)):
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"source_refs entry `{ref}` 疑似非路径（散文型 source_ref——无斜杠/非 src_id/非 wikilink，"
                    "source_refs 应填可解析的文件路径或 src_id）",
                ))
                continue
            # Try glob match in 10_raw/sources/ (source ID → src_<id>-*.md)
            candidates = list((root / "10_raw/sources").glob(f"{ref}-*"))
            if candidates:
                continue  # file exists on disk even if not in state.json
            # Source ID not found in registry or on disk
            issues.append(LintIssue(
                "warning", relpath(root, page),
                f"source_refs entry `{ref}` not found in state.json source registry or on disk",
            ))


def _lint_status_consistency(root: Path, issues: list[LintIssue]) -> None:
    """Check frontmatter status is consistent with required companion fields."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    STATUS_REQUIRES: dict[str, list[str]] = {
        "reviewed": ["reviewed_by", "review_date"],
        "enriched": ["source_refs"],
    }

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        status = fm.get("status", "")
        if not status:
            continue
        required = STATUS_REQUIRES.get(status, [])
        for field in required:
            val = fm.get(field)
            if val is None or val == "" or val == []:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"status is `{status}` but `{field}` is missing or empty",
                ))


def _lint_status_review_fields(root: Path, issues: list[LintIssue]) -> None:
    """R1-a (#271): status=reviewed 但缺 reviewed_by 或 review_date → ERROR。

    E012 实证（#230/#231/#232 三批 19 张）：终审 PASS 后卡片仍停留 draft 状态，
    因为 reviewed 标记与审查记录分离。规则：reviewed 必须有审查者与日期。
    与 _lint_status_consistency 的区别：后者是 WARNING 且豁免部分类型，本规则 ERROR 全覆盖。
    """
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("status") != "reviewed":
            continue
        for field in ("reviewed_by", "review_date"):
            val = fm.get(field)
            if val is None or val == "" or val == []:
                issues.append(LintIssue(
                    "error", relpath(root, page),
                    f"status is `reviewed` but `{field}` is missing or empty — 终审标记不完整（R1-a）",
                ))


def _lint_duplicate_section_names(root: Path, issues: list[LintIssue]) -> None:
    """R1-b (#271): 同一卡片出现重复的二级节名 → ERROR。

    E009 实证（#214 case-cui-lei）：修复时误删原节后又补成第二个 Critique，
    重复节名使结构校验失真。仅检测 ## 级（正文节），### 与 frontmatter 不计。
    """
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=50_000)
        if text.startswith("---\n"):
            fm_end = text.find("\n---\n", 4)
            if fm_end != -1:
                text = text[fm_end + 5:]  # 剥离 frontmatter，避免误计 YAML 键
        seen: dict[str, int] = {}
        for line in text.splitlines():
            if line.startswith("## ") and not line.startswith("### "):
                name = line[3:].strip()
                name = name.strip("[]").strip()
                seen[name] = seen.get(name, 0) + 1
        for name, count in seen.items():
            if count > 1:
                issues.append(LintIssue(
                    "error", relpath(root, page),
                    f"duplicate section `## {name}` appears {count} times — 重复节名（R1-b）",
                ))


def _lint_source_refs_location(root: Path, issues: list[LintIssue]) -> None:
    """R1-c (#271): source_refs 指向仓库外（桌面等）→ WARNING。

    实证（08-07 复盘）：tool/agent-spec 卡指向桌面路径，git 无法追溯，
    仓库外路径在换机/克隆后全部断链。合法位置：00_inbox / 10_raw / 60_feedback / 30_wiki 内相对路径。
    """
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return
    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        refs = fm.get("source_refs")
        if not isinstance(refs, list):
            continue
        for ref in refs:
            if not isinstance(ref, str) or not ref.strip():
                continue
            ref = ref.strip()
            if ref.startswith(("http://", "https://")) or ref.startswith("pending_archive:") or ref == "src_unknown":
                continue
            # Windows/Unix 绝对路径或包含盘符/用户主目录 → 仓库外
            lowered = ref.lower()
            if ref.startswith(("C:\\", "c:/", "/mnt/", "~/", "C:/")) or ":\\" in ref[:3] or "desktop" in lowered or "users/" in lowered:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"source_refs entry `{ref}` 指向仓库外路径（git 无法追溯）— 应改为仓库内相对路径（R1-c）",
                ))


def _lint_source_refs_line_range(root: Path, issues: list[LintIssue]) -> None:
    """R1-d (#271): source_refs 行号超源文件总行数 → WARNING。

    实证：#213 批 / #250 L54 旧行号残留——素材更新后旧行号失效，引用漂移。
    规则：解析 `path(L1146-L1820)` / `path L1146-L1820` 形式，比对源文件实际行数。
    """
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return
    import re as _re
    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=20_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        refs = fm.get("source_refs")
        if not isinstance(refs, list):
            continue
        for ref in refs:
            if not isinstance(ref, str):
                continue
            m = _re.search(r'([\w/.\-一-鿿]+)[\s(（]*L?(\d+)\s*[-–—]\s*L?(\d+)[\s)）]*$', ref.strip())
            if not m:
                continue
            path_part, start_s, end_s = m.group(1), int(m.group(2)), int(m.group(3))
            target = root / path_part
            if not target.exists():
                continue  # 存在性由 _lint_source_refs_exist / R1-c 处理
            try:
                total = sum(1 for _ in target.open(encoding="utf-8", errors="ignore"))
            except OSError:
                continue
            if end_s > total or start_s > total:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"source_refs `{ref}` 行号超源文件总行数（{total} 行）— 引用漂移，需核对（R1-d）",
                ))


# ---------------------------------------------------------------------------
# L2 content quality checks
# ---------------------------------------------------------------------------

_L2_CONDENSE_HEADERS = ["Reusable Knowledge", "可复用知识", "浓缩"]
_L2_CRITIQUE_HEADERS = ["Open Questions", "开放问题", "质疑"]
_L2_SYNTHESIS_HEADERS = ["Output Opportunities", "产出机会", "对标"]
_L2_CRITIQUE_KEYWORDS = ["具体假设", "边界", "反例", "前提"]


def _extract_section(body: str, header_names: list[str]) -> str | None:
    """Extract the content under a named ``## ...`` section. Returns None if not found.

    Matches plain ``## Critique`` and bracket-wrapped ``## [Critique]`` variants.
    """
    pattern = r"^## \[?(" + "|".join(re.escape(h) for h in header_names) + r")\]?\s*\n"
    m = re.search(pattern, body, re.MULTILINE)
    if not m:
        return None
    start = m.end()
    next_section = re.search(r"^## ", body[start:], re.MULTILINE)
    end = start + next_section.start() if next_section else len(body)
    return body[start:end].strip()


def _count_chinese_bullets(section: str) -> int:
    """Count `- ` prefixed lines that contain at least one CJK character."""
    cjk = re.compile(r"[一-鿿㐀-䶿豈-﫿]")
    count = 0
    for line in section.splitlines():
        stripped = line.strip()
        if stripped.startswith("- ") and cjk.search(stripped):
            count += 1
    return count


def _lint_l2_content_quality(root: Path, issues: list[LintIssue]) -> None:
    """L2 content quality: Condense (≥3 CN bullets), Critique (≥1 keyword),
    Synthesis (≥2 wikilinks, no self-link), full text > 500 chars."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue

        rel = relpath(root, page)
        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text

        # Full text check (body after frontmatter)
        if len(body) < 500:
            issues.append(LintIssue(
                "warning", rel,
                f"L2: body too short ({len(body)} chars, min 500)",
            ))

        # Condense: ≥3 bullet lines with Chinese content
        condense = _extract_section(body, _L2_CONDENSE_HEADERS)
        if condense:
            cn = _count_chinese_bullets(condense)
            if cn < 3:
                issues.append(LintIssue(
                    "warning", rel,
                    f"L2 Condense: {cn} substantive Chinese bullet(s), need ≥3",
                ))

        # Critique: at least one of four key terms
        critique = _extract_section(body, _L2_CRITIQUE_HEADERS)
        if critique:
            if not any(kw in critique for kw in _L2_CRITIQUE_KEYWORDS):
                issues.append(LintIssue(
                    "warning", rel,
                    "L2 Critique: missing key terms (具体假设/边界/反例/前提)",
                ))

        # Synthesis: ≥2 wikilinks, no self-links
        synthesis = _extract_section(body, _L2_SYNTHESIS_HEADERS)
        if synthesis:
            links = INTERNAL_LINK_RE.findall(synthesis)
            page_stem = page.stem
            self_links = [
                l for l in links
                if page_stem in l.split("|")[0].split("#")[0]
            ]
            external = len(links) - len(self_links)
            if self_links:
                issues.append(LintIssue(
                    "warning", rel,
                    "L2 Synthesis: contains self-link",
                ))
            if external < 2:
                issues.append(LintIssue(
                    "warning", rel,
                    f"L2 Synthesis: {external} external wikilink(s), need ≥2",
                ))


# ---------------------------------------------------------------------------
# I-2: synthesis dead link detection
# ---------------------------------------------------------------------------

_SYNTHESIS_HEADERS = ["Synthesis", "合成", "对标"]


def _extract_synthesis_section(body: str) -> str | None:
    """Extract the ## Synthesis section from a card body."""
    pattern = r"^## \[?(" + "|".join(re.escape(h) for h in _SYNTHESIS_HEADERS) + r")\]?\s*\n"
    m = re.search(pattern, body, re.MULTILINE)
    if not m:
        return None
    start = m.end()
    next_section = re.search(r"^## ", body[start:], re.MULTILINE)
    end = start + next_section.start() if next_section else len(body)
    return body[start:end].strip()


def _lint_synthesis_dead_links(root: Path, issues: list[LintIssue]) -> None:
    """Check [[wikilinks]] in ## Synthesis sections resolve to existing files."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    # Build a fast lookup: stem → True (file exists)
    vault_stems: set[str] = set()
    vault_names: set[str] = set()
    for md in root.rglob("*.md"):
        if ".trash" in md.parts or ".obsidian" in md.parts or ".git" in md.parts:
            continue
        vault_stems.add(md.stem)
        vault_names.add(md.name)

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page, limit=50_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text
        synthesis = _extract_synthesis_section(body)
        if not synthesis:
            continue

        for raw in INTERNAL_LINK_RE.findall(synthesis):
            target = raw.split("|")[0].split("#")[0].strip()
            if not target:
                continue
            # Resolve: check stem match, name match, or path match
            resolved = (
                target in vault_stems
                or target in vault_names
                or (target.endswith(".md") and (root / target).exists())
            )
            if not resolved:
                # Try with .md suffix
                resolved = (target + ".md") in vault_names or target + ".md" in vault_stems
            if not resolved:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"Synthesis dead link: [[{target}]] does not resolve to any existing page",
                ))


# ---------------------------------------------------------------------------
# I-4: dark knowledge card structure validation
# ---------------------------------------------------------------------------

_DK_REQUIRED_FRONTMATTER = {}
_DK_REQUIRED_SECTIONS = {
    "原始表述": "Truman/来源人物的原话",
    "使用场景": "什么情况下用这个暗知识",
    "操作方法": "具体怎么操作",
    "适用边界": "什么时候不适用",
    "为什么值钱": "公开语料中为什么找不到",
    "与其他知识的关联": "链接到其他卡片（至少1张概念卡+1张暗知识卡）",
}


def _lint_dark_knowledge_structure(root: Path, issues: list[LintIssue]) -> None:
    """Validate dark-knowledge (dk-*) card structure: frontmatter fields + body sections."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        if not page.stem.startswith("dk-"):
            continue
        try:
            text = safe_read(page, limit=30_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        if fm.get("type") != "dark-knowledge" and not page.stem.startswith("dk-"):
            continue

        rel = relpath(root, page)

        # Check required frontmatter fields
        for field, description in _DK_REQUIRED_FRONTMATTER.items():
            val = fm.get(field)
            if val is None or val == "":
                issues.append(LintIssue(
                    "error", rel,
                    f"Dark knowledge card missing frontmatter field `{field}` ({description})",
                ))

        # Check required body sections
        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text
        for section_name, description in _DK_REQUIRED_SECTIONS.items():
            pattern = r"^##\s+" + re.escape(section_name)
            if not re.search(pattern, body, re.MULTILINE):
                issues.append(LintIssue(
                    "error", rel,
                    f"Dark knowledge card missing section `## {section_name}` ({description})",
                ))


# ---------------------------------------------------------------------------
# I-3: artifact orphan detection
# ---------------------------------------------------------------------------

def _lint_artifact_orphans(root: Path, state: dict[str, Any], issues: list[LintIssue]) -> None:
    """Detect .md files in 40_outputs/ that are not registered in state.json artifacts."""
    output_dirs = ["40_outputs/content", "40_outputs/code", "40_outputs/capabilities"]
    registered_paths: set[str] = set()
    for artifact in state.get("artifacts", []):
        path_val = artifact.get("path", "")
        if path_val:
            registered_paths.add(path_val)

    for out_dir in output_dirs:
        base = root / out_dir
        if not base.is_dir():
            continue
        for md_file in base.rglob("*.md"):
            rel = relpath(root, md_file)
            if rel in registered_paths:
                continue
            # Skip template/placeholder files that don't have a real frontmatter id
            if "draft-" in str(md_file.name) or md_file.name in ("README.md",):
                continue
            try:
                text = safe_read(md_file, limit=2000)
                fm, _ = parse_frontmatter(text)
            except OSError:
                continue
            # Only flag files that look like real content (have an id or artifact_id)
            if not fm.get("id") and not fm.get("artifact_id"):
                continue
            # Check if any registered path is a parent directory of this file
            has_parent = any(
                rel.startswith(rp.rstrip("/") + "/") or rel.startswith(rp.rsplit("/", 1)[0] + "/")
                for rp in registered_paths if "/" in rp
            )
            if has_parent:
                continue
            issues.append(LintIssue(
                "warning", rel,
                "Artifact file not registered in .kdo/state.json — may have been created outside kdo produce pipeline",
            ))


# ---------------------------------------------------------------------------
# I-6: OCR mandatory check (P-7 prevention)
# ---------------------------------------------------------------------------

def _lint_ocr_missing(root: Path, issues: list[LintIssue]) -> None:
    """Check that .png/.jpg files referenced in source_refs have corresponding OCR output."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    image_exts = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif"}

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        text = safe_read(page, limit=30_000)
        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue
        refs = fm.get("source_refs")
        if not isinstance(refs, list) or not refs:
            continue

        for ref in refs:
            if not isinstance(ref, str) or not ref.strip():
                continue
            ref = ref.strip()
            ref_lower = ref.lower()
            # Only check image files
            if not any(ref_lower.endswith(ext) for ext in image_exts):
                continue
            ref_path = root / ref
            if not ref_path.exists():
                continue  # handled by _lint_source_refs_exist

            # Check for corresponding OCR output: <stem>_paddle_ocr.txt in same directory
            ocr_path = ref_path.with_name(ref_path.stem + "_paddle_ocr.txt")
            if not ocr_path.exists():
                # Also check old convention: <stem>_ocr.txt
                ocr_alt = ref_path.with_name(ref_path.stem + "_ocr.txt")
                if not ocr_alt.exists():
                    issues.append(LintIssue(
                        "warning", relpath(root, page),
                        f"OCR missing: source image `{ref}` has no corresponding OCR output "
                        f"(expected `{ocr_path.name}` in `{ref_path.parent}`)",
                    ))


# ---------------------------------------------------------------------------
# I-1: tool card quality gate
# ---------------------------------------------------------------------------

_TOOL_REQUIRED_SECTIONS = {
    "Purpose": "目标——这个工具解决什么问题",
    "Protocol": "操作步骤——具体怎么做",
}
_TOOL_RECOMMENDED_SECTIONS = {
    "When NOT to Use": "什么时候不该用这个工具",
    "Critique": "内部局限 + 外部攻击者论证",
}
_TOOL_PURPOSE_HEADERS = ["Purpose", "目的", "Mission"]
_TOOL_PROTOCOL_HEADERS = ["Protocol", "操作步骤", "步骤", "Procedure"]
_TOOL_CRITIQUE_HEADERS = ["Critique", "质疑", "局限"]
_TOOL_NOT_USE_HEADERS = ["When NOT to Use", "When Not to Use", "不要用的场景", "不适用场景", "Don't Use"]


def _lint_tool_card_quality(root: Path, issues: list[LintIssue]) -> None:
    """Quality gate for tool cards: required sections, recommended sections."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page, limit=50_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        if fm.get("type") != "tool":
            continue
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue

        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text
        rel = relpath(root, page)

        # Required: Purpose
        if not _extract_section(body, _TOOL_PURPOSE_HEADERS):
            issues.append(LintIssue(
                "warning", rel,
                "Tool card missing ## Purpose section — what problem does this tool solve?",
            ))

        # Required: Protocol/Procedure
        if not _extract_section(body, _TOOL_PROTOCOL_HEADERS):
            issues.append(LintIssue(
                "warning", rel,
                "Tool card missing ## Protocol/Procedure section — how to use this tool step by step?",
            ))

        # Recommended: When NOT to Use
        if not _extract_section(body, _TOOL_NOT_USE_HEADERS):
            issues.append(LintIssue(
                "warning", rel,
                "Tool card missing ## When NOT to Use section — what scenarios is this tool ineffective?",
            ))

        # Recommended: Critique (with external attacks)
        critique = _extract_section(body, _TOOL_CRITIQUE_HEADERS)
        if not critique:
            issues.append(LintIssue(
                "warning", rel,
                "Tool card missing ## Critique section — internal limits + external attacker arguments",
            ))
        else:
            # Check for attacker name pattern (e.g., "**Name Surname**" with description)
            has_scholar = bool(re.search(r"\*\*[A-Z][a-z]+ [A-Z][a-z]+\*\*", critique))
            if not has_scholar:
                issues.append(LintIssue(
                    "warning", rel,
                    "Tool card Critique section has no identifiable external attacker (bold scholar name)",
                ))

        # L2: body too short
        if len(body) < 500:
            issues.append(LintIssue(
                "warning", rel,
                f"Tool card body too short ({len(body)} chars, min 500)",
            ))


# ---------------------------------------------------------------------------
# I-5: source_refs fuzzy match
# ---------------------------------------------------------------------------

def _lint_source_refs_fuzzy(root: Path, issues: list[LintIssue]) -> None:
    """Detect source_refs entries that are close-but-not-exact matches to real files (likely typos)."""
    from difflib import SequenceMatcher
    import os as _os

    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    _WIKI_EXEMPT_TYPES = {"improvement-plan", "decision", "meta", "brief"}
    SIMILARITY_THRESHOLD = 0.80

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page, limit=30_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        if fm.get("type", "") in _WIKI_EXEMPT_TYPES:
            continue

        refs = fm.get("source_refs")
        if not isinstance(refs, list) or not refs:
            continue

        for ref in refs:
            if not isinstance(ref, str) or not ref.strip():
                continue
            ref = ref.strip()

            # Only check paths with directories
            if "/" not in ref and "\\" not in ref:
                continue
            ref_path = root / ref
            if ref_path.exists():
                continue  # Exact match — OK

            # Check parent directory for similar filenames
            parent = ref_path.parent
            if not parent.exists():
                continue

            ref_name = ref_path.name
            ref_name_lower = ref_name.lower()
            candidates = []
            try:
                for f in parent.iterdir():
                    if not f.is_file():
                        continue
                    fname = f.name
                    # Skip files that are too different in length
                    if abs(len(fname) - len(ref_name)) > max(len(ref_name) * 0.3, 10):
                        continue
                    ratio = SequenceMatcher(None, ref_name_lower, fname.lower()).ratio()
                    if ratio >= SIMILARITY_THRESHOLD and ratio < 1.0:
                        candidates.append((fname, ratio))
            except OSError:
                continue

            if candidates:
                candidates.sort(key=lambda x: -x[1])
                best = candidates[0]
                actual_rel = relpath(root, parent / best[0])
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"source_refs possible typo: `{ref}` not found — did you mean `{actual_rel}`? "
                    f"(similarity {best[1]:.0%})",
                ))


# ── Domain-tags consistency (P0-2) ──────────────────────────────────────────

_TAG_TO_DOMAIN = {
    "#yitang": "yitang",
    "#domain/AI": "ai",
    "#domain/design": "design",
    "#domain/product": "product",
    "#domain/decision-making": "decision-making",
    "#domain/knowledge-management": "knowledge-management",
    "#domain/electronics": "electronics",
    "#domain/creative": "creative",
    "#domain/collaboration": "collaboration",
    "#domain/ai-collaboration": "ai-collaboration",
    "#domain/business-strategy": "business-strategy",
    "#domain/innovation": "innovation",
    "#domain/learning": "learning",
    "#domain/general": "general",
    "#scene/entrepreneurship": "entrepreneur",
    "#scene/business-analysis": "business-strategy",
    "#scene/ai-collaboration": "ai-collaboration",
    "#scene/product-design": "product",
    "#scene/strategy": "business-strategy",
    "#scene/note-taking": "note-taking",
}


def _lint_domain_tags_consistency(root: Path, issues: list[LintIssue]) -> None:
    """Warn when tags suggest a domain that is not in the card's domain field."""
    wiki_dir = root / "30_wiki" / "concepts"
    if not wiki_dir.is_dir():
        return

    for md_file in wiki_dir.glob("*.md"):
        try:
            text = safe_read(md_file, limit=4_000)
        except OSError:
            continue
        fm, _ = parse_frontmatter(text)

        # Extract domains
        domains_raw = fm.get("domain", [])
        if isinstance(domains_raw, str):
            domains_raw = [domains_raw]
        if not isinstance(domains_raw, list):
            domains_raw = []
        domains_lower = {d.lower().strip() for d in domains_raw if d and isinstance(d, str)}

        # Extract tags
        tags_raw = fm.get("tags", [])
        if isinstance(tags_raw, str):
            tags_raw = [tags_raw]
        if not isinstance(tags_raw, list):
            tags_raw = []

        missing: list[str] = []
        for tag in tags_raw:
            if not isinstance(tag, str):
                continue
            tag_clean = tag.strip()
            if tag_clean in _TAG_TO_DOMAIN:
                expected = _TAG_TO_DOMAIN[tag_clean]
                if expected not in domains_lower:
                    missing.append(expected)

        if missing:
            unique = list(dict.fromkeys(missing))  # dedup preserving order
            issues.append(LintIssue(
                "warning",
                relpath(root, md_file),
                f"Tags suggest domain(s) not in 'domain' field: {', '.join(unique[:3])}. "
                f"domain: {sorted(domains_lower) if domains_lower else '(empty)'}. "
                f"Tags: {', '.join(t for t in tags_raw if isinstance(t, str) and t.strip() in _TAG_TO_DOMAIN)[:3]}.",
            ))


def _lint_source_refs_material(root: Path, issues: list[LintIssue]) -> None:
    """Warn when all source_refs are images with no text sources — producer may have missed transcripts."""
    wiki_dir = root / "30_wiki" / "concepts"
    if not wiki_dir.is_dir():
        return

    _IMG_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"}
    _TEXT_EXTS = {".txt", ".md"}

    for md_file in wiki_dir.glob("*.md"):
        try:
            text = safe_read(md_file, limit=4_000)
        except OSError:
            continue
        fm, _ = parse_frontmatter(text)
        refs = fm.get("source_refs", [])
        if isinstance(refs, str):
            refs = [refs]
        if not isinstance(refs, list) or len(refs) == 0:
            continue

        has_img = False
        has_text = False
        for ref in refs:
            if not isinstance(ref, str):
                continue
            ref_lower = ref.lower()
            if any(ref_lower.endswith(ext) for ext in _IMG_EXTS):
                has_img = True
            if any(ref_lower.endswith(ext) for ext in _TEXT_EXTS):
                has_text = True

        if has_img and not has_text:
            issues.append(LintIssue(
                "warning",
                relpath(root, md_file),
                "All source_refs are images (PNG/JPG). No text source (.txt/.md) found. "
                "May have missed lecture transcripts or notes. "
                "Search inbox for related .txt files.",
            ))


