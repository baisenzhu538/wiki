+    确实还没查过的：第一动作补一次 kdo query、落 0 命中也是合规记录——
+    规则要的是「检索这个动作发生过」，不是事后补话术（宪法第六条，#669）。
+    """
+    issues: list[PreSubmitIssue] = []
+    import datetime
+    hard_date = _querylog_hard_date()
+    hard = datetime.date.today().isoformat() >= hard_date
+    severity = "error" if hard else "warning"
+    state = "HARD" if hard else f"WARNING（软期至 {hard_date}，此后升 HARD 拦截）"
+    for fp in files:
+        text = safe_read(fp, limit=200_000)
+        fm, body = parse_frontmatter(text)
+        if not _is_diag_deliverable(root, fp, fm):
+            continue
+        if _QUERY_LOG_HEADING_RE.search(body):
+            continue
+        issues.append(PreSubmitIssue(
+            severity, "kdo_query_log", relpath(root, fp),
+            f"诊断/调研/报告类交付缺「kdo query 检索记录」节（查询词+命中数+日期）"
+            f"——知识问题第一动作=kdo query（检索词同义/中英扩展），0 命中才降级 "
+            f"grep 兜底（宪法第六条，#669；当前档位：{state}）",
+        ))
+    return issues
+
