+"""#669 回归：pre-submit kdo query 检索记录节门禁（_check_kdo_query_log）。
+
+用例：缺节 WARNING（软期）/ 缺节 ERROR（HARD 切换）/ env 覆盖切换两态 /
+带节通过（含库内既有节名变体）/ frontmatter type 判定 / 诊断目录路径判定 /
+无关文件不查 / CLI 输出渲染门禁。
+
+运行：python -m pytest tests/test_pre_submit_kdo_query_log.py -q
+"""
+from pathlib import Path
+
+from kdo.pre_submit import (
+    QUERY_LOG_HARD_DATE,
+    _check_kdo_query_log,
+    _querylog_hard_date,
+)
+
+
+def _doc(root: Path, rel: str, body: str, fm: list[str] | None = None) -> Path:
+    p = root / rel
+    p.parent.mkdir(parents=True, exist_ok=True)
+    lines = fm if fm is not None else ["---", "type: diagnosis", "---"]
+    p.write_text("\n".join(lines) + "\n\n" + body, encoding="utf-8")
+    return p
+
+
+def test_missing_section_warns_in_soft_window(tmp_path, monkeypatch):
+    """软期（今天 < HARD 日）：缺检索记录节 → WARNING 不拦截。"""
+    monkeypatch.setattr("kdo.pre_submit._querylog_hard_date", lambda: "9999-12-31")
+    doc = _doc(tmp_path, "60_feedback/diagnosis/diag_x.md", "# 诊断结论\n\n正文没有检索记录。")
+    issues = _check_kdo_query_log(tmp_path, [doc])
+    assert len(issues) == 1
+    assert issues[0].severity == "warning"
+    assert issues[0].gate == "kdo_query_log"
+    assert "检索记录" in issues[0].message
+
+
+def test_missing_section_errors_after_hard_date(tmp_path, monkeypatch):
+    """HARD 期（今天 ≥ HARD 日）：缺节 → ERROR 拦截（与 F-035 同级）。"""
+    monkeypatch.setattr("kdo.pre_submit._querylog_hard_date", lambda: "2026-01-01")
+    doc = _doc(tmp_path, "60_feedback/diagnosis/diag_y.md", "# 诊断结论\n\n正文没有检索记录。")
+    issues = _check_kdo_query_log(tmp_path, [doc])
+    assert len(issues) == 1 and issues[0].severity == "error"
+
+
+def test_env_override_switches_state(tmp_path, monkeypatch):
+    """KDO_QUERYLOG_HARD_DATE env 可提前门禁化（两态实证通道）。"""
+    monkeypatch.setenv("KDO_QUERYLOG_HARD_DATE", "2026-01-01")
+    assert _querylog_hard_date() == "2026-01-01"
+    monkeypatch.delenv("KDO_QUERYLOG_HARD_DATE")
+    assert _querylog_hard_date() == QUERY_LOG_HARD_DATE
+
+
+def test_section_present_passes(tmp_path):
+    """带检索记录节（查询词+命中数+日期）→ 零 issue。"""
+    body = (
+        "# 诊断结论\n\n"
+        "## kdo query 检索记录\n\n"
+        "- 2026-09-06 `kdo query \"标签治理 方法卡\"` → 3 命中\n"
+        "- 2026-09-06 `kdo query \"label governance\"` → 0 命中，降级 grep\n"
+    )
+    doc = _doc(tmp_path, "60_feedback/diagnosis/diag_z.md", body)
+    assert _check_kdo_query_log(tmp_path, [doc]) == []
+
+
+def test_existing_library_heading_variants_pass(tmp_path):
+    """库内既有节名变体均识别（不强迫改已有格式）。"""
+    for heading in (
+        "## 知识库检索记录（§10.4.1）",
+        "#### 检索记录（§10.4.1）",
+        "## 前置：wiki/技能检索记录",
+        "### 知识库检索记录",
+    ):
+        root = tmp_path / heading.strip("# ").strip()[:20]
+        doc = _doc(root, "60_feedback/diag/diag_v.md", f"{heading}\n\n- 查询词 → 命中\n")
+        assert _check_kdo_query_log(root, [doc]) == [], heading
+
+
+def test_frontmatter_type_qualifies_outside_diag_dirs(tmp_path, monkeypatch):
+    """type: diagnosis/research/report 在诊断目录外同样受查。"""
+    monkeypatch.setattr("kdo.pre_submit._querylog_hard_date", lambda: "9999-12-31")
+    doc = _doc(tmp_path, "70_product/notes/x.md", "# 调研报告正文", ["---", "type: report", "---"])
+    issues = _check_kdo_query_log(tmp_path, [doc])
+    assert len(issues) == 1 and issues[0].severity == "warning"
+
+
+def test_non_diag_files_skipped(tmp_path):
+    """非诊断/调研/报告类不查：30_wiki 概念卡、无 frontmatter 的普通 md。"""
+    card = _doc(tmp_path, "30_wiki/concepts/c.md", "## 概要\n\n正文", ["---", "type: concept", "---"])
+    plain = _doc(tmp_path, "00_inbox/note.md", "随手记", fm=[])
+    assert _check_kdo_query_log(tmp_path, [card, plain]) == []
+
+
+def test_cli_report_renders_kdo_query_log():
+    """CLI 展示层回归：kdo_query_log 必须出现在输出（防硬编码清单丢弃）。"""
+    from kdo.pre_submit import PreSubmitIssue, PreSubmitReport, format_report
+    report = PreSubmitReport(
+        files_checked=1, passed=1, failed=0,
+        issues=[PreSubmitIssue("warning", "kdo_query_log",
+                               "60_feedback/diagnosis/x.md", "缺检索记录节")],
+    )
+    out = format_report(report)
+    assert "[KDO_QUERY_LOG]" in out
+    assert "缺检索记录节" in out

