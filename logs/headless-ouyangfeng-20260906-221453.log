def cmd_pre_submit(args: argparse.Namespace) -> int:
    """Run mechanical pre-submit gates: YAML parse, wikilink resolve, domain typo."""
    from ..pre_submit import run_pre_submit, format_report
    from ..workspace import find_workspace

    root = find_workspace()
    files = getattr(args, "files", None)
    batch = getattr(args, "batch", None)
    expect = getattr(args, "expect_changes", None)

    report = run_pre_submit(root, files=files, batch=batch)
    print(format_report(report))
    rc = 0 if report.all_pass else 1

    if expect is not None:
        import subprocess
        r = subprocess.run(["git", "diff", "--stat"], capture_output=True, text=True, cwd=str(root))
        changed = len([l for l in r.stdout.split("\n") if l.strip() and "|" in l])
        print(f"\n  Git diff: {changed} files changed (expected >= {expect})")
        if changed < expect:
            print(f"  FAIL: Expected at least {expect} changed files, got {changed}")
            print(f"  This may indicate a false completion report. Verify all files were actually modified.")
            rc = 1

    return rc

