# Dashboard freshness check
# ---------------------------------------------------------------------------

# ── Stale artifact detection (Task J) ──────────────────────────────────────

def _lint_stale_artifacts(root: Path, issues: list[LintIssue]) -> None:
    """Detect artifacts whose input cards have been updated since build."""
    import hashlib, json as _json
    manifests_dir = root / ".kdo" / "build-manifests"
    if not manifests_dir.is_dir():
        return

    for mf in manifests_dir.glob("*.json"):
        try:
            manifest = _json.loads(mf.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue

        artifact_id = manifest.get("artifact_id", mf.stem)
        stale_cards = []
        for cid in manifest.get("input_cards", []):
            current_hash = None
            for d in ["30_wiki/concepts", "30_wiki/cases", "30_wiki/tools"]:
                p = root / d / f"{cid}.md"
                if p.exists():
                    current_hash = hashlib.sha256(p.read_bytes()).hexdigest()[:12]
                    break
            built_hash = manifest.get("card_versions", {}).get(cid, "?")
            if current_hash is None:
                stale_cards.append(f"{cid} (MISSING)")
            elif current_hash != built_hash:
                stale_cards.append(f"{cid} (UPDATED)")

        if stale_cards:
            details = "; ".join(stale_cards[:3])
            if len(stale_cards) > 3:
                details += f" (+{len(stale_cards) - 3} more)"
            issues.append(LintIssue(
                "warning",
                f".kdo/build-manifests/{mf.name}",
                f"Artifact '{artifact_id}' may be stale: {details}. "
                f"Run `kdo trace {artifact_id}` for details.",
            ))


_DASHBOARD_PATH = "70_product/tasks/dashboard.md"
_DASHBOARD_STALE_DAYS = 3


def _lint_dashboard_freshness(root: Path, issues: list[LintIssue]) -> None:
    """Warn if dashboard.md has not been updated in over N days."""
    dashboard = root / _DASHBOARD_PATH
    if not dashboard.exists():
        return

    try:
        text = safe_read(dashboard, limit=5_000)
        fm, _ = parse_frontmatter(text)
    except OSError:
        return

    updated_str = str(fm.get("updated", "")).strip()
    if not updated_str:
        issues.append(LintIssue(
            "warning", _DASHBOARD_PATH,
            "dashboard.md has no `updated:` date in frontmatter.",
        ))
        return

    from datetime import datetime, timezone
    try:
        updated_date = datetime.strptime(updated_str[:10], "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        return

    now = datetime.now(timezone.utc)
    age_days = (now - updated_date).days

    if age_days > _DASHBOARD_STALE_DAYS:
        # Check if there are newer changes to task files
        task_dir = root / "70_product" / "tasks"
        newest_task_change = updated_date
        try:
            for f in task_dir.rglob("*.md"):
                if f == dashboard:
                    continue
                mtime = datetime.fromtimestamp(f.stat().st_mtime, tz=timezone.utc)
                if mtime > newest_task_change:
                    newest_task_change = mtime
        except OSError:
            pass

        if newest_task_change > updated_date:
            issues.append(LintIssue(
                "warning", _DASHBOARD_PATH,
                f"Dashboard last updated {age_days} days ago ({updated_str[:10]}), "
                f"but task files have newer changes. Consider updating.",
            ))


# ---------------------------------------------------------------------------
# case card structure validation
# ---------------------------------------------------------------------------

_CASE_REQUIRED_SECTIONS = {
    "关键证据": "Before-After / 真实锚点 / 数据支撑 / 可检验",
    "可迁移场景": "这个案例的经验可以迁移到哪些场景",
    "教训": "什么时候应该学这个案例（正面）",
    "失败模式": "常见的踩坑方式和避免方法（反面）",
}
_CASE_FOUR_ELEMENT_HEADERS = ["四要素验证", "Four Elements", "真需求验证", "关键证据"]


def _lint_case_card_structure(root: Path, issues: list[LintIssue]) -> None:
    """Validate case card structure: required sections."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page, limit=30_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        if fm.get("type") != "case":
            continue

        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text
        rel = relpath(root, page)

        for section_name, description in _CASE_REQUIRED_SECTIONS.items():
            pattern = r"^##\s+" + re.escape(section_name)
            if not re.search(pattern, body, re.MULTILINE):
                issues.append(LintIssue(
                    "error", rel,
                    f"Case card missing section `## {section_name}` ({description})",
                ))

        # Body too short
        if len(body) < 500:
            issues.append(LintIssue(
                "warning", rel,
                f"Case card body too short ({len(body)} chars, min 500)",
            ))


# ---------------------------------------------------------------------------
# Depth: cross-card similarity detection
# ---------------------------------------------------------------------------

_SIMILARITY_SECTIONS = ["常见失败模式", "Common Failure Modes", "不要用的场景", "When NOT to Use", "When Not to Use"]
_SIMILARITY_THRESHOLD = 0.95  # SequenceMatcher ratio above which we flag copy-paste


def _lint_depth_cross_card_similarity(root: Path, issues: list[LintIssue]) -> None:
    """Detect copy-pasted sections across different cards."""
    from difflib import SequenceMatcher

    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    # Collect (card_rel, section_text) pairs
    sections: list[tuple[str, str, str]] = []  # (card_path, section_name, text)
    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        # Skip backup and auto-generated directories
        if any(p.startswith(".") for p in page.parts):
            continue
        if "links" in page.parts:
            continue
        try:
            text = safe_read(page, limit=50_000)
        except OSError:
            continue
        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text

        for section_name in _SIMILARITY_SECTIONS:
            section_text = _extract_section(body, [section_name])
            if section_text and len(section_text) > 40:  # Need enough content to compare
                sections.append((relpath(root, page), section_name, section_text))

    # Compare all pairs
    flagged_pairs: set[tuple[str, str]] = set()
    for i in range(len(sections)):
        for j in range(i + 1, len(sections)):
            path_i, name_i, text_i = sections[i]
            path_j, name_j, text_j = sections[j]
            if path_i == path_j:
                continue
            pair_key = tuple(sorted([path_i, path_j]))
            if pair_key in flagged_pairs:
                continue

            ratio = SequenceMatcher(None, text_i, text_j).ratio()
            if ratio >= _SIMILARITY_THRESHOLD:
                flagged_pairs.add(pair_key)
                issues.append(LintIssue(
                    "warning", path_i,
                    f"Depth: `## {name_i}` section is {ratio:.0%} similar to `{path_j}` — possible copy-paste",
                ))


# ---------------------------------------------------------------------------
# Depth: core concept elements missing
# ---------------------------------------------------------------------------

_COUNT_PATTERNS = [
    (r"([三四五六七八九十\d]+)要素", "个要素"),
    (r"([三四五六七八九十\d]+)大\s*(?:原则|方法|步骤|阶段|特征|优势|模块|技法|维度)", "个"),
    (r"([三四五六七八九十\d]+)种\s*(?:方法|模式|类型|场景|技巧|策略)", "种"),
    (r"([A-Za-z]+)\s*(?:原则|模块|阶段|步骤)", "个"),
]

_CN_NUM = {"三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9, "十": 10}


def _parse_count(text: str) -> int | None:
    """Parse a Chinese or Arabic number string into an integer."""
    t = text.strip()
    if t.isdigit():
        return int(t)
    return _CN_NUM.get(t)


def _lint_depth_missing_elements(root: Path, issues: list[LintIssue]) -> None:
    """Detect cards whose title promises N elements but the body doesn't list them."""
    wiki_root = root / "30_wiki"
    if not wiki_root.is_dir():
        return

    for page in wiki_root.rglob("*.md"):
        if not _is_searchable(root, page):
            continue
        try:
            text = safe_read(page, limit=50_000)
        except OSError:
            continue

        fm, _ = parse_frontmatter(text)
        title = fm.get("title", "")
        if not title:
            continue

        body = text.split("---\n", 2)[-1] if text.startswith("---\n") else text

        for pattern, unit in _COUNT_PATTERNS:
            m = re.search(pattern, title)
            if not m:
                continue
            expected = _parse_count(m.group(1))
            if expected is None:
                continue

            # Count substantive bullet points in the body
            bullets = re.findall(r"^\s*[-*]\s+\*\*", body, re.MULTILINE)
            numbered = re.findall(r"^\s*\d+\.\s+\*\*", body, re.MULTILINE)

            # Also count table rows in relevant sections
            actual = max(len(bullets), len(numbered))

            if actual == 0:
                # Try counting bullet points without bold
                bullets = re.findall(r"^\s*[-*]\s+\S", body, re.MULTILINE)
                numbered = re.findall(r"^\s*\d+\.\s+\S", body, re.MULTILINE)
                actual = max(len(bullets), len(numbered))

            # Flag when: (a) no items at all, or (b) item count deviates too far from title
            # A tolerance of +/-2 allows for reasonable elaboration without flagging
            # minor variations as generic steps.
            if actual == 0:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"Depth: title says `{expected}{unit}` but body has no bullet/numbered items — "
                    f"core elements are missing",
                ))
            elif abs(actual - expected) > 2:
                issues.append(LintIssue(
                    "warning", relpath(root, page),
                    f"Depth: title says `{expected}{unit}` but body has {actual} items — "
                    f"expected around {expected} (+/-2)",
                ))
            if actual == 0 or abs(actual - expected) > 2:
                break  # One warning per card is enough


# ---------------------------------------------------------------------------
# Wiki revision tracking — feedback → snapshot → change-detect → record
# ---------------------------------------------------------------------------


def snapshot_wiki_page(root: Path, state: dict[str, Any], wiki_rel_path: str, feedback_ids: list[str]) -> None:
    """Store a content-hash snapshot so revision scans can detect later changes.

    Mutates *state* in-place.  The caller is responsible for calling
    ``save_state`` afterwards — this function deliberately does NOT save
    to avoid a stale-state overwrite race with ``cmd_improve``.
    """
    wiki_path = root / wiki_rel_path
    if not wiki_path.exists():
        return
    content_hash = file_sha256(wiki_path)
    snapshots = state.setdefault("wiki_snapshots", {})
    existing = snapshots.get(wiki_rel_path)
    merged_ids = list(set(
        (existing.get("feedback_ids", []) if existing else []) + feedback_ids
    ))
    snapshots[wiki_rel_path] = {
        "hash": content_hash,
        "flagged_at": now_iso(),
        "feedback_ids": merged_ids,
    }


def record_wiki_revision(
    root: Path,
    state: dict[str, Any],
    wiki_rel_path: str,
    hash_before: str,
    hash_after: str,
    feedback_ids: list[str],
) -> dict[str, Any]:
    """Create a revision record documenting that feedback triggered a wiki page change."""
    revision_id = generate_id("rev")
    wiki_path = root / wiki_rel_path
    page_title = ""
    if wiki_path.exists():
        try:
            fm, _ = parse_frontmatter(safe_read(wiki_path, limit=2000))
            page_title = fm.get("title", "")
        except OSError:
            pass
    slug = slugify(wiki_rel_path.replace("/", "-").replace(".md", ""), fallback=revision_id)
    rev_dir = root / "90_control/revisions"
    ensure_dir(rev_dir)
    rev_path = rev_dir / f"{revision_id}-{slug}.md"
    body_lines = [
        f"# Revision: {page_title or wiki_rel_path}",
        "",
        "## Triggering Feedback",
        "",
    ]
    for fid in feedback_ids:
        body_lines.append(f"- `{fid}`")
    body_lines.extend(["", "## Change Summary", "", "_(No summary provided.)_", ""])
    record = {
        "revision_id": revision_id,
        "wiki_page": wiki_rel_path,
        "page_title": page_title,
        "feedback_ids": feedback_ids,
        "hash_before": hash_before,
        "hash_after": hash_after,
        "revised_at": now_iso(),
        "path": relpath(root, rev_path),
    }
    write_markdown(rev_path, record, "\n".join(body_lines))
    state.setdefault("revisions", []).append(record)
    append_wiki_log(
        root,
        f"Revision `{revision_id}` recorded for `{wiki_rel_path}` "
        f"(triggered by {len(feedback_ids)} feedback record(s))",
    )
    return record


def scan_wiki_revisions(root: Path, state: dict[str, Any]) -> list[dict[str, Any]]:
    """Scan all wiki_snapshots for content changes. Returns new revision records."""
    snapshots = state.get("wiki_snapshots", {})
    if not snapshots:
        return []
    new_revisions: list[dict[str, Any]] = []
    for wiki_rel_path in list(snapshots):
        snap = snapshots[wiki_rel_path]
        wiki_path = root / wiki_rel_path
        if not wiki_path.exists():
            del snapshots[wiki_rel_path]
            continue
        current_hash = file_sha256(wiki_path)
        if current_hash != snap["hash"]:
            rev = record_wiki_revision(
                root, state, wiki_rel_path,
                hash_before=snap["hash"],
                hash_after=current_hash,
                feedback_ids=snap.get("feedback_ids", []),
            )
            new_revisions.append(rev)
            # Clear needs-review status — revision is recorded, feedback closed
            try:
                text = safe_read(wiki_path)
                fm, body = parse_frontmatter(text)
                if fm.get("status") == "needs-review":
                    fm["status"] = "enriched"
                    write_markdown(wiki_path, fm, body)
                    # Sync to Obsidian frontmatter index
                    try:
                        from .bridge import set_property
                        set_property(wiki_rel_path, "status", "enriched")
                    except Exception:
                        pass  # Obsidian not available — file already updated
            except OSError:
                pass
            del snapshots[wiki_rel_path]
    save_state(root, state)
    return new_revisions


