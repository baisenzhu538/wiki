# 鍗曞瓧鍑虹幇鍙埗閫?warn 鍣煶锛堢嫾鏉ヤ簡鏁堝簲瀹炶瘉锛夛紱銆屾湭鍙戠幇銆嶄繚鐣欙紙鎰忚涔︺€屾垜娌＄湅鍒般€嶅珜鐤戞湁鎻愮ず浠峰€硷級
NEGATIVE_CLAIM_SOFT = ["鏈彂鐜?, "鎴柇", "鎹熷潖", "涔辩爜", "鍗婂啓"]


def _check_negative_claims(text: str) -> tuple[bool, str]:
    """#433锛氭剰瑙佷功鏂囨湰鍚礋鍚戞柇瑷€璇嶆椂蹇呴』鍚?`**瀛樺湪鎬ф牳鏌?*` 閿氱偣銆?

    杩斿洖 (block, msg)锛歜lock=True=review 涓嶉棴鐜紱False=鏀捐锛堝璇嶅懡涓粰 warn 鎻愮ず锛夈€?
    """
    if EVIDENCE_ANCHOR in text:
        return True, ""
    hits = [w for w in NEGATIVE_CLAIM_STRONG if w in text]
    m = NEGATIVE_CLAIM_PATTERN.search(text)
    if m:
        hits.append(f"銆寋m.group(0)}銆?)
    m2 = NEGATIVE_CLAIM_PATTERN_DATA.search(text)
    if m2:
        hits.append(f"銆寋m2.group(0)}銆?)
    if hits:
        return False, (f"鎰忚涔﹀惈璐熷悜鏂█锛坽'/'.join(hits[:4])}锛変絾鏃?`**瀛樺湪鎬ф牳鏌?*` 閿氱偣"
                       f"锛?433锛?鎴戞病鐪嬪埌'鈮?涓嶅瓨鍦?锛岃礋鍚戝垽璇嶅繀椤婚檮鏍告煡鑺傦紝鍚﹀垯涓嶉棴鐜級")
    soft = [w for w in NEGATIVE_CLAIM_SOFT if w in text]
    if soft:
        return True, f"鈿狅笍 鎰忚涔﹀惈瀹借礋鍚戣瘝锛坽'/'.join(soft[:3])}锛夋棤鏍告煡閿氱偣鈥斺€旀寜闇€浜哄伐纭锛?433 涓嶇‖鏉€锛?
    return True, ""


def _check_review_record(task_file: Path, review_file: str | None) -> tuple[bool, str]:
    """#429 F-035锛氬鏌ユ剰瑙佷功寮哄埗钀界洏鈥斺€斾换鍔″崟銆?# 缁堝璁板綍銆嶈妭锛堚墺50 瀛楋級鎴?--review-file 璺緞锛屼簩鑰呭繀鏈夊叾涓€銆?""
    if review_file is not None:
        try:
            rf_text = Path(review_file).read_text(encoding="utf-8", errors="ignore")
        except OSError:
            return False, f"--review-file 涓嶅彲璇? {review_file}"
        if len(rf_text.strip()) < 50:
            return False, "瀹℃煡鎰忚鏂囦欢鍐呭杩囩煭锛?429 F-035锛夛紝涓嶆瀯鎴愬鏌ユ剰瑙佷功"
        return True, ""
    body = task_file.read_text(encoding="utf-8", errors="ignore")
    idx = body.find("## 缁堝璁板綍")
    if idx == -1:
        return False, "浠诲姟鍗曠己灏戙€?# 缁堝璁板綍銆嶈妭锛?429 F-035锛氬鏌ユ剰瑙佸繀椤昏惤鐩橈紝鍙ｅご/缇ら噷鎰忚=鏈鏌ワ級"
    nxt = body.find("\n## ", idx + 1)
    section = body[idx:nxt] if nxt > 0 else body[idx:]
    if len(section.strip()) < 50:
        return False, "缁堝璁板綍鑺傚唴瀹硅繃鐭紙#429 F-035锛夛紝涓嶆瀯鎴愬鏌ユ剰瑙佷功"
    return True, ""


# #461锛氬彇娑堝彴璐︼紙璋?涓轰綍鍙栨秷锛屼笌 #444 force 鍙拌处鍚屾鐣欑棔绮剧锛?
CANCEL_LEDGER = _WIKI_ROOT / "90_control" / "cancel-ledger.log"


def action_cancel(task_id: str, instance: str, reason: str | None) -> tuple[bool, str]:
    """#461锛歲ueued 鍗曞彇娑堬紙琚彇浠?涓嶉渶瑕佲€斺€旂粓鎬侊紝闈炲垹闄わ級銆?-reason 蹇呭～锛堢暀鐥曪細璋?涓轰綍锛夈€?""
    if not (reason and reason.strip()):
        return False, "cancel 蹇呴』閰?--reason '<鍙栨秷鐞嗙敱>'锛?461锛氳皝/涓轰綍鍙栨秷锛屽彴璐﹀彲婧級"

    rows = parse_queue()
    task = find_task(task_id, rows)
    if task is None:
        return False, f"浠诲姟 {task_id} 涓嶅湪闃熷垪涓?
    if task["status"] != "queued":
        return False, f"浠诲姟 {task_id} 鐘舵€佷负 {task['status']}锛屼粎 queued 鍙?cancel锛坈laimed 鍏?release锛宲ending_review 鍏堥€€鍥烇級"

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}"

    with QueueLock("production-queue"):
        rows = parse_queue()
        task = find_task(task_id, rows)
        if task is None or task["status"] != "queued":
            return False, "闃熷垪鐘舵€佸湪鍔犻攣鏈熼棿鍙戠敓鍙樺寲锛岃閲嶈瘯"
        apply_updates(task_id, "cancelled", task_file,
                      status="cancelled",
                      cancelled_by=instance,
                      cancel_reason=reason,
                      cancelled_at=current_utc_date())
    # 鍙栨秷鍙拌处
    try:
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with CANCEL_LEDGER.open("a", encoding="utf-8") as f:
            f.write(f"{ts}锝渰task_id}锝渰instance}锝渰reason[:100]}\n")
    except Exception:
        pass
    return True, f"鈴癸笍 {task_id} 宸插彇娑堬紙cancelled锛宺eason: {reason[:50]}锛夆€斺€旂粓鎬侊紝閲嶆柊鍋?鏂板崟"


def action_mark_waiting(task_id: str, note: str | None = None) -> tuple[bool, str]:
    """#429 F-029锛歱ending_review 鈫?waiting-external锛堢瓑鑰佹湵/澶栭儴杈撳叆锛屼笉鍗犲鏌ヤ綅涓嶉樆濉為鍙栵級銆?

    #188 鏄椿鏍锋湰锛堝彧璇诲紩鐢級锛氱瓑鑰佹湵鐪熷疄浣跨敤棣栨潯璁板綍锛屾爣 waiting-external 鍚庝笉鍐嶉樆濉炰笉鍚?assignee 棰嗗彇銆?
    """
    rows = parse_queue()
    task = find_task(task_id, rows)
    if task is None:
        return False, f"浠诲姟 {task_id} 涓嶅湪闃熷垪涓?
    if task["status"] != "pending_review":
        return False, f"浠诲姟 {task_id} 鐘舵€佷负 {task['status']}锛屽彧鏈?pending_review 鍙爣 waiting-external"

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}"

    with QueueLock("production-queue"):
        rows = parse_queue()
        task = find_task(task_id, rows)
        if task is None or task["status"] != "pending_review":
            return False, "闃熷垪鐘舵€佸湪鍔犻攣鏈熼棿鍙戠敓鍙樺寲锛岃閲嶈瘯"
        apply_updates(task_id, "waiting-external", task_file,
                      status="waiting-external",
                      waiting_since=current_utc_date(),
                      waiting_note=note or "")
    return True, f"鈴革笍 {task_id} 宸叉爣 waiting-external锛堢瓑寰呭閮ㄨ緭鍏ワ紝涓嶉樆濉為槦鍒楋級"


