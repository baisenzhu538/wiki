def action_release(task_id: str, instance: str) -> tuple[bool, str]:
    """Release a claimed task back to queued."""
    rows = parse_queue()
    task = find_task(task_id, rows)
    if task is None:
        return False, f"浠诲姟 {task_id} 涓嶅湪闃熷垪涓?

    if not (task["status"].startswith("claimed-")
            and _claimed_by_role(instance, task["status"][len("claimed-"):])):
        return False, (f"浠诲姟 {task_id} 鐘舵€佷负 {task['status']}锛屼笉鏄敱 {instance} 棰嗗彇鐨?
                       f"锛?620 杩囨浮鏈燂細瑁稿悕/鍚岃鑹叉棫鍚?{instance}-<tool> 鍧囧彲閲婃斁锛?)

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}锛堝凡鎸夋枃浠跺悕鍜?frontmatter id 鍙岄噸鏌ユ壘锛?

    with QueueLock("production-queue"):
        apply_updates(task_id, "queued", task_file, status="queued")

    return True, f"鉁?{task_id} 宸查噴鏀惧洖 queued"


def _action_review_override(task: dict, task_file: Path, reviewer: str, reason: str) -> tuple[bool, str]:
    """#538 鏀瑰垽閫氶亾锛歳eviewed鈫抭ueued锛堢粓瀹¤嚜鎴戠籂閿欐満鍣ㄩ€氶亾鈥斺€旂牬绐楁墜鏀圭殑鏍规不锛夈€?

    绾緥锛?-reason 蹇呭～锛涗緥澶栬惤 force-exceptions 鍙拌处锛?444 鍚屾锛夛紱浠诲姟鍗曡拷璁?
    銆?# 鏀瑰垽璁板綍銆嶈妭锛堟椂闂?鍘?verdict/鐞嗙敱锛夛紱鍙敮鎸?reviewed鈫抭ueued 涓€涓柟鍚?
    锛坓rade 鏇存璧颁换鍔″崟杩借锛屼笉鍔ㄧ姸鎬佹満锛夈€傛敼鍒ゅ悗鎺㈤拡 new_failback 鍙ｅ緞宸茶鐩?
    銆屾浘 reviewed銆嶅満鏅紙#538 浠诲姟 2锛宷ueued 鈭?last_reviewed 鍗虫敼鍒や俊鍙凤級銆?
    """
    task_id = task["task_id"]
    fm, _ = parse_frontmatter(task_file)
    orig = f"PASS {fm.get('grade', '')}".strip()
    ts = datetime.now().strftime("%Y-%m-%d %H:%M")

    # 浠诲姟鍗曡拷璁版敼鍒よ妭锛堝箓绛夛細澶氭鏀瑰垽閫愭潯杩藉姞锛?
    body = task_file.read_text(encoding="utf-8")
    entry = (f"- [{ts}] **{reviewer}鏀瑰垽**锛歿orig} 鈫?FAIL锛堣繑宸ワ級锝滅悊鐢憋細{reason.strip()}\n")
    if "## 鏀瑰垽璁板綍" in body:
        idx = body.find("## 鏀瑰垽璁板綍")
        nxt = body.find("\n## ", idx + 1)
        insert_at = nxt if nxt > 0 else len(body.rstrip("\n"))
        body = body[:insert_at].rstrip("\n") + "\n\n" + entry + ("\n" + body[insert_at:] if nxt > 0 else "\n")
    else:
        body = body.rstrip("\n") + f"\n\n## 鏀瑰垽璁板綍\n\n{entry}"
    task_file.write_text(body, encoding="utf-8")

    ledger = _log_force_exception(task_id, reviewer, reason,
                                  bypass="reviewed鈫抭ueued 鏀瑰垽锛?538 缁堝鑷垜绾犻敊閫氶亾锛?)
    # #580锛團-064锛夛細鏀瑰垽=FAIL 鎵撳洖鍚屾棌鈥斺€斿悓鏍疯嚜鍔ㄦ墦 rework:true 鏍囷紝杩斿伐閲嶆彁璞佸厤 #504
    with QueueLock("production-queue"):
        rows = parse_queue()
        task2 = find_task(task_id, rows)
        if task2 is None or task2["status"] != "reviewed":
            return False, "闃熷垪鐘舵€佸湪鍔犻攣鏈熼棿鍙戠敓鍙樺寲锛岃閲嶈瘯"
        apply_updates(task_id, "queued", task_file, status="queued", rework=True)
    return True, (f"鈫╋笍 {task_id} 宸叉敼鍒わ細{orig} 鈫?FAIL锛岀姸鎬佸洖 queued锛堣繑宸ワ級\n"
                  f"鈿狅笍 鏀瑰垽渚嬪宸茬暀鐥? {ledger}\n浠诲姟鍗曞凡杩借銆?# 鏀瑰垽璁板綍銆嶈妭"
                  f"锛堝凡鑷姩鏍?rework:true鈥斺€旇繑宸ラ噸鎻愪笉鍐嶈Е鍙?#504 鎷︽埅锛?580 F-064锛?)


def action_review(task_id: str, verdict: str, reviewer: str, grade: str | None = None,
                  review_file: str | None = None, override: bool = False,
                  reason: str | None = None, force: bool = False) -> tuple[bool, str]:
    """Ouyangfeng-only: review a pending_review task.

    #616 浠诲姟3 缈昏浆閫氶亾锛氭闃抽攱鑷繁鐨勫崟鏃犱汉鍙粓瀹★紙#544 鎵嬪伐缈昏浆鍏堜緥 + 09-02 #614
    绗簩渚嬶級锛宍--reviewer 鐜嬭瀚 闄愩€岀紪鎺掗鏋跺崟銆嶏紙闃熷垪琛?assignee=ouyangfeng锛夋斁琛岋紝
    瀹℃煡鎰忚涔?璐熷悜鍒よ瘝/钀界偣闂ㄧ涓庡彴璐︾暀鐥曞叏閮ㄤ笉鍙樸€?
    """
    if reviewer != "娆ч槼閿?:
        if reviewer != "鐜嬭瀚?:
            return False, ("鍙湁娆ч槼閿嬪彲浠ユ墽琛?review 鎿嶄綔"
                           "锛堜緥澶栵細鐜嬭瀚ｅ彲缈昏浆 assignee=ouyangfeng 鐨勭紪鎺掗鏋跺崟锛?616锛?)
        rows0 = parse_queue()
        t0 = find_task(task_id, rows0)
        assignee0 = str((t0 or {}).get("assignee", "") or "")
        if assignee0 != "ouyangfeng":
            return False, (f"鐜嬭瀚ｇ炕杞€氶亾浠呴檺 assignee=ouyangfeng 鐨勭紪鎺掗鏋跺崟锛?616锛?
                           f"鈥斺€旀湰鍗?assignee={assignee0 or '鏈煡'}锛屼粛闇€娆ч槼閿嬬粓瀹?)
    # #546锛氱粓瀹℃潈鏈哄櫒鏍￠獙锛堜竴鍏蜂袱鑱屾牴娌伙級鈥斺€斿綋鍓?cwd 椤绘湁 ouyangfeng 鐧昏瀹炰緥
    auth_ok, auth_msg = _check_review_authority(task_id, reviewer, force=force, reason=reason)
    if not auth_ok:
        _log_gate_blocked(task_id, "#546-缁堝鏉冩牎楠?, auth_msg, reviewer)
        return False, auth_msg
    if auth_msg:  # force 閫冪敓闂ㄧ暀鐥曟彁绀洪殢鎴愬姛娑堟伅閫忎紶
        print(auth_msg, file=sys.stderr)

    rows = parse_queue()
    task = find_task(task_id, rows)
    if task is None:
        return False, f"浠诲姟 {task_id} 涓嶅湪闃熷垪涓?
    if task["status"] != "pending_review":
        # #538锛氭敼鍒ら€氶亾鈥斺€攔eviewed鈫抭ueued锛坴erdict=fail + --override + --reason 蹇呭～锛?
        if override and verdict == "fail" and task["status"] == "reviewed":
            if not (reason and reason.strip()):
                return False, ("鏀瑰垽蹇呴』閰?--reason '<鐞嗙敱>'锛?538锛氫緥澶栫暀鐥曗€斺€?
                               "璋?涓轰綍/浣曟椂锛屽彴璐﹀彲婧紱鏃犳褰撶悊鐢变笉鏀瑰垽锛?)
            tf = _find_task_file_dual(task_id)
            if tf is None:
                return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}"
            return _action_review_override(task, tf, reviewer, reason)
        return False, f"浠诲姟 {task_id} 鐘舵€佷负 {task['status']}锛屼笉鏄?pending_review锛屾棤娉曠粓瀹?

    task_file = _find_task_file_dual(task_id)
    if task_file is None:
        return False, f"鎵句笉鍒颁换鍔″崟鏂囦欢: {task_id}锛堝凡鎸夋枃浠跺悕鍜?frontmatter id 鍙岄噸鏌ユ壘锛?

    # #429 F-035锛氬鏌ユ剰瑙佷功寮哄埗钀界洏锛堣€佹湵鏍″噯锛氬彛澶?缇ら噷鎰忚=鏈鏌ワ級
    # 鎰忚杞戒綋 = 浠诲姟鍗曘€?# 缁堝璁板綍銆嶈妭锛堥潪绌猴級鎴?--review-file 鎸囧畾璺緞
    ok, msg = _check_review_record(task_file, review_file)
    if not ok:
        _log_gate_blocked(task_id, "F-035-鎰忚涔?, msg, reviewer)
        return False, msg

    # #433锛氳礋鍚戝垽璇嶈瘉鎹眰闂ㄧ鈥斺€旀剰瑙佷功鍚礋鍚戞柇瑷€璇嶅繀椤诲甫 `**瀛樺湪鎬ф牳鏌?*` 閿氱偣
    opinion_text = ""
    if review_file is not None:
        opinion_text = Path(review_file).read_text(encoding="utf-8", errors="ignore")
    else:
        body = task_file.read_text(encoding="utf-8", errors="ignore")
        idx = body.find("## 缁堝璁板綍")
        if idx != -1:
            nxt = body.find("\n## ", idx + 1)
            opinion_text = body[idx:nxt] if nxt > 0 else body[idx:]
    gate_ok, gate_msg = _check_negative_claims(opinion_text)
    if not gate_ok:
        _log_gate_blocked(task_id, "F-035-璐熷悜鍒よ瘝", gate_msg, reviewer)
        return False, gate_msg

    # F-036锛?涓诲姩绔嬮」 2026-08-24锛夛細瀹℃煡鍙戠幇蹇呴』缁欒惤鐐光€斺€斿彂鐜伴棶棰樿妭鍚?馃煚/馃煛
    # 鏉＄洰鏃跺繀椤绘敞鏄庡幓鍚戯紙寤鸿涔?鍋滆溅鍦?F-xxx/浠诲姟鍗曠珛椤癸級锛屾棤钀界偣=缁堝涓嶉棴鐜?
    disp_ok, disp_msg = _check_issue_disposition(opinion_text)
    if not disp_ok:
        _log_gate_blocked(task_id, "F-036-闂钀界偣", disp_msg, reviewer)
        return False, disp_msg

    with QueueLock("production-queue"):
        if verdict == "pass":
            updates = {
                "status": "reviewed",
                "reviewed_by": reviewer,
                "review_date": current_utc_date(),
            }
            if grade:
                updates["grade"] = grade
            apply_updates(task_id, "reviewed", task_file, **updates)
            grade_note = f"锛岀瓑绾?{grade}" if grade else ""
            # #389锛氱粓瀹￠€氳繃 鈫?REVIEW-PENDING 娈靛搴旇鑷姩鍒掓帀
            _review_board_update(
                strike=task_id,
                strike_note=f" 鈫?宸茬粓瀹?PASS {grade or ''}锛坽current_utc_date()} {reviewer}锛?,
            )
            # #612 浠诲姟2锛歳eview_mark 婕忚浆姝ｄ簩娆″鍙戯紙#586/#596锛孍018 瀹舵棌鍚屾簮锛夆€斺€?
            # 缁堝閫氳繃鏃朵氦浠樼墿鍚?30_wiki 鍗＄墖 鈫?杈撳嚭杞鎻愰啋锛堟彁閱掑嵆鍙紝涓嶄唬鍐欙級
            remind = _review_card_mark_reminder(task_file)
            return True, f"鉁?{task_id} 缁堝閫氳繃锛岀姸鎬佹洿鏂颁负 reviewed{grade_note}{remind}"
        else:
            # #580锛團-064锛夛細FAIL 鎵撳洖鏃惰嚜鍔ㄦ墦 rework:true 鏍団€斺€旇繑宸ラ噸鎻?claim 鏃?
            # _is_rework_task 璇诲埌璇ユ爣鍗宠眮鍏?#504 own-pending 闃诲锛堥噸鎻愨墵鎺ユ柊鍗曪級銆?
            # 璧?apply_updates 鍐?frontmatter锛堝箓绛夛紝澶氳疆杩斿伐閲嶅鍐?true 鏃犲壇浣滅敤锛夈€?
            apply_updates(task_id, "queued", task_file, status="queued", rework=True)
            # #389锛氱粓瀹￠€€鍥?鈫?鍚屾牱鍒掓帀鐧昏琛岋紙浠诲姟鍥?queued锛屼笉鍐嶅緟缁堝锛?
            _review_board_update(
                strike=task_id,
                strike_note=f" 鈫?缁堝閫€鍥?queued锛坽current_utc_date()} {reviewer}锛?,
            )
            return True, (f"鈿狅笍 {task_id} 缁堝涓嶉€氳繃锛岀姸鎬侀€€鍥?queued"
                          f"锛堝凡鑷姩鏍?rework:true鈥斺€旇繑宸ュ畬鎴愬悗閲嶆彁涓嶅啀瑙﹀彂 #504 鎷︽埅锛?580 F-064锛?)


def _task_depends_on(task_id: str) -> list[str]:
    """#472锛氫换鍔′功 frontmatter depends_on 鈫?渚濊禆浠诲姟鍙峰垪琛紙瀛橀噺鏃犲瓧娈?[]=鍙锛夈€?""
    tf = _find_task_file_dual(task_id)
    if tf is None:
        return []
    fm, _ = parse_frontmatter(tf)
    dep = fm.get("depends_on", "")
    if isinstance(dep, list):
        return [str(d).strip().lstrip("#") for d in dep if str(d).strip()]
    if dep:
        return [str(dep).strip().lstrip("#")]
    return []


def _is_active_task(task_id: str, rows: list) -> bool:
    """渚濊禆浠诲姟浠嶅湪杩涜锛坬ueued/claimed/pending_review/blocked锛夆啋 鏈弧瓒炽€?""
    for r in rows:
        if r["task_id"] == task_id:
            return (r["status"] in ("queued", "pending_review", "blocked")
                    or r["status"].startswith("claimed-"))
    return False  # 闃熷垪鏃犺=宸茬粨鏉燂紝瑙嗕负婊¤冻


def _consumption_heartbeat(role: str | None) -> None:
    """#562 浠诲姟2锛堟柟妗圔 钀界偣锛夛細娑堣垂鍥炴墽=蹇冭烦鈥斺€攎yqueue/claim/complete/release/review
    閮芥槸 agent 鐪熷疄娑堣垂闃熷垪鐨勫姩浣滄椂鍒伙紝椤烘墜韫媿娉ㄥ唽琛ㄥ績璺炽€?
    鏃堕挓娲荤潃鈮燼gent 娲荤潃锛屼絾銆屾秷璐瑰姩浣滃彂鐢熴€?agent 娲荤潃鐨勬渶纭瘉鎹€?
    闆舵垚鏈挬锛涘け璐ヤ笉闃绘柇涓绘祦绋嬨€備粎闄愪簲涓?KDO 瑙掕壊锛堟嫾闊筹級锛屽叾浣?instance 涓嶅叆娉ㄥ唽琛ㄣ€?""
    if not role:
        return
    _CN_TO_PINYIN = {"娆ч槼閿?: "ouyangfeng", "鐜嬭瀚?: "wangyuyan", "榛勮嵂甯?: "huangyaoshi",
                     "鑰侀〗绔?: "laowantong", "椋庢竻鎵?: "fengqingyang"}
    role = _CN_TO_PINYIN.get(role, role)
    try:
        import role_registry
        if role not in role_registry.ROLE_PACE_MIN:
            return
        role_registry.heartbeat(role, tool=os.environ.get("KDO_TOOL", "cli"),
                                session_scope=os.getcwd())
    except Exception:
        pass


def action_myqueue(role: str) -> int:
    """#472 浠诲姟璺敱锛氳鑹茶瑙掔殑闃熷垪瑙嗗浘锛堝彧璇伙紝涓嶅姩鐘舵€佹満锛夈€?

    鍙锛坬ueued+鏃犱緷璧栨垨渚濊禆宸叉弧瓒?闈炲喕缁擄級/ 绛変緷璧栵紙depends_on 鏈弧瓒筹級/
    鍐荤粨锛堥槦鍒楄鏍囨敞鍕块/鍐荤粨鐣欐。鈥斺€斿惈琚彇浠ｆ寕璐︼級/ 杩涜涓紙claimed-<role>锛?
    寰呯粓瀹★紙pending_review锛夈€?
    """
    # #552锛氭椂閽熻弓鎷嶁€斺€攎yqueue 鏄鑹叉椂閽熸瘡鎷嶅繀璺戠殑鍞竴鍛戒护锛岄『鎵嬪啓娉ㄥ唽琛ㄥ績璺?
    # #562锛氳弓鎷嶉€昏緫涓婃彁涓?_consumption_heartbeat锛宑laim/complete/release/review 鍏辩敤
    _consumption_heartbeat(role)
    rows = parse_queue()
    mine = [r for r in rows if r["assignee"] == role]
    todo, wait, frozen, doing, reviewing = [], [], [], [], []
    for r in mine:
        status = r["status"]
        if status.startswith("claimed-"):
            doing.append(r)
        elif status == "pending_review":
            reviewing.append(r)
        elif status == "queued":
            if re.search(r"鍕块|鍐荤粨鐣欐。|鍐荤粨鍕?, r["raw"]):
                frozen.append(r)
            else:
                blockers = [d for d in _task_depends_on(r["task_id"]) if _is_active_task(d, rows)]
                if blockers:
                    r["blockers"] = blockers
                    wait.append(r)
                else:
                    todo.append(r)

    def fmt(items):
        if not items:
            return "  (鏃?"
        lines = []
        for r in items:
            line = f"  #{r['seq']} {r['task_id']} 鈥?{r['name'][:45]}"
            if r.get("blockers"):
                line += f"锛堢瓑 #{','.join(r['blockers'])} 缁堝锛?
            lines.append(line)
        return "\n".join(lines)

    print(f"# role={role} 路 浠诲姟璺敱锛?472 鍙瑙嗗浘锛屼笉鍔ㄧ姸鎬佹満锛?)
    print(f"鉁?鍙 {len(todo)}:"); print(fmt(todo))
    print(f"鈴?绛変緷璧?{len(wait)}:"); print(fmt(wait))
    print(f"馃 鍐荤粨 {len(frozen)}:"); print(fmt(frozen))
    print(f"馃毀 杩涜涓?{len(doing)}:"); print(fmt(doing))
    print(f"鈴?寰呯粓瀹?{len(reviewing)}:"); print(fmt(reviewing))
    _print_recent_reviews(role)
    return 0


# #535 myqueue銆屾渶杩戠粓瀹°€嶆爮锛歊EVIEW-PENDING 娈靛垝鎺夎閲岀殑缁堝钀界偣锛?8h 鍐咃紝鏈鑹诧級
_REVIEW_DONE_RE = re.compile(
    r"^- ~~#(\d+) (\S+?)锝?\S+?)锝滄彁瀹?.*?~~ 鈫?(宸茬粓瀹?(?:PASS\s*[A-]*|FAIL)|缁堝閫€鍥?"
    r".*?锛?\d{4}-\d{2}-\d{2})")


def _print_recent_reviews(role: str, hours: int = 48) -> None:
    """杩?48h 鎴戝悕涓嬬粓瀹¤惤鐐光€斺€斿彧璇昏鍥鹃『鎵嬫煡锛屼笉鎶娿€屾病鏈夊彉鍖栥€嶈璇讳负銆屼粛鍦ㄥ銆嶃€?""
    from datetime import datetime as _dt, timedelta as _td
    try:
        text = QUEUE_PATH.read_text(encoding="utf-8")
    except OSError:
        text = ""
    block = ""
    if REVIEW_BEGIN in text and REVIEW_END in text:
        block = text.split(REVIEW_BEGIN)[1].split(REVIEW_END)[0]
    cutoff = _dt.now() - _td(hours=hours)
    rows = []
    for line in block.splitlines():
        m = _REVIEW_DONE_RE.match(line.strip())
        if not m or m.group(3) != role:
            continue
        seq, tid, _a, verdict, dstr = m.groups()
        try:
            d = _dt.strptime(dstr, "%Y-%m-%d")
        except ValueError:
            continue
        if d >= cutoff:
            tag = "馃敶閫€鍥炶繑宸? if "閫€鍥? in verdict or "FAIL" in verdict else f"鉁厈verdict.replace('宸茬粓瀹?', '')}"
            rows.append(f"  #{seq} {tid} 鈥?{tag}锛坽dstr}锛?)
    print(f"鈿栵笍 鏈€杩戠粓瀹★紙{hours}h锛?{len(rows)}:")
    print("\n".join(rows) if rows else "  (鏃?")


def main() -> int:
    if yaml is None:
        print("ERROR: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr)
        return 1

    args = sys.argv[1:]
    if not args:
        print(__doc__, file=sys.stderr)
        return 1

    action = args[0]

    if action == "myqueue":
        if len(args) < 2:
            print("鐢ㄦ硶: queue_transition.py myqueue <role>锛堟嫾闊宠鑹插悕锛?, file=sys.stderr)
            return 1
        return action_myqueue(args[1])

    if action == "register":
        # #546锛氬疄渚嬩笂宀楃櫥璁帮紙娆ч槼閿嬬瓑绾鏌ヨ鑹蹭笉 claim锛屼粠杩欓噷鐧昏锛?
        if len(args) < 2:
            print("鐢ㄦ硶: queue_transition.py register <instance>", file=sys.stderr)
            return 1
        ok, msg = action_register(args[1])
        print(msg)
        return 0 if ok else 1

    if action == "status":
        rows = parse_queue()
        pending = [r for r in rows if r["status"] == "pending_review"]
        claimed = [r for r in rows if r["status"].startswith("claimed-")]
        queued = [r for r in rows if r["status"] == "queued"]
        print(f"闃熷垪鎬讳换鍔℃暟: {len(rows)}")
        print(f"queued: {len(queued)}")
        print(f"claimed: {len(claimed)}")
        print(f"pending_review: {len(pending)}")
        for r in pending:
            print(f"  #{r['seq']} {r['task_id']} 鈥?{r['name']}")
        return 0

    if len(args) < 2:
        print(__doc__, file=sys.stderr)
        return 1

    task_id = args[1]

    instance = None
    evidence = None
    verdict = None
    reviewer = None
    grade = None
    review_file = None
    note = None
    reason = None
    force = False
    override = False
    no_commit = False

    i = 2
    while i < len(args):
        if args[i] == "--instance" and i + 1 < len(args):
            instance = args[i + 1]
            i += 2
        elif args[i] == "--force":
            force = True
            i += 1
        elif args[i] == "--override":
            override = True  # #538锛歳eviewed鈫抭ueued 鏀瑰垽閫氶亾锛堥渶 --verdict fail --reason锛?
            i += 1
        elif args[i] == "--no-commit":
            no_commit = True
            i += 1
        elif args[i] == "--evidence" and i + 1 < len(args):
            evidence = args[i + 1]
            i += 2
        elif args[i] == "--reason" and i + 1 < len(args):
            reason = args[i + 1]  # #444锛?-force 渚嬪澹版槑锛堢暀鐥曞彴璐︼級
            i += 2
        elif args[i] == "--verdict" and i + 1 < len(args):
            verdict = args[i + 1]
            i += 2
        elif args[i] == "--reviewer" and i + 1 < len(args):
            reviewer = args[i + 1]
            i += 2
        elif args[i] == "--grade" and i + 1 < len(args):
            grade = args[i + 1]
            if grade not in ("A", "A-", "B+", "B", "B-", "C"):
                print("--grade 闇€瑕?A|A-|B+|B|B-|C", file=sys.stderr)
                return 1
            i += 2
        elif args[i] == "--review-file" and i + 1 < len(args):
            review_file = args[i + 1]
            i += 2
        elif args[i] == "--note" and i + 1 < len(args):
            note = args[i + 1]
            i += 2
        else:
            print(f"鏈煡鍙傛暟: {args[i]}", file=sys.stderr)
            return 1

    if action == "claim":
        if not instance:
            print("claim 闇€瑕?--instance <instance>", file=sys.stderr)
            return 1
        ok, msg = action_claim(task_id, instance, force=force)
    elif action == "complete":
        if not instance:
            print("complete 闇€瑕?--instance <instance>", file=sys.stderr)
            return 1
        ok, msg = action_complete(task_id, instance, evidence, force=force, reason=reason)
