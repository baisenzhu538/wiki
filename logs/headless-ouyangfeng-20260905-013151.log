# Valid transitions. Format: (current_status, action) -> new_status
# instance/reviewer checks are performed separately.
TRANSITIONS: dict[tuple[str, str], str] = {
    ("queued", "claim"): "claimed-{instance}",
    ("claimed-{instance}", "complete"): "pending_review",
    ("claimed-{instance}", "release"): "claimed-{instance}",
    ("pending_review", "review_pass"): "reviewed",
    ("pending_review", "review_fail"): "queued",
    # #429 F-029锛氱瓑寰呭閮ㄨ緭鍏ユ€佲€斺€斾笉鍗?pending_review 闃诲浣嶏紙find_blockers 鍙敹 pending_review/claimed锛?
    ("pending_review", "mark_waiting"): "waiting-external",
    ("waiting-external", "resume"): "pending_review",
    # #461锛歲ueued 鍗曞彇娑?琚彇浠ｏ紙缁堟€侊紝闈炲垹闄も€斺€攃harter 搂3.15 涓婃澘鍐荤粨鐨勫嚭鍙ｏ級
    ("queued", "cancel"): "cancelled",
}


def parse_frontmatter(path: Path) -> tuple[dict[str, Any], str]:
    """Return (frontmatter_dict, body)."""
    text = path.read_text(encoding="utf-8", errors="ignore")
    if not text.startswith("---"):
        return {}, text
    # Match leading frontmatter block: ---\n<yaml>\n---\n<body>
    match = re.match(r"^---\r?\n(.*?)\r?\n---\r?\n(.*)$", text, re.DOTALL)
    if not match:
        return {}, text
    fm_text, body = match.group(1), match.group(2)
    if yaml is None:
        raise RuntimeError("PyYAML is required to parse frontmatter")
    data = yaml.safe_load(fm_text) or {}
    return data, body


def write_frontmatter(path: Path, fm: dict[str, Any], body: str) -> None:
    """Write file with YAML frontmatter, preserving body."""
    if yaml is None:
        raise RuntimeError("PyYAML is required to write frontmatter")
    fm_text = yaml.safe_dump(fm, sort_keys=False, allow_unicode=True, default_flow_style=False)
    path.write_text(f"---\n{fm_text}---\n{body}", encoding="utf-8")


def find_task_file(task_id: str) -> Path | None:
    """Locate task file by exact filename match.

    Searches only by filename in known task directories.  If the filename
    does not match the task id (e.g. queue has one id but the file was
    renamed), the caller should fall back to
    ``find_task_file_by_frontmatter_id()`` which scans frontmatter.
    """
    candidates = [
        TASK_DIR / f"{task_id}.md",
        BATCH_DIR / f"{task_id}.md",
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def find_task_file_by_frontmatter_id(task_id: str) -> Path | None:
    """Locate task file whose frontmatter ``id`` field equals *task_id*.

    Scans all ``.md`` files in the task directories.  Used as a fallback
    when the filename does not match the queue id.
    """
    for d in (TASK_DIR, BATCH_DIR):
        if not d.exists():
            continue
        for path in d.glob("*.md"):
            fm, _ = parse_frontmatter(path)
            if fm.get("id") == task_id or str(fm.get("task_id", "")) == task_id:
                return path
    return None


def _find_task_file_dual(task_id: str) -> Path | None:
    """Find task file: filename first, then frontmatter id fallback."""
    return find_task_file(task_id) or find_task_file_by_frontmatter_id(task_id)


def update_queue_status(task_id: str, new_status: str) -> None:
    """Atomically update the status cell in production-queue.md."""
    text = QUEUE_PATH.read_text(encoding="utf-8")
    lines = text.splitlines()
    updated = []
    tid = task_id.strip("`").strip("*")
    found = False
    for line in lines:
        if line.startswith("|") and not set(line.strip()) <= {"|", "-", ":", " "}:
            cells = [c for c in line.strip("|").split("|")]
            if len(cells) >= 4 and cells[1].strip().strip("*").strip("`").strip() == tid:
                # Replace only the 4th cell (status), preserving surrounding formatting
                cells[3] = f" {new_status} "
                updated.append("|" + "|".join(cells) + "|")
                found = True
                continue
        updated.append(line)
    if not found:
        raise ValueError(f"浠诲姟 {task_id} 鏈湪鐢熶骇闃熷垪涓壘鍒?)
    QUEUE_PATH.write_text("\n".join(updated) + "\n", encoding="utf-8")


def update_task_frontmatter(task_file: Path, **updates: Any) -> None:
    """Update task file frontmatter keys 鈥斺€?鍙姩鎸囧畾瀛楁锛屽叾浣欒鍘熸牱淇濈暀銆?

    #616 浠诲姟2锛坈laim 鎶瑰瓧娈?bug 鏍规不锛夛細鏃у疄鐜?parse鈫抷aml.safe_dump round-trip锛?
    YAML 璇硶涓婅В鏋愪负 null 鐨勫瓧娈典細琚姽鎴愮湡 null鈥斺€斿疄璇?#614 `decision_source: #613 ...`
    锛堝€间互 # 寮€澶磋褰撴敞閲婏級銆?613 `title: #586鎵?..` 鍚屽瀷锛宑laim 钀界洏鍗充涪鍊笺€?
    鏀逛负琛岀骇鏀瑰啓锛歶pdates 鍛戒腑鐨勯敭鏁磋鏇挎崲锛堝師澶氳鍊?缁鍧椾竴骞舵崲涓嬶級锛屾湭鍛戒腑閿?
    閫愬瓧鑺備繚鐣欙紙鍚敞閲?鎶樺彔鍊?闈炶鑼?YAML 鍐欐硶锛夛紝鏂伴敭杩藉姞鍒?frontmatter 灏鹃儴銆?
    """
    if yaml is None:
        raise RuntimeError("PyYAML is required to write frontmatter")
    upd = {k: v for k, v in updates.items() if v is not None}
    upd["updated_at"] = datetime.now(timezone.utc).isoformat()

    with task_file.open("r", encoding="utf-8", errors="ignore", newline="") as f:
        text = f.read()  # newline="" 鍘熸枃淇濈暀 CRLF锛屼笉褰?LF 褰掍竴
    m = re.match(r"^(---\r?\n)(.*?)(\r?\n---\r?\n)(.*)$", text, re.DOTALL)
    if not m:
        # 鏃?frontmatter 鍧楋細閫€鍥炲師 yaml 璺緞鏂板缓澶?
        fm, body = parse_frontmatter(task_file)
        fm.update(upd)
        write_frontmatter(task_file, fm, body)
        return

    head, fm_text, close, body = m.groups()
    nl = "\r\n" if "\r\n" in fm_text else "\n"
    key_re = re.compile(r"^([A-Za-z_][\w-]*)\s*:")
    lines = fm_text.split("\n")
    out: list[str] = []
    remaining = dict(upd)
    i = 0
    while i < len(lines):
        line = lines[i]
        km = key_re.match(line)
        if km and km.group(1) in remaining:
            key_name = km.group(1)
            new_value = remaining.pop(key_name)
            i += 1
            # 鍚冩帀鍘熷€肩殑缁鍧楋紙缂╄繘缁 / 闆剁缉杩?`- ` 鍒楄〃椤癸級锛岄殢鏃у€间竴骞舵浛鎹?
            while i < len(lines) and lines[i].strip() and (
                lines[i].startswith((" ", "\t")) or lines[i].lstrip().startswith("- ")
            ):
                i += 1
            dumped = yaml.safe_dump(
                {key_name: new_value}, allow_unicode=True,
                default_flow_style=False, sort_keys=False,
            ).rstrip("\r\n")
            out.extend(dumped.split("\n"))
        else:
            out.append(line)
            i += 1
    for key, value in remaining.items():
        dumped = yaml.safe_dump(
            {key: value}, allow_unicode=True,
            default_flow_style=False, sort_keys=False,
        ).rstrip("\r\n")
        out.extend(dumped.split("\n"))
    new_text = head + nl.join(out) + close + body
    with task_file.open("w", encoding="utf-8", newline="") as f:
        f.write(new_text)


def current_utc_date() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def backup(path: Path) -> str:
    """Return current file content for rollback."""
    return path.read_text(encoding="utf-8")


def restore(path: Path, content: str) -> None:
    """Restore file content on failure."""
    path.write_text(content, encoding="utf-8")


def apply_updates(task_id: str, new_queue_status: str, task_file: Path, **task_updates: Any) -> None:
    """Atomically update queue and task file; rollback both on failure."""
    queue_backup = backup(QUEUE_PATH)
    task_backup = backup(task_file)
    try:
        update_queue_status(task_id, new_queue_status)
        update_task_frontmatter(task_file, **task_updates)
    except Exception as e:
        restore(QUEUE_PATH, queue_backup)
        restore(task_file, task_backup)
        raise RuntimeError(f"鐘舵€佹洿鏂板け璐ワ紝宸茶嚜鍔ㄥ洖婊氾細{e}") from e


def ensure_task_workspace(task_id: str, task_file: Path) -> str | None:
    """#402锛歝laim 闀跨▼浠诲姟锛坒rontmatter `long_running: true`锛夋椂妫€鏌?workspace銆?

    涓嶅瓨鍦ㄥ垯鍒涘缓鏈€灏忎笁浠跺 `60_feedback/tasks/<task_id>-workspace/`锛?
    `in-progress/`锛堜腑闂翠骇鐗╋級銆乣excluded/`锛堝凡鎺掗櫎鏂瑰悜锛夈€乣next-pointer.md`锛堜笂娆″仠鍦ㄥ摢锛夈€?
    闈為暱绋嬩换鍔¤繑鍥?None銆傛枃浠堕殢 #390 鑷姩 commit 瑙︾闆嗗叆妗ｃ€?
    """
    import time
    fm, _ = parse_frontmatter(task_file)
    if not (fm and fm.get("long_running")):
        return None
    ws = task_file.parent / f"{task_file.stem}-workspace"
    rel = ws.relative_to(_WIKI_ROOT).as_posix() if ws.is_relative_to(_WIKI_ROOT) else str(ws)
    if ws.exists():
        return f"workspace 宸插瓨鍦? {rel}"
    (ws / "in-progress").mkdir(parents=True)
    (ws / "excluded").mkdir()
    (ws / "next-pointer.md").write_text(
        f"# {task_id} workspace\n\n"
        f"- 鍒涘缓: {time.strftime('%Y-%m-%d %H:%M')}锛坈laim 鑱斿姩鑷姩鐢熸垚锛塡n"
        f"- 涓婃鍋滃湪鍝? 浠诲姟鍒氳棰嗗彇\n"
        f"- 涓嬩竴姝? 璇讳换鍔″崟 `{task_file.name}` 鎵ц鑼冨洿\n",
        encoding="utf-8",
    )
    return f"闀跨▼浠诲姟 workspace 宸插垱寤? {rel}"


# 澶勭疆绫讳换鍔?claim 闂ㄧ锛?375锛夛細浠诲姟鍗曞惈澶勭疆鍏抽敭璇嶆椂寮哄埗鍐呭浠峰€煎垽鏂妭銆?
# 鑳屾櫙锛?8-19 鑻辨枃澹崇洰褰曚簨浠垛€斺€?鍒犻櫎"閫夐」杩涘叆鎵ц閾惧樊鐐规瘉鏍稿績璧勪骇锛圥ARA 搴擄級銆?
# PROTOCOL 搂7 绱犳潗鍒犻櫎绂佷护鏄枃妗堬紝杩欓噷钀藉湴涓?claim 闂ㄧ銆?
DISPOSAL_KEYWORDS = ("鍒犻櫎", "娓呯悊", "褰掓。", "搴熷純", "澶勭疆", "绉婚櫎", "鍒犻櫎绫?)


def _extract_action_scope(body: str) -> str:
    """#457 鏂规 1锛堣緟锛夛細鍙彁鍙栥€?# 鍔ㄤ綔銆嶈妭 + 銆?# 浠诲姟鐩爣銆嶈妭锛堜笉鍚叏 body锛夆€斺€旀鏂囧彊杩颁笉瑙﹀彂鍏抽敭璇嶃€?""
    scope = []
    for sec in ("## 鍔ㄤ綔", "## 浠诲姟鐩爣"):
        idx = body.find(sec)
        if idx == -1:
            continue
        nxt = body.find("\n## ", idx + 1)
        scope.append(body[idx:nxt] if nxt > 0 else body[idx:])
    return "\n".join(scope)


def _check_disposal_gate(task_file: Path, fm: dict[str, Any], task_id: str) -> tuple[bool, str]:
    """澶勭疆绫讳换鍔?claim 妫€鏌ワ紙#457 缁撴瀯鍖栭噸鏋勶細鏄惧紡鏍囪浼樺厛 + 鍏抽敭璇嶉檺瀹氳寖鍥撮檷绾т负鎻愮ず锛夈€?

    - 鏄惧紡鏍囪 `disposal: true`锛堢紪鎺掍晶鍐欎换鍔″崟鏃舵爣娉級鈫?纭棬绂侊細蹇呴』甯︺€屽唴瀹逛环鍊煎垽鏂€嶈妭
    - 鍏抽敭璇嶏紙鍙壂鍔ㄤ綔鑺?浠诲姟鐩爣鑺傦級鈫?闄嶇骇涓烘彁绀猴紙涓嶇‖鎷︼級锛屽紩瀵艰ˉ鏍囪
    - 鎰忓浘涓嶅彉锛歅ROTOCOL 搂7 绱犳潗鍒犻櫎绂佷护锛堥€愪欢鑰佹湵浜叉壒锛夛紱#189/#454 璇垽鏍规不锛堟湳璇瘝涓嶈鍗★級
    """
    body = task_file.read_text(encoding="utf-8", errors="replace")
    title = str(fm.get("title") or task_file.stem)

    # 璞佸厤澹版槑锛歠rontmatter claim_gate_exempt 鍐欐槑鐞嗙敱
    if fm.get("claim_gate_exempt"):
        return True, f"锛坈laim_gate_exempt 璞佸厤锛歿fm['claim_gate_exempt']}锛?

    has_value_judgement = "鍐呭浠峰€煎垽鏂? in body

    # 1. 鏄惧紡鏍囪 鈫?纭棬绂侊紙鏂规 2锛屼富锛?
    if fm.get("disposal") is True:
        if not has_value_judgement:
            # #460 FAIL 閫€鍥炶ˉ鎻掓々锛氬缃‖闂ㄧ锛堟渶楂橀闄╅槻绾匡級鎷︽埅蹇呴』钀界洏鈥斺€斿惁鍒欐嫤鎴潤榛樼帇璇鏃犳劅
            _log_gate_blocked(task_id, "澶勭疆-纭棬绂?, "disposal:true 缂恒€屽唴瀹逛环鍊煎垽鏂€嶈妭锛圥ROTOCOL 搂7锛?, task_id)
            return False, (
                f"澶勭疆绫讳换鍔?{task_id}锛坒rontmatter disposal: true锛夌己銆屽唴瀹逛环鍊煎垽鏂€嶈妭鈥斺€旂姝㈤鍙栥€俓n"
                f"鑳屾櫙锛歅ROTOCOL 搂7 绱犳潗鍒犻櫎绂佷护锛?8-19 鑻辨枃澹充簨浠讹級銆俓n"
                f"璇峰湪浠诲姟鍗曡ˉ鍏呰妭锛氳浠诲姟娑夊強绱犳潗鐨勫唴瀹逛环鍊煎垽鏂紙璇昏繃鍐呭鍐嶅畾鍘诲悜锛夛紝"
                f"骞跺０鏄庡垹闄ら』閫愪欢鑰佹湵浜叉壒銆?
            )
        return True, (
            f"鉁?{task_id} 宸查鍙栵紙澶勭疆绫?disposal: true锛屽凡鍚唴瀹逛环鍊煎垽鏂妭锛夈€俓n"
            f"鎵ц鍓嶇‘璁ゆ竻鍗曪細\n"
            f"  鈶?绱犳潗澶勭疆榛樿鍙湁娑堝寲/褰掓。鍘熶綅淇濈暀锛屽垹闄ら』閫愪欢鑰佹湵浜叉壒锛圥ROTOCOL 搂7锛塡n"
            f"  鈶?鎵归噺涓夐棶锛歞ry-run 棰勮 / 鍙樻洿鑼冨洿澹版槑 / 闈炵┖鍊间笉瑕嗙洊\n"
            f"  鈶?澶勭疆鍓嶉€氳鍐呭锛圔5 鐗岋細鍏堣瀹屾暣鍐呭鍐嶄笅缁撹锛?
        )

    # 2. 鍏抽敭璇嶏紙闄愬畾鑼冨洿锛夆啋 闄嶇骇涓烘彁绀猴紝涓嶇‖鎷︼紙鏂规 1锛岃緟鈥斺€?189/#454 璇垽鏍规不锛?
    scope = title + "\n" + _extract_action_scope(body)
    hits = [k for k in DISPOSAL_KEYWORDS if k in scope]
    if hits:
        return True, (
            f"鈿狅笍 {task_id} 鐤戜技澶勭疆鏈爣璁帮細鍔ㄤ綔/鐩爣鑺傚懡涓?{hits}鈥斺€斿鍚礌鏉愬缃姩浣滐紝"
            f"璇疯ˉ frontmatter `disposal: true` + 銆屽唴瀹逛环鍊煎垽鏂€嶈妭锛?457锛汸ROTOCOL 搂7 鍒犻櫎椤昏€佹湵浜叉壒锛?
        )
    return True, ""


# #444 instance鈫掕鑹插悕鏄犲皠锛歠rontmatter assignee 鍙啓瑙掕壊鍚嶏紝instance 鍙﹀瓨銆?
