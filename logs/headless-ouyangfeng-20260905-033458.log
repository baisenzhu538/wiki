                msg=d.get(\"message\",{})
                if msg.get(\"role\")"'!="user": continue
                for part in msg.get("content",[]):
                    txt=part.get("text","") if isinstance(part,dict) else ""
                    if txt: yield txt
            elif t=="context.append_loop_event":
                ev=d.get("event",{})
                if ev.get("type")=="content.part" and ev.get("part",{}).get("type")=="text":
                    txt=ev["part"].get("text","")
                    if txt: yield txt

root=os.path.expanduser(r"~/.kimi-code/sessions")
wires=glob.glob(os.path.join(root,"*","session_*","agents","*","wire.jsonl"))
