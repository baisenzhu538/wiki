# -*- coding: utf-8 -*-
import json, re, glob, os, sys
sys.stdout.reconfigure(encoding=\"utf-8\")

def norm(s):
    return re.sub(r\"\\s+\", \"\", s or \"\")

WIKI = r\"C:\\Users\\Administrator\\Desktop\\wiki\"

# ---- extract anchors from candidate cards ----
import pathlib
cards = {}
for fp in glob.glob(os.path.join(WIKI, \"00_inbox\", \"pending-cards\", \"distill-*.md\")):
    t = pathlib.Path(fp).read_text(encoding=\"utf-8\")
    m = re.search(r'source_refs:\\s*\\n- \"(.*?)\"', t)
    src = m.group(1) if m else None
    am = re.search(r'\\*\\*原文锚\\*\\*（红线：逐字摘自源会话）：\\s*\\n>\\s*(.*?)\\n', t)
    anchor = am.group(1).strip() if am else None
    name = os.path.basename(fp)
    cards[name] = (src, anchor)

# ---- extract anchors from zhu file ----
zhu_t = pathlib.Path(os.path.join(WIKI, \"30_wiki\", \"personal-os\", \"zhu-conversation-insights.md\")).read_text(encoding=\"utf-8\")
zhu_rows = []
for m in re.finditer(r'\\|\\s*(\\d+)\\s*\\|\\s*\\*\\*(.*?)\\*\\*：(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*"'`(.*?)`'"\\s*\\|', zhu_t):
    zhu_rows.append({\"n\": m.group(1), \"title\": m.group(2), \"insight\": m.group(3), \"anchor\": m.group(4), \"src\": m.group(5)})

print(\"candidate cards:\", len(cards))
print(\"zhu rows parsed:\", len(zhu_rows))

# ---- verify candidate cards against their declared source ----
def extract_texts(fp):
    try:
        with open(fp, encoding=\"utf-8\", errors=\"replace\") as f:
            for line in f:
                line = line.strip()
                if not line: continue
                try: d = json.loads(line)
                except: continue
                t = d.get(\"type\")
                if t == \"context.append_message\":
                    msg = d.get(\"message\", {})
                    if msg.get(\"role\") "'!= "user": continue
                    origin = msg.get("origin") or {}
                    if origin.get("kind") in ("injection","cron"): continue
                    for part in msg.get("content", []):
                        txt = part.get("text","") if isinstance(part,dict) else ""
                        if txt: yield txt
                elif t == "context.append_loop_event":
                    ev = d.get("event", {})
                    if ev.get("type")=="content.part" and ev.get("part",{}).get("type")=="text":
                        txt = ev["part"].get("text","")
                        if txt: yield txt
    except OSError:
        return

card_fail = []
for name, (src, anchor) in cards.items():
    if not src or not anchor:
        card_fail.append((name, "missing src/anchor"))
        continue
    if not os.path.exists(src):
        card_fail.append((name, "src not exist: "+src))
        continue
    ntext = norm("".join(extract_texts(src)))
    if norm(anchor) not in ntext:
        card_fail.append((name, "anchor NOT in source"))

print("card anchor failures:", len(card_fail))
for x in card_fail[:20]:
    print("  ", x)

# ---- verify zhu rows by searching all wires ----
root = os.path.expanduser(r"~/.kimi-code/sessions")
wires = glob.glob(os.path.join(root, "*", "session_*", "agents", "*", "wire.jsonl"))
# preload normalized texts
wtexts = {}
for w in wires:
    wtexts[w] = norm("".join(extract_texts(w)))

zhu_fail = []
for r in zhu_rows:
    a = r["anchor"].replace("'"\\\\|\",\"|\").strip()
    hits = [w for w, t in wtexts.items() if norm(a) in t]
    if not hits:
        zhu_fail.append((r[\"n\"], r[\"title\"], \"no hit\", a[:40]))

print(\"zhu anchor failures:\", len(zhu_fail))
for x in zhu_fail:
    print(\"  \", x)
