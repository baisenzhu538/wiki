    p=p.replace(\"C:\\\\Users\\\\Administrator\\\\.kimi-code\\\\sessions\\\\\",\"\")
    m=re.search(r'(session_[0-9a-f-]+)\\\\agents\\\\(["'^'"\\\\]+)', p)
