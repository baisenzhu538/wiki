  Sentinel design:

  ```python
  def _scan_graph_index_health(state: dict, max_age_h: float = 48) -> list[str]:
      """#622 第十一信号：graph_index 健康——空目录 / 0 records / 陈旧超 48h 告警。

      背景：08-31 整树事故清空 .kdo/graph_index（0 字节，mtime 02:11 落事故窗口），
      hybrid RRF 语义腿空转 2 天无人发现——「修完没加哨兵=同类事故必再发」（#357/#358 模式）。
      只告警不动作（红线）。幂等=沿触发：同一异常原因只报一次，恢复后重新武装，
      异常原因切换（如 空→陈旧）重报。graphml 读不出 → 不报（不误报红线，同 _beat_age_minutes）。
      """
      gdir = ROOT / ".kdo" / "graph_index"
      graphml = gdir / "graph_chunk_entity_relation.graphml"
      issue = None
      try:
          if not gdir.is_dir() or not any(gdir.iterdir()):
              issue = "目录空/不存在"
          elif not graphml.is_file():
              issue = "graphml 缺失（半建状态）"
          else:
              # 0 records：graphml 节点数（字节扫描 <node ，不解析 XML——6MB 级文件秒级）
              nodes = graphml.read_bytes().count(b"<node ")
              if nodes == 0:
                  issue = "graphml 0 records"
              else:
                  age_h = (time.time() - graphml.stat().st_mtime) / 3600
                  if age_h > max_age_h:
                      issue = f"陈旧 {age_h:.0f}h（阈值 {max_age_h:.0f}h）"
      except Exception:
          return []
      prev = state.get("graph_index_issue")
      state["graph_index_issue"] = issue
      if issue and issue != prev:
          return [f"graph-index｜{issue}"]
      return []
  ```

